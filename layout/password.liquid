<!doctype html>
<html lang="{{ request.locale.iso_code }}">
    <head>
        <meta charset="UTF-8">
        <meta
            name="viewport"
            content="width=device-width, initial-scale=1.0"
        >

        {%- if settings.favicon != blank -%}
            <link
                rel="icon"
                type="image/png"
                href="{{ settings.favicon | image_url: width: 32, height: 32 }}"
            >
        {%- endif -%}

        <title>
            {{ page_title | default: shop.name }}
        </title>

        {%- assign meta_description = page_description | default: shop.description | default: shop.name -%}
        <meta
            name="description"
            content="{{ meta_description | escape }}"
        >

        {{ content_for_header }}

        {%- render 'theme.meta-tags' -%}

        {%- render 'theme.assets' -%}

        {%- render 'theme.fonts' -%}

        {%- render 'color-schemes' -%}
    </head>
    <body class="bg-background text-sm">
        {%- # Skip link for better keyboard navigation -%}
        <a
            class="pointer-events-none fixed z-50 m-8 translate-y-4 bg-background p-4 opacity-0 shadow-xl transition-all duration-300 focus:pointer-events-auto focus:translate-y-0 focus:opacity-100"
            href="#MainContent"
        >
            {{ 'general.accessibility.skip_to_content' | t }}
        </a>

        <main
            id="MainContent"
            class="focus-none outline-none"
            role="main"
            tabindex="-1"
        >
            {{ content_for_layout }}
        </main>

        {%- render 'theme.scripts' -%}
    </body>
</html>
