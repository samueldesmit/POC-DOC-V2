{%- liquid
    assign sort_by = collection.sort_by | default: collection.default_sort_by
-%}

<sort-form class="group/sort-form">
    <form>
        <select
            name="sort_by"
            aria-label="{{ 'collection.filters.sort_by_label' | t }}"
            class="px-3 py-2 transition-colors duration-300 ease-out group-data-loading/sort-form:pointer-events-none"
        >
            {%- for option in collection.sort_options -%}
                <option
                    value="{{ option.value | escape }}"
                    {% if option.value == sort_by %}
                        selected="selected"
                    {% endif %}
                >
                    {{ option.name | escape }}
                </option>
            {%- endfor -%}
        </select>
    </form>
</sort-form>

