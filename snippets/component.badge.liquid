{%- liquid
    assign badge_handle = badge | handleize
    assign badge_object = shop.metaobjects.product_badge[badge_handle]
    assign background_color = badge_object.background_color | default: '#000'
    assign text_color = badge_object.text_color | default: '#fff'
-%}
<span
    class="flex items-center justify-center bg-[var(--bg-color)] px-3 py-1 text-[var(--text-color)]"
    style="
        --bg-color: {{ background_color }};
        --text-color: {{ text_color }};
    "
>
    {{ badge_object.title }}
</span>
