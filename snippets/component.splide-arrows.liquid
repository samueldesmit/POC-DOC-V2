{%- liquid
    assign container_class = container_class | default: 'max-w-screen-5xl splide__arrows--ltr absolute inset-0 flex items-center justify-between pointer-events-none z-10'
    assign show_pagination = show_pagination | default: false, allow_false: true
    assign pagination_total = pagination_total | default: 0
    assign pagination_class = pagination_class | default: 'text-sm'

    assign variant = variant | default: 'ghost'
    assign arrow_class = 'transition-opacity duration-500 p-2 disabled:opacity-0 disabled:pointer-events-none splide__arrow pointer-events-auto border-0'
    assign prev_button_class = prev_button_class | default: arrow_class | append: ' rotate-180 splide__arrow--prev'
    assign next_button_class = next_button_class | default: arrow_class | append: ' splide__arrow--next'
    assign icon_class = icon_class | default: 'w-3 h-3 lg:w-8 lg:h-8'
    assign prev_icon = prev_icon | default: 'full_long_arrow'
    assign next_icon = next_icon | default: 'full_long_arrow'
    if prev_aria_label == blank
        assign prev_aria_label = 'accessibility.previous_slide' | t
    endif
    if next_aria_label == blank
        assign next_aria_label = 'accessibility.next_slide' | t
    endif
-%}

<div class="splide__arrows {{ container_class }}">
    {%- render 'component.button',
        title: prev_aria_label,
        class: prev_button_class,
        aria_label: prev_aria_label,
        variant: variant,
        icon: prev_icon,
        icon_class: icon_class
    %}
    {%- if show_pagination and pagination_total > 0 -%}
        <span
            class="splide-pagination-text {{ pagination_class }}"
            data-total="{{ pagination_total }}"
        >
            <span class="splide-current-page">1</span> / {{ pagination_total }}
        </span>
    {%- endif -%}
    {%- render 'component.button',
        title: next_aria_label,
        class: next_button_class,
        aria_label: next_aria_label,
        variant: variant,
        icon: next_icon,
        icon_class: icon_class
    -%}
</div>
