{% for link in menu %}
    <li class="">
        {% if link.links != blank %}
            <a
                href="{{ link.url }}"
                class="flex items-center justify-between text-base"
            >
                {{- link.title -}}
                {%- render 'component.icon',
                    type: 'chevron',
                    class: 'size-4'
                -%}
            </a>
            <div
                class="absolute left-0 py-7 px-5 h-full w-full top-0 overflow-hidden translate-x-full data-open:translate-x-0 flex flex-col transition data-leave:duration-300 duration-300 ease-out z-10"
                style="background-color: {{ header_background_color }}; color: {{ header_text_color }};"
            >
                <button
                    type="button"
                    class="pt-4 pb-7 flex items-center gap-4 cursor-pointer"
                >
                    {%- render 'component.icon',
                        type: 'chevron',
                        class: 'size-4 rotate-180'
                    -%}
                    {{- link.title -}}
                </button>
                <ul class="flex flex-col gap-y-7">
                    {% for sublink in link.links %}
                        <li>
                            {% if sublink.links != blank %}
                                <a
                                    href="{{ sublink.url }}"
                                    class="flex items-center justify-between text-base"
                                >
                                    {{- sublink.title -}}
                                    {%- render 'component.icon',
                                        type: 'chevron',
                                        class: 'size-4'
                                    -%}
                                </a>
                                <div
                                    class="absolute left-0 py-7 px-5 h-full w-full top-0 overflow-hidden translate-x-full data-open:translate-x-0 flex flex-col transition data-leave:duration-300 duration-300 ease-out z-20"
                                    style="background-color: {{ header_background_color }}; color: {{ header_text_color }};"
                                >
                                    <button
                                        type="button"
                                        class="pt-4 pb-7 flex items-center gap-4 cursor-pointer"
                                    >
                                        {%- render 'component.icon',
                                            type: 'chevron',
                                            class: 'size-4 rotate-180'
                                        -%}
                                        {{- sublink.title -}}
                                    </button>
                                    <ul class="flex flex-col gap-y-7">
                                        {% for grandchild in sublink.links %}
                                            <li>
                                                <a
                                                    href="{{ grandchild.url }}"
                                                    class="block"
                                                >
                                                    {{- grandchild.title -}}
                                                </a>
                                            </li>
                                        {% endfor %}
                                    </ul>
                                </div>
                            {% else %}
                                <a href="{{ sublink.url }}" class="block">
                                    {{- sublink.title -}}
                                </a>
                            {% endif %}
                        </li>
                    {% endfor %}
                </ul>
            </div>
        {% else %}
            <a
                href="{{ link.url }}"
            >
                {{- link.title -}}
            </a>
        {% endif %}
    </li>
{% endfor %}
