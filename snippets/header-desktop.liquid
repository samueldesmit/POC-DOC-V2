<div class="container relative items-center justify-between hidden py-[10px] lg:flex">
    {%- liquid
        assign logo_aria_label = 'accessibility.go_to_homepage' | t
        assign logo_attributes = 'aria-label="' | append: logo_aria_label | append: '"'
    -%}
    <div class="items-center justify-start hidden lg:flex">
        {%- render 'header-megamenu', menu: menu -%}
    </div>

    <a
        {{ logo_attributes }}
        href="{{ routes.root_url }}"
        class="flex items-center h-12 w-20"
    >
        {% if settings.mobile_logo != blank or desktop_logo != blank %}
            <responsive-media class="w-full h-full{% if is_transparent_mode and transparent_desktop_logo != blank %} header-logo--default{% endif %}">
                {{
                    desktop_logo
                    | default: settings.mobile_logo
                    | image_url: width: 400
                    | image_tag:
                        loading: 'lazy',
                        class: 'w-full h-full object-contain'
                }}
            </responsive-media>
            {% if is_transparent_mode and transparent_desktop_logo != blank %}
                <responsive-media class="w-full h-full header-logo--transparent">
                    {{
                        transparent_desktop_logo
                        | image_url: width: 400
                        | image_tag:
                            loading: 'lazy',
                            class: 'w-full h-full object-contain'
                    }}
                </responsive-media>
            {% endif %}
        {% else %}
            {{ shop.name }}
        {% endif %}
    </a>

    <div class="flex items-center justify-end">
        {% render 'header-action-menu' %}
    </div>
</div>
