<cart-item-form class="size-full">
    <form
        action="{{ routes.cart_url }}"
        data-target="cart-item.form"
        class="group-data-loading/cart-form:pointer-events-none h-full"
    >
        <quantity-input class="flex h-full flex-col justify-between text-xs">
            <div class="flex justify-between items-start gap-1">
                <div class="flex flex-col text-xs">
                    {%- if item.product.has_only_default_variant -%}
                        <a
                            class="line-clamp-2"
                            href="{{ item.product.url }}"
                        >
                            {{- item.product.title -}}
                        </a>
                    {%- else -%}
                        <a href="{{ item.variant.url }}">
                            {{- item.product.title -}}
                        </a>
                        <span class="text-secondary">
                            {{- item.variant.title -}}
                        </span>
                    {%- endif -%}
                </div>
                <button
                    data-target="quantity-input.remove"
                    type="button"
                    name="remove"
                    aria-label="{{- 'sections.cart.accessibility.remove_item' | t -}}"
                    class="w-fit text-xs underline cursor-pointer text-secondary"
                >
                    {%- render 'component.icon',
                        type: 'delete_bin',
                        class: 'text-secondary size-4'
                    -%}
                </button>
            </div>
            <div class="flex justify-between items-center">
                <div class="flex">
                    <button
                        data-target="quantity-input.minus"
                        type="button"
                        name="minus"
                        aria-label="{{- 'sections.cart.accessibility.decrease_quantity' | t -}}"
                        {% if item.variant.quantity_rule.min
                            and item.quantity <= item.variant.quantity_rule.min
                        %}
                            disabled
                        {% endif %}
                        class="inline-flex aspect-square items-center justify-center p-2 align-middle disabled:text-primary/10 cursor-pointer"
                    >
                        {%- render 'component.icon', type: 'minus' -%}
                    </button>
                    <input
                        data-target="quantity-input.input"
                        class="hidden"
                        type="number"
                        disabled
                        name="updates[]"
                        value="{{ item.quantity }}"
                        min="{{ item.variant.quantity_rule.min }}"
                        {% if item.variant.inventory_policy == 'deny' %}
                            max="{{ item.variant.inventory_quantity }}"
                        {% elsif item.variant.quantity_rule.max != null %}
                            max="{{ item.variant.quantity_rule.max }}"
                        {% endif %}
                        step="{{ item.variant.quantity_rule.increment }}"
                        id="Quantity-{{ item.index | plus: 1 }}"
                        data-index="{{ item.index | plus: 1 }}"
                    >
                    <span
                        data-target="quantity-input.value"
                        class="text-center inline-flex aspect-square items-center justify-center align-middle"
                    >
                        {{ item.quantity }}
                    </span>
                    <button
                        data-target="quantity-input.plus"
                        type="button"
                        name="plus"
                        aria-label="{{- 'sections.cart.accessibility.increase_quantity' | t -}}"
                        {% if item.variant.quantity_rule.max
                            and item.quantity >= item.variant.quantity_rule.max
                        %}
                            disabled
                        {% elsif item.quantity
                                >= item.variant.inventory_quantity
                            and item.variant.inventory_policy == 'deny'
                        %}
                            disabled
                        {% endif %}
                        class="inline-flex aspect-square items-center justify-center p-2 align-middle disabled:text-primary/10 cursor-pointer"
                    >
                        {%- render 'component.icon',
                            type: 'plus',
                            class: 'text-primary'
                        -%}
                    </button>
                </div>
                {%- render 'cart.item-price', item: item -%}
            </div>
        </quantity-input>
    </form>
</cart-item-form>
