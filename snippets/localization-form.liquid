{% doc %}
    The snippet is used to render the localization form.

    @param {string} icon_type - The type of icon to use
    @param {string} icon_class - The class for the icon
{% enddoc %}

{%- liquid
    assign country_label = 'localization.country_label' | t
    assign language_label = 'localization.language_label' | t
    assign save_label = 'localization.save' | t
    assign country_language_selector_label = 'localization.country_language_selector' | t
    assign localization_modal_attributes = 'aria-label="' | append: country_language_selector_label | append: '"'
    assign language_selector_content = localization.language.name | capitalize
    assign align_vertical = true

    assign container_class = 'bg-primary-background border border-primary '
-%}

{% capture localization_form %}
    <localization-form>
        {% form 'localization', class: 'localization-form' %}
            <div
                data-loading
                class="absolute w-full h-full z-20 bg-background opacity-0 left-0 top-0 pointer-events-none transition duration-500 data-[active]:pointer-events-auto data-[active]:opacity-80"
            ></div>
            <div class="items-center space-y-4 justify-center">
                {%- render 'component.select',
                    title: country_label,
                    key: 'country',
                    label: localization.country.name,
                    options: localization.available_countries,
                    id: 'country_code',
                    align_vertical: align_vertical,
                    container_class: container_class,
                    label_class: 'text-xs font-semibold text-primary',
                    class: 'w-full',
                    no_border: true,
                    show_title: true,
                    icon_class: 'w-3 aspect-square'
                -%}
                {%- render 'component.select',
                    title: language_label,
                    key: 'language',
                    label: language_selector_content,
                    options: localization.available_languages,
                    id: 'language_code',
                    align_vertical: align_vertical,
                    container_class: container_class,
                    label_class: 'text-xs font-semibold text-primary',
                    class: 'w-full',
                    no_border: true,
                    show_title: true,
                    icon_class: 'w-3 aspect-square'
                -%}
            </div>
            {% render 'component.button',
                label: save_label,
                title: save_label,
                class: 'text-center w-full mt-4',
                type: 'submit',
                aria_label: save_label,
                variant: 'primary'
            %}
            <input
                type="hidden"
                name="return_to"
                value="{{ request.path }}"
            >
        {% endform %}
    </localization-form>
{% endcapture %}

{% capture open_button %}
    <span class="flex items-center gap-x-2">
        {{
            localization.country
            | image_url: width: 20
            | image_tag: class: 'object-contain size-4'
        }}
        {{ localization.language.iso_code | upcase }}
    </span>
    {% render 'component.icon',
        type: icon_type,
        class: icon_class
    %}
{% endcapture %}

{%- render 'component.modal',
    data_id: 'country-language-selector',
    open_button: open_button,
    content: localization_form,
    content_class: 'text-secondary bg-white',
    is_popup: true,
    is_drawer: false,
    attributes: localization_modal_attributes,
    open_button_class: 'w-full justify-between',
    drawer_from_right: false,
    desktop_popup_mobile_drawer: '',
    blur: false,
    backdrop_extra_class: 'bg-black/50',
    is_top_zero: false
-%}
