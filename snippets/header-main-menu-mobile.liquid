{% liquid
    # Use the menu chosen in the header section, like the desktop navigation
    assign menu = menu | default: linklists['main-menu'].links
%}

{%- liquid
    assign account_aria_label = 'accessibility.open_user_account' | t
    if customer
        assign account_link = routes.account_url
        assign account_label = 'customer.account.title' | t
    else
        assign account_link = routes.account_login_url
        assign account_label = 'customer.login_page.title' | t
    endif
    assign mobile_nav_label = 'accessibility.mobile_navigation_menu' | t
    assign mobile_nav_attributes = 'aria-label="' | append: mobile_nav_label | append: '"'
-%}

{% capture mobile_menu_content %}
    <div
        class="flex flex-col h-full relative pt-6 px-5 overflow-y-auto! overflow-x-hidden"
        style="background-color: {{ header_background_color }}; color: {{ header_text_color }};"
    >
        <nav>
            <offcanvas-menu>
                <ul class="flex flex-col gap-y-7">
                    {% render 'header-main-menu-mobile-submenu',
                        menu: menu,
                        header_background_color: header_background_color,
                        header_text_color: header_text_color
                    %}
                </ul>
            </offcanvas-menu>
        </nav>
        <div class="mt-auto pt-6 pb-6 flex flex-col gap-y-5 border-t border-current/20">
            {% if shop.customer_accounts_enabled %}
                <shopify-account
                    menu="customer-account-main-menu"
                    class="inline-flex items-center gap-x-3 min-h-6"
                >
                    <div slot="signed-out-avatar">
                        {%- render 'component.icon', type: 'customer_account' -%}
                    </div>
                </shopify-account>
            {% else %}
                <a
                    href="{{- account_link -}}"
                    aria-label="{{ account_aria_label }}"
                    class="inline-flex items-center gap-x-3"
                >
                    {%- render 'component.icon', type: 'customer_account' -%}
                    <span>{{ account_label }}</span>
                </a>
            {% endif %}
            {%- render 'localization-form',
                icon_type: 'chevron',
                icon_class: 'rotate-90 w-3 aspect-square'
            -%}
        </div>
    </div>
{% endcapture %}

{%- render 'component.modal',
    data_id: 'offcanvas-menu',
    open_button: '',
    content: mobile_menu_content,
    content_class: 'h-[calc(100vh-var(--header-offset,0px)+1px)]! w-full translate-x-full data-open:translate-x-0 data-leave:duration-300 duration-300 ease-out pointer-events-auto bg-background absolute top-[calc(var(--header-offset,0px)-1px)]',
    is_popup: false,
    is_drawer: true,
    attributes: mobile_nav_attributes,
    drawer_from_right: true,
    desktop_popup_mobile_drawer: false,
    blur: false,
    is_top_zero: false,
    hide_backdrop: true,
    modal_group: 'header'
-%}
