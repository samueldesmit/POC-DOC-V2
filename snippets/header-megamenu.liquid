{% liquid
    assign current_collection = collection.handle
%}

<mega-menu
    id="mega-menu"
    class="z-20 group/mega-menu"
>
    <div
        aria-hidden="true"
        data-close-menu
        class="absolute left-1/2 w-screen -translate-x-1/2 top-header-height h-lvh w-full pointer-events-none group-data-[open]/mega-menu:pointer-events-auto bg-primary-background/30 opacity-0 group-data-[open]/mega-menu:opacity-100 group-data-[leave]/mega-menu:duration-75 group-data-[open]/mega-menu:duration-150 backdrop-blur-sm cursor-pointer"
    ></div>
    <nav>
        <ul class="flex flex-wrap justify-center -ml-3">
            {%- # Links (Level 1) -%}
            {%- for link in menu -%}
                {% liquid
                    assign collection_handle = link.title | handle
                    assign collection_handleized = link.title | handleize
                    assign collection = collections[collection_handle]
                    assign metaobject = collection.metafields.custom.category_banner.value
                    assign mega_menu_item_tag = 'p'
                    assign mega_menu_item_class = 'cursor-pointer'
                    if link.url != blank and link.url != '#'
                        assign mega_menu_item_tag = 'a'
                        assign mega_menu_item_class = ''
                    endif
                %}
                {%- # Used in <mega-menu> -%}
                <mega-menu-item
                    role="listitem"
                    class="flex justify-center px-3 py-4 font-sans font-normal text-sm leading-5 tracking-[-0.01em] group/item"
                    aria-label="{{- 'accessibility.header_menu_navigation' | t -}}"
                    {%- # Enable dropdown menu toggle -%}
                    {% if link.levels > 0 -%}
                        data-dropdown
                    {%- endif -%}
                >
                    <{{ mega_menu_item_tag }}
                        href="{{- link.url -}}"
                        class="inline-flex items-center gap-1 {{ mega_menu_item_class }}"
                    >
                        {{- link.title -}}
                        {%- if link.levels > 0 -%}
                            {%- render 'component.icon',
                                type: 'chevron',
                                class: 'size-3 rotate-90 transition-transform duration-150 group-data-[open]/item:-rotate-90'
                            -%}
                        {%- endif -%}
                    </{{ mega_menu_item_tag }}>
                    {%- # Dropdown -%}
                    {%- if link.levels > 0 -%}
                        <div
                            class="pointer-events-none absolute left-1/2 w-screen -translate-x-1/2 top-header-height group-data-[leaving]/item:pointer-events-none group-data-[open]/item:pointer-events-auto"
                        >
                            <div
                                data-target="mega-menu-item.dropdown"
                                class="relative w-full opacity-0 group-data-[open]/item:opacity-100 mega-menu-panel"
                            >
                                <div class="container grid grid-cols-4 description-body">
                                    <div class="grid grid-cols-3 col-span-3 gap-x-12">
                                        {%- assign items_per_column = link.links.size
                                            | divided_by: 3.0
                                            | ceil
                                        -%}
                                        {%- for column_index in (1..3) -%}
                                            {%- assign column_offset = items_per_column
                                                | times: column_index
                                                | minus: items_per_column
                                            -%}
                                            <ul class="flex flex-col gap-y-3">
                                                {%- for link in link.links
                                                    offset: column_offset
                                                    limit: items_per_column
                                                -%}
                                                    {% liquid
                                                        assign child_collection_handleized = link.title | handleize
                                                    %}
                                                    <li class="relative">
                                                        <a
                                                            href="{{- link.url -}}"
                                                            class="inline-flex py-4 hover:opacity-50 {% if current_collection == child_collection_handleized %}underline decoration-2 underline-offset-4{% endif %}"
                                                        >
                                                            {{- link.title -}}
                                                        </a>
                                                        {%- if link.links -%}
                                                            <ul class="">
                                                                {%- for sublink in link.links -%}
                                                                    {% liquid
                                                                        assign grandchild_collection_handleized = sublink.title | handleize
                                                                    %}
                                                                    <li class="font-normal">
                                                                        <a
                                                                            href="{{- sublink.url -}}"
                                                                            class="inline-flex px-4 py-3 hover:opacity-50 {% if current_collection == grandchild_collection_handleized %}underline decoration-2 underline-offset-4{% endif %}"
                                                                        >
                                                                            {{- sublink.title -}}
                                                                        </a>
                                                                    </li>
                                                                {%- endfor -%}
                                                            </ul>
                                                        {%- endif -%}
                                                    </li>
                                                {%- endfor -%}
                                            </ul>
                                        {%- endfor -%}
                                    </div>
                                    <div class="flex flex-col col-span-1">
                                        {%- # Category banner -%}
                                        {%- if metaobject.image != blank -%}
                                            <responsive-media
                                                data-target="mega-menu-item.card-image"
                                                class="mb-7 w-full h-52 aspect-3/2 last:mb-0"
                                            >
                                                {{-
                                                    metaobject.image
                                                    | image_url: width: 600
                                                    | image_tag:
                                                        loading: 'lazy',
                                                        class: 'h-full w-full object-cover'
                                                -}}
                                            </responsive-media>
                                        {%- endif -%}
                                        {% if metaobject.title != blank %}
                                            {%- render 'component.heading',
                                                tag: 'h3',
                                                variant: 'sm',
                                                content: metaobject.title,
                                                class: ' mb-5 last:mb-0'
                                            -%}
                                        {% endif %}
                                        {% if metaobject.description != blank %}
                                            <p
                                                class="font-normal body"
                                            >
                                                {{ metaobject.description }}
                                            </p>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        </div>
                    {%- endif -%}
                </mega-menu-item>
            {%- endfor -%}
        </ul>
    </nav>
</mega-menu>
