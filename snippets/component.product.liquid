{% doc %}
    Renders the product item with image, title, price, and optional add to cart functionality.

    @param {object} product - The product object (required)
    @param {boolean} eager - Eager load first product image (default: false)
    @param {object} current_variant - The current variant object (default: product.selected_or_first_available_variant)
    @param {boolean} add_to_cart - Show add to cart button (default: false)
    @param {boolean} product_link - Changes article image and description wrappers into links (default: false)
    @param {string} class - CSS classes for the product card (default: '')

    @example
    {%- render 'component.product',
        product: product,
        eager: true,
        add_to_cart: true
    -%}
{% enddoc %}

{%- liquid
    if eager
        assign loading = 'eager'
    else
        assign loading = 'lazy'
    endif

    assign current_variant = current_variant | default: product.selected_or_first_available_variant
    assign add_to_cart = add_to_cart | default: false, allow_false: true
    assign card_image = current_variant.featured_image | default: product.featured_image
    assign product_tag_link = 'div'

    if product_link
        assign product_tag_link = 'a'
    endif

    for item in cart.items
        if item.variant.id == current_variant.id
            assign quantity_for_id = item.quantity
            break
        endif
    endfor
-%}

<plp-product-card
    id="current-variant-{{ current_variant.id }}"
    class="relative group/plp"
    data-product-handle="{{ product.handle }}"
    data-variant-id="{{ current_variant.id }}"
    data-variants="
        [
          {%- for variant in product.variants -%}
            {
              'variantId': {{ variant.id }},
              {%- for option in variant.options -%}
                '{{ product.options[forloop.index0] | downcase }}': '{{ option | escape }}'{% unless forloop.last %},{% endunless %}
              {%- endfor -%}
            }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
    "
>
    <div
        class="pointer-events-none hidden absolute top-0 left-0 w-full aspect-square z-30 items-center justify-center group-data-[loading]/plp:flex"
        aria-hidden="true"
    >
        <div class=" p-3 animate-atc-tick-pop">
            {%- render 'component.icon',
                type: 'atc_tick',
                class: 'atc-tick text-[#47805B] group-data-[loading]/plp:stroke-[2] group-data-[loading]/plp:[stroke-dasharray:164] group-data-[loading]/plp:[stroke-dashoffset:164] group-data-[loading]/plp:animate-[atcTickDraw_350ms_ease-out_forwards] group-data-[loading]/plp:[animation-delay:80ms]'
            -%}
        </div>
    </div>
    <div class="block gap-4 transition! duration-500! group-data-[loading]/plp:opacity-50! group-data-[loading]/plp:cursor-not-allowed! group-data-[loading]/plp:pointer-events-none!">
        <div
            class="product-card__link group relative "
        >
            <div class="relative bg-background w-full">
                <a
                    class="absolute inset-0 z-10"
                    href="{{- current_variant.url -}}"
                    aria-label="{{ product.title | escape }}"
                ></a>
                <responsive-media class="{{ class }} aspect-square w-full {% if product.images[1] %} lg:group-hover:opacity-0 transition-opacity duration-300 {% endif %}">
                    {%- if card_image != blank -%}
                        {{-
                            card_image
                            | image_url: width: 800
                            | image_tag:
                                sizes: '(max-width: 768px) 50vw, (max-width: 1024px) 33vw, 25vw',
                                widths: '180, 280, 400, 560, 720, 800',
                                class: 'w-full object-cover',
                                loading: loading
                        -}}
                    {%- else -%}
                        {%- render 'component.placeholder-image', class: 'aspect-square' -%}
                    {%- endif -%}
                </responsive-media>
                {%- if product.images[1] -%}
                    <responsive-media class="absolute aspect-square w-full inset-0 flex items-start justify-center opacity-0 transition-opacity duration-300 lg:group-hover:opacity-100 {{ class }}">
                        {{-
                            product.images[1]
                            | image_url: width: 800
                            | image_tag:
                                sizes: '(max-width: 768px) 50vw, (max-width: 1024px) 33vw, 25vw',
                                widths: '180, 280, 400, 560, 720, 800',
                                class: 'w-full object-cover',
                                loading: loading
                        -}}
                    </responsive-media>
                {%- endif -%}
            </div>
        </div>

        <div class="flex flex-col justify-center md:block w-full md:mt-6">
            <{{ product_tag_link }}
                class="product-card__content"
                href="{{- current_variant.url -}}"
            >
                <p class="text-primary text-base font-medium mb-2 md:mb-0 md:min-h-[3rem]">
                    {{- product.title -}}
                </p>
            </{{ product_tag_link }}>
            <div class="flex flex-col gap-2 justify-between md:flex-row md:items-center md:h-[2.375rem] mb-3">
                {%- render 'component.price',
                    current_variant: current_variant,
                    class: 'headline-3xs lg:text-base font-poppins flex items-center font-light',
                    price_class: 'text-primary'
                -%}
                {% if add_to_cart == true %}
                    {% liquid
                        if current_variant.available == false
                            assign disabled = true
                            assign atc_label = 'products.product.sold_out' | t
                        else
                            assign disabled = false
                            assign atc_label = 'products.product.add_to_cart' | t
                        endif
                    %}

                    {%- form 'product', product, class: '' -%}
                        <input
                            type="hidden"
                            name="id"
                            value="{{ current_variant.id }}"
                        >
                        <add-to-cart
                            class="cursor-pointer relative group/atc"
                            productId="{{ current_variant.id }}"
                        >
                            {% render 'component.button',
                                variant: 'primary',
                                label: atc_label,
                                class: 'w-fit group-data-[loading]/atc:[&>span]:opacity-0',
                                attributes: 'data-atc-button',
                                disabled: disabled
                            %}
                            <span
                                class="hidden group-data-[loading]/atc:flex absolute inset-0 items-center justify-center pointer-events-none"
                                aria-hidden="true"
                            >
                                <span class="inline-block w-4 h-4 border-2 border-current border-t-transparent rounded-full animate-spin"></span>
                            </span>
                        </add-to-cart>
                    {%- endform -%}
                {% endif %}
            </div>
        </div>
    </div>
    {%- if product.variants.size > 1 -%}
        {% render 'component.product.plp-variant-swatches',
            product: product,
            current_variant: current_variant,
            show_thumbnails: true,
            hide_thumbnails: false,
            color_option_name: 'color'
        %}
    {%- endif -%}
</plp-product-card>
