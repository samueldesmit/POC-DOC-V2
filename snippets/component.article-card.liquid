{% liquid
    assign class = class
    assign read_more = 'blogs.article.read_more' | t
%}

<article
    class="relative group {{ class -}}"
>
    <responsive-media class="w-full h-64 mb-5 aspect-4/3">
        {%- if article.image != blank -%}
            {{-
                article.image
                | image_url: height: 520
                | image_tag: class: 'w-full h-full object-cover'
            -}}
        {%- else -%}
            {% render 'component.placeholder-image' %}
        {%- endif -%}
    </responsive-media>

    <div class="space-y-4 mb-7">
        {% render 'component.heading',
            tag: 'h3',
            variant: 'md',
            content: article.title,
            class: 'line-clamp-2'
        %}
        <div class="flex gap-x-6 headline-3xs">
            <span>
                {{- article.published_at | time_tag: format: 'date' -}}
            </span>
            <span>·</span>
            <span>{{ article.author }}</span>
        </div>
        <div class="line-clamp-3 font-open body">
            {{- article.excerpt -}}
        </div>
    </div>

    {% render 'component.button',
        label: read_more,
        title: read_more,
        class: 'gap-x-3 group-hover:opacity-50',
        aria_label: read_more,
        variant: 'ghost',
        icon: 'arrow-right',
        icon_position: 'right',
        icon_class: 'w-5 h-5'
    %}
    <a
        class="absolute inset-0"
        href="{{- article.url -}}"
    ></a>
</article>
