{% unless product.variants.size <= 1 %}
    <div
        class="mb-6 lg:mb-8"
        data-options
    >
        {% for option in product.options_with_values %}
            {% assign option_values_count = option.values | size %}
            <div class="mb-6 lg:mb-8 last:mb-0  {% if option_values_count == 1 %} hidden {% endif %}">
                <span class="block mb-1">
                    <span class="uppercase">{{ option.name }}:</span>
                    <span>
                        {{- option.selected_value -}}
                    </span>
                </span>
                <div class="flex flex-wrap gap-2">
                    {% for option_value in option.values %}
                        {%- liquid
                            assign option_disabled = true

                            for variant in product.variants
                                assign is_variant_available = false

                                if variant.inventory_management == 'shopify'
                                    if variant.inventory_quantity > 0
                                        assign is_variant_available = true
                                    endif
                                else
                                    assign is_variant_available = true
                                endif

                                case option.position
                                    when 1
                                        if variant.option1 == option_value and is_variant_available
                                            assign option_disabled = false
                                            break
                                        endif
                                    when 2
                                        if variant.option2 == option_value and is_variant_available
                                            assign option_disabled = false
                                            break
                                        endif
                                    when 3
                                        if variant.option3 == option_value and is_variant_available
                                            assign option_disabled = false
                                            break
                                        endif
                                endcase
                            endfor
                        -%}

                        <div class="relative group">
                            <input
                                type="radio"
                                id="{{ product.id }}-option-{{ option.position }}-{{ forloop.index }}"
                                name="option{{ option.position }}"
                                value="{{ option_value }}"
                                {% if option.selected_value == option_value %}
                                    checked
                                {% endif %}
                                class="absolute h-0 w-0 peer opacity-0"
                                {% if option_disabled %}
                                    data-disabled
                                {% endif %}
                            >
                            <label
                                for="{{ product.id }}-option-{{ option.position }}-{{ forloop.index }}"
                                class="data-disabled:opacity-40"
                                {% if option_disabled %}
                                    data-disabled
                                {% endif %}
                            >
                                {%- assign option_name_normalized = option.name | downcase -%}
                                {% case option_name_normalized %}
                                    {% when 'colour', 'color' %}
                                        {% liquid
                                            assign option_key = 'option' | append: option.position
                                            assign variant_with_option_image = product.variants | where: option_key, option_value | first
                                        %}

                                        <div class="w-[4.5rem] cursor-pointer hover:bg-background/40 bg-background border-2 border-primary/20 p-1 h-full relative overflow-hidden group-has-[:checked]:border-primary transition duration-200">
                                            {% if option_disabled %}
                                                <div class="absolute inset-0 flex items-center justify-center pointer-events-none z-10">
                                                    <div class="w-[140%] h-[2px] bg-primary rotate-[-47deg]"></div>
                                                </div>
                                            {% endif %}
                                            {% if variant_with_option_image.featured_image
                                                    != blank
                                            %}
                                                <responsive-media class="w-full aspect-[74/80] lg:aspect-[83/90] mix-blend-multiply">
                                                    {{
                                                        variant_with_option_image.featured_image
                                                        | image_url: width: 200
                                                        | image_tag:
                                                            class: 'object-cover'
                                                    }}
                                                </responsive-media>
                                            {% else %}
                                                <div class=" h-full flex justify-center items-center text-xs text-center">
                                                    {{ option_value }}
                                                </div>
                                            {% endif %}
                                        </div>

                                    {% else %}
                                        <div class="mr-2 overflow-hidden relative cursor-pointer hover:bg-primary-background hover:text-primary-foreground border border-primary/30 h-10 px-5 flex items-center justify-center group-has-[:checked]:bg-primary-background group-has-[:checked]:border-primary group-has-[:checked]:text-primary-foreground transition duration-200">
                                            {{ option_value }}
                                            {% if option_disabled %}
                                                <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
                                                    <div class="w-[140%] h-[1.5px] bg-primary rotate-[-15deg]"></div>
                                                </div>
                                            {% endif %}
                                        </div>
                                {% endcase %}
                            </label>
                        </div>
                    {% endfor %}
                </div>
            </div>
        {% endfor %}
    </div>

    <script type="application/json">
        [
            {% for variant in product.variants %}
            {
                "id": {{ variant.id }},
                "options": [{% for option in variant.options %}"{{ option }}"{% unless forloop.last %},{% endunless %}{% endfor %}],
                "available": {{ variant.available }},
                "inventory_quantity": {{ variant.inventory_quantity | default: 0 }}
            }{% unless forloop.last %},{% endunless %}
            {% endfor %}
        ]
    </script>
{% endunless %}
