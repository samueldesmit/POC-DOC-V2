{% doc %}
    Renders a button or link with one of the style variants.

    @param {string} [label] - Button text
    @param {string} [variant] - primary | secondary | ghost | red | red-ghost (default: primary)
    @param {string} [href] - If set, renders <a>; otherwise <button>
    @param {string} [type] - button | submit | reset (default: button)
    @param {string} [class] - Extra CSS classes
    @param {string} [attributes] - Extra HTML attributes (data-*, event handlers)
    @param {string} [icon] - Icon name
    @param {string} [icon_position] - left | right (default: left)
    @param {string} [icon_class] - Icon CSS classes (default: w-2.5 h-2.5)
    @param {string} [aria_label] - Accessible label
    @param {string} [title] - Tooltip text
    @param {string} [id] - Element id
    @param {boolean} [disabled] - Disable the button (default: false)
    @param {boolean} [loading] - Show loading spinner (default: false)

    @example
    {% render 'component.button',
        label: 'Add to cart',
        variant: 'primary',
        icon: 'cart_add',
        icon_position: 'right',
        type: 'submit'
    %}
{% enddoc %}

{%- liquid
    assign variant = variant | default: 'primary'
    assign type = type | default: 'button'
    assign icon_position = icon_position | default: 'left'
    assign icon_class = icon_class | default: 'w-2.5 h-2.5'

    assign base_classes = 'flex items-center justify-center cursor-pointer transition-colors duration-100 focus:outline-1 focus:outline-offset-1 disabled:cursor-not-allowed disabled:opacity-50'

    case variant
        when 'secondary'
            assign variant_classes = 'px-6 py-2 bg-button-green-hover text-white border border-button-green-hover focus:outline-button-green-hover hover:bg-button-green hover:border-button-green'
        when 'ghost'
            assign variant_classes = 'text-button-green focus:outline-button-green border border-button-green px-6 py-2'
        when 'red'
            assign variant_classes = 'px-6 py-2 bg-button-red text-white border border-button-red focus:outline-button-red hover:bg-button-red-hover hover:border-button-red-hover'
        when 'red-ghost'
            assign variant_classes = 'text-button-red focus:outline-button-red border border-button-red px-6 py-2'
        else
            assign variant_classes = 'px-6 py-2 bg-button-green text-white border border-button-green focus:outline-button-green hover:bg-button-green-hover hover:border-button-green-hover'
    endcase

    assign classes = base_classes | append: ' ' | append: variant_classes | append: ' ' | append: class | strip

    if href != blank
        assign tag = 'a'
    else
        assign tag = 'button'
    endif
-%}

<{{ tag }}
    class="{{ classes }}"
    {% if href != blank %}
        href="{{ href }}"
    {% else %}
        type="{{ type }}"
    {% endif %}
    {% if id != blank %}
        id="{{ id }}"
    {% endif %}
    {% if aria_label != blank %}
        aria-label="{{ aria_label }}"
    {% endif %}
    {% if title != blank %}
        title="{{ title }}"
    {% endif %}
    {% if disabled and href == blank %}
        disabled
    {% endif %}
    {% if loading %}
        aria-busy="true"
    {% endif %}
    {% if attributes != blank %}
        {{- attributes -}}
    {% endif %}
>
    {%- if loading -%}
        <span
            class="inline-block w-4 h-4 border-2 border-current border-t-transparent rounded-full animate-spin"
        ></span>
    {%- endif -%}

    {%- if icon != blank and icon_position == 'left' -%}
        {% render 'component.icon', type: icon, class: icon_class %}
    {%- endif -%}

    {%- if label != blank -%}
        <span
            {% if loading %}
                class="sr-only"
            {% endif %}
        >
            {{- label -}}
        </span>
    {%- endif -%}

    {%- if icon != blank and icon_position == 'right' -%}
        {% render 'component.icon', type: icon, class: icon_class %}
    {%- endif -%}
</{{ tag }}>
