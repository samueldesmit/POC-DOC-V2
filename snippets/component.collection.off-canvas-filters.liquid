{% liquid
    capture total_active_values
        render 'component.collection.active-filters-counter', products: products
    endcapture

    assign total_active_values = total_active_values | plus: 0

    assign total_count = collection.products_count

    assign apply_label = 'collection.filters.apply' | t

    assign clear_all_button_label = 'collection.filters.clear_all' | t
%}

{% capture clear_all_attributes %}
    data-target="filters-form.clear-all"
    {% if total_active_values == 0 %}
        data-disabled
    {% endif %}
{% endcapture %}

{% capture off_canvas_filters_content %}
    <div class="flex h-full flex-col relative">
        <header class="px-7 py-5 border-b border-b-primary flex justify-center items-center relative">
            <span
                data-target="filters-form.products-count-mobile"
                class="flex flex-col justify-center items-center space-y-1"
            >
                <span class="text-lg font-normal">
                    {{
                        'collection.filters.off_canvas_filters_header_title'
                        | t
                    -}}
                </span>
                <span class="text-base font-light">
                    {%- if total_count == 1 -%}
                        {{-
                            'collection.filters.product_count_simple.one'
                            | t: count: total_count
                        -}}
                    {%- else -%}
                        {{-
                            'collection.filters.product_count_simple.other'
                            | t: count: total_count
                        -}}
                    {%- endif -%}
                </span>
            </span>
            <modal-toggle
                target="off-canvas-filters"
                aria-hidden="true"
                class="absolute right-1 top-1/2 -translate-y-1/2"
            >
                {% render 'component.icon',
                    type: 'close',
                    class: 'size-4 text-primary'
                %}
            </modal-toggle>
        </header>

        <div class="p-6 flex-1 overflow-hidden">
            <div class="overflow-y-auto h-full">
                <off-canvas-filters class="block">
                    <ul>
                        {%- for filter in collection.filters -%}
                            <li class="py-3">
                                {%- liquid
                                    assign sorted_values = filter.values
                                    # Keep the selected values grouped together when operator is AND

                                    if filter.operator == 'AND'
                                        assign active_filter_values = filter.values | where: 'active', true
                                        assign inactive_filter_values = filter.values | where: 'active', false
                                        assign sorted_values = active_filter_values | concat: inactive_filter_values
                                    endif

                                    assign filter_label = filter.label
                                -%}

                                <div class="filter-button">
                                    {% render 'component.button',
                                        label: filter_label,
                                        title: filter_label,
                                        aria_label: filter_label,
                                        variant: 'ghost',
                                        icon: 'full_long_arrow',
                                        icon_position: 'right',
                                        icon_class: 'text-primary'
                                    %}
                                    <div
                                        class="pr-7"
                                        data-target="filters-form.filer-active-values"
                                    >
                                        {%- case filter.type -%}
                                            {%- when 'list' -%}
                                                {%- for active_value in filter.active_values -%}
                                                    {{ active_value.label -}}
                                                    {%- unless forloop.last -%}
                                                        ,
                                                    {%- endunless %}
                                                {%- endfor -%}
                                            {%- when 'price_range' -%}
                                                {% if filter.min_value.value
                                                        != null
                                                    or filter.max_value.value
                                                        != null
                                                %}
                                                    {% if filter.min_value.value %}
                                                        {{-
                                                            filter.min_value.value
                                                            | money
                                                        }}
                                                    {% else %}
                                                        {{ 0 | money }}
                                                    {% endif %}
                                                    -
                                                    {% if filter.max_value.value %}
                                                        {{-
                                                            filter.max_value.value
                                                            | money
                                                        }}
                                                    {% else %}
                                                        {{
                                                            filter.range_max
                                                            | money
                                                        }}
                                                    {% endif %}
                                                {% endif %}
                                        {%- endcase -%}
                                    </div>
                                </div>

                                <div class="filter-content absolute z-10 left-0 h-full w-full top-0 overflow-hidden translate-x-full data-open:translate-x-0 flex flex-col transition data-leave:duration-300 duration-300 ease-out bg-background">
                                    <header class="px-7 py-5 border-b border-b-primary flex items-center">
                                        {% render 'component.button',
                                            title: filter_label,
                                            class: 'filter-back-button',
                                            aria_label: filter_label,
                                            variant: 'ghost',
                                            icon: 'full_long_arrow',
                                            icon_position: 'right',
                                            icon_class: 'text-primary rotate-180'
                                        %}
                                        <span class="text-base w-full text-center">
                                            {{ filter_label }}
                                        </span>
                                    </header>

                                    <div class="p-6 h-full flex-1 overflow-hidden">
                                        <div class="overflow-y-auto h-full">
                                            {%- case filter.type -%}
                                                {%- when 'list' -%}
                                                    <div class="flex flex-col">
                                                        {%- render 'component.collection.filter-list-values',
                                                            sorted_values: sorted_values,
                                                            list_class: 'py-4'
                                                        -%}
                                                    </div>

                                                {%- when 'price_range' -%}
                                                    {%- render 'component.collection.filter-price-range-values',
                                                        filter: filter
                                                    -%}
                                            {%- endcase -%}
                                        </div>
                                    </div>
                                    <footer class="grid grid-cols-2 w-full justify-between items-center gap-x-4 border-t border-t-primary p-5">
                                        <div class="clear-whole-filter-container inline">
                                            {%- liquid
                                                assign show_count = show_count | default: true
                                                assign default_class = 'border-b border-current data-disabled:opacity-50 data-disabled:pointer-events-none bg-transparent cursor-pointer p-0'
                                                assign button_class = button_class | default: default_class
                                            -%}

                                            <button
                                                type="button"
                                                data-target="filters-form.clear-all"
                                                {% if total_active_values == 0 %}
                                                    data-disabled
                                                {% endif %}
                                                class="{{ button_class }}"
                                                >
                                                {{ 'collection.filters.clear_all' | t -}}
                                                {%- if show_count and total_active_values > 0 %}
                                                    ({{ total_active_values }})
                                                {%- endif %}
                                            </button>
                                        </div>
                                        <modal-toggle
                                            target="off-canvas-filters"
                                            aria-hidden="true"
                                        >
                                            {% capture show_results_attributes %}
                                                data-target="filters-form.show-results"
                                            {% endcapture %}

                                            {% render 'component.button',
                                                label: apply_label,
                                                title: apply_label,
                                                class: 'w-full text-center',
                                                variant: 'primary',
                                                attributes: show_results_attributes
                                            %}
                                        </modal-toggle>
                                    </footer>
                                </div>
                            </li>
                        {%- endfor -%}
                    </ul>
                </off-canvas-filters>
            </div>
        </div>
        <footer class="grid grid-cols-2 w-full justify-between items-center gap-x-4 border-t border-t-primary p-5">
           
            {%- liquid
                assign show_count = show_count | default: true
                assign default_class = 'border-b border-current data-disabled:opacity-50 data-disabled:pointer-events-none bg-transparent cursor-pointer p-0'
                assign button_class = button_class | default: default_class
            -%}

            <button
                type="button"
                data-target="filters-form.clear-all"
                {% if total_active_values == 0 %}
                    data-disabled
                {% endif %}
                class="{{ button_class }}"
                >
                {{ 'collection.filters.clear_all' | t -}}
                {%- if show_count and total_active_values > 0 %}
                    ({{ total_active_values }})
                {%- endif %}
            </button>

            <modal-toggle
                target="off-canvas-filters"
                aria-hidden="true"
            >
                {% capture show_results_attributes %}
                    data-target="filters-form.show-results"
                {% endcapture %}

                {% render 'component.button',
                    label: apply_label,
                    title: apply_label,
                    class: 'w-full text-center',
                    variant: 'primary',
                    attributes: show_results_attributes
                %}
            </modal-toggle>
        </footer>
    </div>
{% endcapture %}

{% capture off_canvas_filters_open_button %}{% endcapture %}

{%- render 'component.modal',
    data_id: 'off-canvas-filters',
    open_button: off_canvas_filters_open_button,
    content: off_canvas_filters_content,
    content_class: 'h-full overflow-hidden bg-background w-[87%]',
    is_popup: false,
    is_drawer: true,
    drawer_from_right: false,
    attributes: 'aria-labelledby="off-canvas-filters-title"',
    blur: false,
    is_top_zero: false,
    open_button_class: '',
    desktop_popup_mobile_drawer: false
-%}
