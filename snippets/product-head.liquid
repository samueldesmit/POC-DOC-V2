<meta
    itemprop="name"
    content="{{ product.title }}{% unless product.has_only_default_variant %} - {{ product.selected_or_first_available_variant.title }}{% endunless %}"
>
<meta
    itemprop="url"
    content="{{ shop.url }}{{ product.selected_or_first_available_variant.url }}"
>
<meta
    itemprop="brand"
    content="{{ product.vendor }}"
>
{%- comment -%}
    Not every colour is photographed, and `image_url` errors on a variant
    without one, printing the failure into the tag. The product image stands in.
{%- endcomment -%}
{%- assign head_image = product.selected_or_first_available_variant.featured_image
    | default: product.featured_image
-%}
{%- if head_image != blank -%}
    <meta
        itemprop="image"
        content="{{ shop.url }}{{ head_image | image_url: width: 600, height: 600 }}"
    >
{%- endif -%}
<meta
    itemprop="description"
    content="{{ product.description | strip_html | escape }}"
>

<script type="application/ld+json">
    {
      "@context": "http://schema.org/",
      "@type": "Product",
      "name": "{{ product.title }}",
      "url": "{{request.origin}}{{ product.selected_or_first_available_variant.url }}",
      "image": "{{ product.featured_image | image_url: width: 600 | replace: '//w', 'https://w'}}",
      "description": "{{ product.description | strip_html | escape }}",
      "brand": {
        "@type": "Brand",
        "name": "{{ product.vendor }}"
      },
      "offers": [
        {
          "@type": "Offer",
          "availability": "http://schema.org/{% if product.selected_or_first_available_variant.available %}InStock{% else %}OutOfStock{% endif %}",
          "price": {{ product.selected_or_first_available_variant.unit_price | divided_by: 100.00 }},
          "priceCurrency": "{{ shop.currency }}",
          "url": "{{request.origin}}{{ product.selected_or_first_available_variant.url }}",
          "sku": "{{ product.selected_or_first_available_variant.sku }}",
          "image": "{{ product.featured_image | image_url: width: 600, height: 600 | replace: '//w', 'https://w'}}",
          "brand": {
            "@type": "Brand",
            "name": "{{ product.vendor }}"
          }
        }
      ]
    }
</script>

<script
    type="application/json"
    id="variant-data"
>
    {
      "variants": [{% for variant in product.variants %}{
        "id": {{ variant.id }},
        "title": {{ variant.title | json }},
        "image": {% if variant.image %}{{ variant.image | img_url: '500x' | json }}{% else %}null{% endif %},
        "available": {{ variant.available }},
        "price": {{ variant.price }},
        "compare_at_price": {% if variant.compare_at_price != blank %}{{ variant.compare_at_price }}{% else %}null{% endif %}
      }{% if forloop.last != true %},{% endif %}{% endfor %}]
    }
</script>
