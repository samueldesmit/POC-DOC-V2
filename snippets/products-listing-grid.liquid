{%- liquid
    assign total_active_values = 0
    assign clear_all_label = 'collection.filters.clear_all' | t

    if template contains 'collection'
        assign listing_type = 'collection'
        assign listing = collection
    else
        assign listing_type = 'search'
        assign listing = search
    endif

    capture total_active_values
        render 'component.collection.active-filters-counter', collection: listing
    endcapture

    assign total_active_values = total_active_values | plus: 0
    assign results = listing
    assign sort_by = results.sort_by | default: results.default_sort_by
    if results.url
        if sort_by != results.default_sort_by
            assign results_url = results.url | append: '?sort_by=' | append: sort_by
        else
            assign results_url = results.url
        endif
    else
        assign terms = results.terms | escape
        assign results_url = '?q=' | append: terms | append: '&options%5Bprefix%5D=last&sort_by=' | append: sort_by
    endif
    assign filter_stock = listing.filters | where: 'param_name', 'filter.v.availability' | map: 'active_values' | first | map: 'value' | first

    if listing.results_count and listing_type == 'search'
        assign total_count = search.results | where: 'object_type', 'product' | size
    elsif listing.products_count
        assign total_count = listing.products_count
    endif
-%}

{% capture clear_all_attributes %}
  data-target="filters-form.clear-all"
  {% if total_active_values == 0 %}
      data-disabled
  {% endif %}
{% endcapture %}

{% if total_count == 0 and listing_type == 'search' %}
    {% if terms != blank %}
        <div class="container">
            <p class="text-lg font-bold text-center py-8">
                {{ 'general.search_page.no_results' | t: query: terms }}
            </p>
        </div>
    {% endif %}
{% else %}
    <product-collection
        class="block"
        data-section-id="{{ section.id }}"
    >
        <div class="flex mb-7 lg:hidden">
            <div class="w-[50%] px-5 py-3 border border-primary border-l-0">
                {% render 'component.collection.sort-form',
                    collection: listing
                %}
            </div>

            <div class="w-[50%] px-5 py-3 border-y border-primary">
                <modal-toggle
                    target="off-canvas-filters"
                    class="flex justify-center gap-x-3 text-primary"
                >
                    <button
                        type="button"
                        aria-label="{{ 'collection.filters.filter' | t }}"
                        class="flex justify-center gap-x-3 text-primary"
                    >
                        {% render 'component.icon',
                            type: 'filter_mobile_icon',
                            class: 'size-6'
                        %}
                        <span>{{ 'collection.filters.filter' | t }}</span>
                    </button>
                </modal-toggle>
            </div>
        </div>
        <div class="container">
            <div class="block lg:grid lg:grid-cols-4 lg:gap-x-4">
                {% comment %} MOBILE {% endcomment %}
                <filters-form
                    data-mobile
                    class="lg:hidden transition-colors duration-300 ease-out group/filters-form data-loading:pointer-events-none"
                >
                    <form>
                        <div
                            data-target="filters-form.active-filters"
                            class="mb-7 lg:border-b lg:border-b-primary data-disabled:hidden"
                            {% if total_active_values == 0 %}
                                data-disabled
                            {% endif %}
                        >
                            <div class="active-filters-inner flex flex-wrap space-x-4">
                                {% render 'component.collection.active-filters',
                                    collection: listing
                                %}
                            </div>
                            {% render 'component.button',
                                label: clear_all_label,
                                title: clear_all_label,
                                class: 'w-fit self-center',
                                attributes: clear_all_attributes,
                                aria_label: clear_all_label,
                                variant: 'primary'
                            %}
                        </div>
                        <div class="lg:hidden">
                            {% render 'component.collection.off-canvas-filters',
                                products: listing,
                                results_url: results_url
                            %}
                        </div>
                    </form>
                </filters-form>

                {% comment %} DESKTOP {% endcomment %}
                <filters-form
                    data-desktop
                    class="hidden lg:block lg:pr-8 transition-colors duration-300 ease-out group/filters-form data-loading:pointer-events-none"
                >
                    <form>
                        <header
                            class="items-center mb-4 justify-between data-disabled:hidden hidden lg:flex"
                            data-target="filters-form.header"
                            {% if total_active_values == 0 %}
                                data-disabled
                            {% endif %}
                        >
                            <span
                                data-target="filters-form.title"
                                class="text-base font-light"
                            >
                                {{ 'collection.filters.filter_by_label' | t }}

                                {% if total_active_values > 0 -%}
                                    ({{ total_active_values }})
                                {%- endif %}
                            </span>

                            {%- liquid
                                assign show_count = show_count | default: true
                                assign default_class = 'border-b border-current data-disabled:opacity-50 data-disabled:pointer-events-none bg-transparent cursor-pointer p-0'
                                assign button_class = button_class | default: default_class
                            -%}

                            <button
                                type="button"
                                data-target="filters-form.clear-all"
                                {% if total_active_values == 0 %}
                                    data-disabled
                                {% endif %}
                                class="{{ button_class }}"
                            >
                                {{ 'collection.filters.clear_all' | t -}}
                                {%- if show_count and total_active_values > 0 %}
                                    ({{ total_active_values }})
                                {%- endif %}
                            </button>
                        </header>
                        <div
                            data-target="filters-form.active-filters"
                            class="pb-6 mb-6 lg:border-b lg:border-b-primary data-disabled:hidden"
                            {% if total_active_values == 0 %}
                                data-disabled
                            {% endif %}
                        >
                            <div class="active-filters-inner">
                                {% render 'component.collection.active-filters',
                                    collection: listing
                                %}
                            </div>
                        </div>

                        <div class="hidden lg:flex flex-col gap-6">
                            {% render 'component.collection.filters',
                                collection: listing
                            %}
                        </div>
                    </form>
                </filters-form>

                <div class="lg:col-span-3">
                    <div class="flex items-center mb-8 lg:mb-7 justify-between text-base font-light">
                        <product-count
                            data-text
                            class="mt-4"
                        >
                            {%- if listing.results_count -%}
                                {%- if listing.results_count == 1 -%}
                                    {{ 'collection.pagination.one_result' | t }}
                                {%- else -%}
                                    {{
                                        'collection.pagination.other_results'
                                        | t: count: listing.results_count
                                    }}
                                {%- endif -%}
                            {%- elsif listing.products_count
                                    == listing.all_products_count
                            -%}
                                {%- if listing.products_count == 1 -%}
                                    {{
                                        'collection.pagination.one_product'
                                        | t
                                    }}
                                {%- else -%}
                                    {{
                                        'collection.pagination.other_products'
                                        | t: count: listing.products_count
                                    }}
                                {%- endif -%}
                            {%- else -%}
                                {%- if listing.products_count == 1 -%}
                                    {{
                                        'collection.pagination.one_product_of_count'
                                        | t: total: listing.all_products_count
                                    }}
                                {%- else -%}
                                    {{
                                        'collection.pagination.other_products_of_count'
                                        | t:
                                            count: listing.products_count,
                                            total: listing.all_products_count
                                    }}
                                {%- endif -%}
                            {%- endif -%}
                        </product-count>
                        <div class="hidden lg:block">
                            {% render 'component.collection.sort-form',
                                collection: listing
                            %}
                        </div>
                    </div>

                    {%- if listing_type == 'collection' -%}
                        {%- paginate collection.products by 6 -%}
                            <product-grid
                                class="flex flex-col gap-y-9 relative"
                                data-current-page="{{ paginate.current_page }}"
                            >
                                {%- assign label = 'collection.pagination.load_previous'
                                    | t
                                -%}
                                {%- if paginate.current_page != 1 -%}
                                    {% render 'component.button',
                                        label: label,
                                        title: label,
                                        class: 'w-fit self-center',
                                        attributes: 'data-load-more="prev"',
                                        aria_label: label,
                                        variant: 'primary'
                                    %}
                                {%- endif -%}
                                <filter-loading-desktop
                                    class="absolute inset-0 grid grid-cols-2 pb-20 mx-2 transition-opacity duration-300 ease-in-out opacity-0 pointer-events-none gap-y-4 gap-x-4 justify-items-center md:grid-cols-3 md:gap-x-7 md:px-8 desktop:grid-cols-4 md:gap-y-7 z-10"
                                >
                                    {%- for i in (1..3) -%}
                                        <div class="flex flex-col w-42 md:w-[300px] animate-pulse">
                                            <div
                                                class="mb-5 bg-background h-[61.034vw] md:h-[29.997vw] lg:h-80"
                                            ></div>
                                            <div class="flex justify-between mb-2">
                                                <div
                                                    class="w-24 h-5 bg-background "
                                                ></div>
                                                <div
                                                    class="w-12 h-5 bg-background "
                                                ></div>
                                            </div>
                                            <div
                                                class="w-16 h-4 mb-4 bg-background "
                                            ></div>
                                            <div class="flex">
                                                <div
                                                    class=" w-4 h-4 bg-background mr-2.5"
                                                ></div>
                                                <div
                                                    class=" w-4 h-4 bg-background mr-2.5"
                                                ></div>
                                                <div
                                                    class=" w-4 h-4 bg-background mr-2.5"
                                                ></div>
                                            </div>
                                        </div>
                                    {%- endfor -%}
                                </filter-loading-desktop>
                                <div
                                    data-products-grid
                                    class="grid grid-cols-2 gap-x-2 gap-y-6 lg:gap-x-4 lg:grid-cols-3 transition-opacity duration-300 ease-in-out relative z-0"
                                    data-target="product-grid.grid"
                                >
                                    {%- for product in collection.products
                                        limit: products_per_page
                                    -%}
                                        {%- if product.metafields.custom.show_variants_on_plp -%}
                                            {% assign colors = '' %}

                                            {%- for variant in product.variants -%}
                                                {% assign current_color = '|'
                                                    | append: variant.option1
                                                    | append: '|'
                                                %}

                                                {%- if filter_stock
                                                    and variant.available
                                                        == false
                                                -%}
                                                    {%- continue -%}
                                                {%- endif -%}

                                                {% unless colors
                                                        contains current_color
                                                %}
                                                    {% assign colors = colors
                                                        | append: current_color
                                                    %}
                                                    {% if collection.metafields.custom.variant_filtered_collection.value
                                                            == true
                                                    %}
                                                        {% for variant_collection in variant.metafields.custom.included_in_collections.value %}
                                                            {% if variant_collection.title
                                                                    == collection.title
                                                            %}
                                                                <div
                                                                    data-product-card-container
                                                                    class="transition duration-500 data-[loading]:opacity-50! data-[loading]:cursor-not-allowed! data-[loading]:pointer-events-none!"
                                                                >
                                                                    {% render 'component.product',
                                                                        product: product,
                                                                        current_variant: variant,
                                                                        add_to_cart: false,
                                                                        product_link: true,
                                                                        class: 'aspect-[198/214] md:aspect-[384/400] mix-blend-multiply',
                                                                        eager: false,
                                                                        show_wishlist: 'plp-add-to-wishlist-button'
                                                                    %}
                                                                </div>
                                                            {% endif %}
                                                        {% endfor %}
                                                    {% else %}
                                                        <div
                                                            data-product-card-container
                                                            class="transition duration-500 data-[loading]:opacity-50! data-[loading]:cursor-not-allowed! data-[loading]:pointer-events-none!"
                                                        >
                                                            {% render 'component.product',
                                                                product: product,
                                                                current_variant: variant,
                                                                add_to_cart: false,
                                                                product_link: true,
                                                                class: 'aspect-[198/214] md:aspect-[384/400] mix-blend-multiply',
                                                                eager: false,
                                                                show_wishlist: 'plp-add-to-wishlist-button'
                                                            %}
                                                        </div>
                                                    {% endif %}
                                                {% endunless %}
                                            {%- endfor -%}

                                        {% else %}
                                            <div
                                                data-product-card-container
                                                class="transition duration-500 data-[loading]:opacity-50! data-[loading]:cursor-not-allowed! data-[loading]:pointer-events-none!"
                                            >
                                                {% render 'component.product',
                                                    product: product,
                                                    add_to_cart: false,
                                                    product_link: true,
                                                    class: 'aspect-[198/214] md:aspect-[384/400] mix-blend-multiply',
                                                    eager: false,
                                                    show_wishlist: 'plp-add-to-wishlist-button'
                                                %}
                                            </div>
                                        {% endif %}
                                    {%- endfor -%}
                                </div>

                                {% assign prods_shown = paginate.page_size
                                    | times: paginate.current_page
                                %}
                                {%- if collection.products_count > prods_shown
                                -%}
                                    <div class="flex items-center justify-center mb-2">
                                        {% assign label = 'collection.pagination.load_more'
                                            | t
                                        %}
                                        {% render 'component.button',
                                            label: label,
                                            title: label,
                                            attributes: 'data-load-next data-load-more="next"',
                                            aria_label: label,
                                            variant: 'primary',
                                            icon: 'spinner',
                                            icon_position: 'right',
                                            icon_class: 'w-4 h-4 animate-spin hidden lg:flex'
                                        %}
                                    </div>
                                {%- endif -%}
                            </product-grid>
                        {%- endpaginate -%}
                    {%- else -%}
                        {%- paginate search.results by 12 -%}
                            <product-grid
                                class="flex flex-col gap-y-9 relative"
                                data-current-page="{{ paginate.current_page }}"
                            >
                                {%- if paginate.current_page != 1 -%}
                                    <div class="flex items-center justify-center mb-2">
                                        {% assign label = 'collection.pagination.load_previous'
                                            | t
                                        %}
                                        {% render 'component.button',
                                            label: label,
                                            title: label,
                                            class: 'w-fit self-center',
                                            attributes: 'data-load-more="prev"',
                                            aria_label: label,
                                            variant: 'primary'
                                        %}
                                    </div>
                                {%- endif -%}
                                <filter-loading-desktop
                                    class="absolute inset-0 grid grid-cols-2 pb-20 mx-2 transition-opacity duration-300 ease-in-out opacity-0 pointer-events-none gap-y-4 gap-x-4 justify-items-center md:grid-cols-3 md:gap-x-7 md:px-8 desktop:grid-cols-4 md:gap-y-7 z-10"
                                >
                                    {%- for i in (1..3) -%}
                                        <div class="flex flex-col w-42 md:w-[300px] animate-pulse">
                                            <div
                                                class="mb-5 bg-background h-[61.034vw] md:h-[29.997vw] lg:h-80"
                                            ></div>
                                            <div class="flex justify-between mb-2">
                                                <div
                                                    class="w-24 h-5 bg-background "
                                                ></div>
                                                <div
                                                    class="w-12 h-5 bg-background "
                                                ></div>
                                            </div>
                                            <div
                                                class="w-16 h-4 mb-4 bg-background "
                                            ></div>
                                            <div class="flex">
                                                <div
                                                    class=" w-4 h-4 bg-background mr-2.5"
                                                ></div>
                                                <div
                                                    class=" w-4 h-4 bg-background mr-2.5"
                                                ></div>
                                                <div
                                                    class=" w-4 h-4 bg-background mr-2.5"
                                                ></div>
                                            </div>
                                        </div>
                                    {%- endfor -%}
                                </filter-loading-desktop>
                                <div
                                    data-products-grid
                                    class="grid grid-cols-2 gap-x-2 gap-y-6 lg:gap-x-4 lg:grid-cols-3 transition-opacity duration-300 ease-in-out relative z-0"
                                    data-target="product-grid.grid"
                                >
                                    {%- for product in search.results -%}
                                        {% if product.object_type == 'product'
                                        %}
                                            {%- if product.metafields.custom.show_variants_on_plp -%}
                                                {% assign colors = '' %}

                                                {%- for variant in product.variants -%}
                                                    {% assign current_color = '|'
                                                        | append: variant.option1
                                                        | append: '|'
                                                    %}

                                                    {%- if filter_stock
                                                        and variant.available
                                                            == false
                                                    -%}
                                                        {%- continue -%}
                                                    {%- endif -%}
                                                    {% unless colors
                                                            contains current_color
                                                    %}
                                                        {% assign colors = colors
                                                            | append: current_color
                                                        %}
                                                        <div
                                                            data-product-card-container
                                                            class="transition duration-500 data-[loading]:opacity-50! data-[loading]:cursor-not-allowed! data-[loading]:pointer-events-none!"
                                                        >
                                                            {% render 'component.product',
                                                                product: product,
                                                                current_variant: variant,
                                                                add_to_cart: false,
                                                                product_link: true,
                                                                class: 'aspect-[198/214] md:aspect-[384/400] mix-blend-multiply',
                                                                eager: false,
                                                                show_variants_on_plp: true,
                                                                show_wishlist: 'plp-add-to-wishlist-button'
                                                            %}
                                                        </div>
                                                    {% endunless %}
                                                {%- endfor -%}
                                            {% else %}
                                                <div
                                                    data-product-card-container
                                                    class="transition duration-500 data-[loading]:opacity-50! data-[loading]:cursor-not-allowed! data-[loading]:pointer-events-none!"
                                                >
                                                    {% render 'component.product',
                                                        product: product,
                                                        add_to_cart: false,
                                                        product_link: true,
                                                        class: 'aspect-[198/214] md:aspect-[384/400] mix-blend-multiply',
                                                        eager: false,
                                                        show_variants_on_plp: true,
                                                        show_wishlist: 'plp-add-to-wishlist-button'
                                                    %}
                                                </div>
                                            {% endif %}
                                        {% endif %}
                                    {%- endfor -%}
                                </div>
                                {% assign prods_shown = paginate.page_size
                                    | times: paginate.current_page
                                %}
                                {%- if collection.products_count > prods_shown
                                -%}
                                    <div class="flex items-center justify-center mb-2">
                                        {% assign label = 'collection.pagination.load_more'
                                            | t
                                        %}
                                        {% render 'component.button',
                                            label: label,
                                            title: label,
                                            class: 'w-fit self-center',
                                            attributes: 'data-load-next data-load-more="next"',
                                            aria_label: label,
                                            variant: 'primary',
                                            icon: 'spinner',
                                            icon_position: 'right',
                                            icon_class: 'w-4 h-4 animate-spin hidden lg:flex'
                                        %}
                                    </div>
                                {%- endif -%}
                            </product-grid>
                        {%- endpaginate -%}
                    {%- endif -%}
                    {%- if collection_description != blank -%}
                        <div class="mt-5 marker:[&_ol]:text-xl [&_:is(h1,h2,h3,h4,h5,h6)]:text-xl [&_li]:text-body [&_p]:text-base [&_p]:font-light [&>*:first-child]:mt-0 [&>*:first-child]:pt-0 [&>*:last-child]:mb-0 [&>*:last-child]:pb-0 [&_a]:underline lg:hover:[&_a]:opacity-100 [&_b]:font-bold [&_:is(h1,h2,h3,h4,h5,h6)]:mb-6 [&_ol]:list-decimal [&_ol]:py-[1em] [&_ol]:pl-[1em] [&_p:empty]:hidden [&_p]:mb-4 [&_strong]:font-bold [&_ul]:list-disc [&_ul]:py-[1em] [&_ul]:pl-[1em]">
                            {{- collection_description -}}
                        </div>
                    {%- endif -%}
                </div>
            </div>
        </div>
    </product-collection>
{% endif %}
