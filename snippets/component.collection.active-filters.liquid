{% liquid
    assign total_active_values = 0

    for filter in collection.filters
        assign total_active_values = total_active_values | plus: filter.active_values.size
    endfor

    for filter in collection.filters
        if filter.type == 'price_range'
            if filter.min_value.value != null or filter.max_value.value != null
                assign total_active_values = total_active_values | plus: 1
            endif
        endif
    endfor
    assign active_filter_classes = 'active-filter inline-flex whitespace-nowrap w-auto lg:flex px-4 py-3 bg-flash-white text-sm text-primary justify-between gap-x-2 items-center hover:opacity-60 transition duration-200 ease-in-out cursor-pointer'
%}

<active-filters class="flex flex-col gap-y-4 w-full p-6 {% if total_active_values > 0 %} mt-8 {% endif %} h-">
    {%- if total_active_values > 0 -%}
        <p class="text-base font-bold text-grey-matterhorn px-6 lg:px-0">
            {{ 'collection.filters.active_filters' | t }}
        </p>
    {%- endif -%}
    <div
        data-target="product-grid.active-filters"
        class="lg:flex items-center lg:flex-wrap gap-x-2 gap-y-2 grid snap-mandatory grid-flow-col snap-x w-full gap-1 scroll-px-4 overflow-x-scroll lg:overflow-x-hidden no-scrollbar px-6 lg:px-0 scrollbar-none"
    >
        {% for filter in collection.filters %}
            {% for active_value in filter.active_values %}
                {% assign total_active_values = total_active_values | plus: 1 %}
                <a
                    href="{{ active_value.url_to_remove }}"
                    role="button"
                    class="{{ active_filter_classes }} active-filter"
                    data-active-filter
                >
                    <span class="text-base">
                        {{- active_value.label -}}
                    </span>

                    {% render 'component.icon',
                        type: 'close',
                        class: 'size-3 text-primary'
                    %}
                </a>
            {% endfor %}
            {% if filter.type == 'price_range' %}
                {% if filter.min_value.value != null
                    or filter.max_value.value != null
                %}
                    <a
                        href="{{ filter.url_to_remove }}"
                        role="button"
                        class="{{ active_filter_classes }} active-filter"
                        data-active-filter
                    >
                        <span class="text-base">
                            {% if filter.min_value.value %}
                                {{- filter.min_value.value | money }}
                            {% else %}
                                {{ 0 | money }}
                            {% endif %}
                            -
                            {% if filter.max_value.value %}
                                {{- filter.max_value.value | money }}
                            {% else %}
                                {{ filter.range_max | money }}
                            {% endif %}
                        </span>

                        {% render 'component.icon',
                            type: 'close',
                            class: 'size-3 text-medium-grey'
                        %}
                    </a>
                {% endif %}
            {% endif %}
        {% endfor %}
    </div>
</active-filters>
