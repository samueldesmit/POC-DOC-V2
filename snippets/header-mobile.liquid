<div class="container grid grid-cols-3 items-center py-5 lg:hidden">
    <div class="flex items-end space-x-7 justify-self-start">
        <modal-toggle
            target="offcanvas-menu"
            class="flex"
            data-mobile-menu-toggle
        >
            <button
                type="button"
                aria-label="{{ 'accessibility.open_mobile_menu' | t }}"
                aria-haspopup="dialog"
                class="hamburger {% if fancy_hamburger %}hamburger--fancy{% endif %} relative w-6 h-6 flex flex-col justify-center gap-[5px] cursor-pointer"
            >
                <span class="hamburger-line block h-[2px] w-full bg-current origin-center"></span>
                <span class="hamburger-line block h-[2px] w-full bg-current"></span>
                <span class="hamburger-line block h-[2px] w-full bg-current origin-center"></span>
            </button>
        </modal-toggle>
    </div>

    {%- liquid
        assign logo_aria_label = 'accessibility.go_to_homepage' | t
        assign logo_attributes = 'aria-label="' | append: logo_aria_label | append: '"'
    -%}
    <a
        {{ logo_attributes }}
        href="{{ routes.root_url }}"
        class="flex w-12 h-9 justify-self-center"
    >
        {% if mobile_logo != blank %}
            <responsive-media class="w-full h-full{% if is_transparent_mode and transparent_mobile_logo != blank %} header-logo--default{% endif %}">
                {{
                    mobile_logo
                    | image_url: width: 100
                    | image_tag: class: 'w-full h-full object-contain'
                }}
            </responsive-media>
            {% if is_transparent_mode and transparent_mobile_logo != blank %}
                <responsive-media class="w-full h-full header-logo--transparent">
                    {{
                        transparent_mobile_logo
                        | image_url: width: 100
                        | image_tag: class: 'w-full h-full object-contain'
                    }}
                </responsive-media>
            {% endif %}
        {% else %}
            <p class="">{{ shop.name }}</p>
        {% endif %}
    </a>

    <div class="flex items-end justify-self-end">
        {% render 'header-action-menu' %}
    </div>

    {% render 'header-main-menu-mobile',
        menu: menu,
        header_background_color: header_background_color,
        header_text_color: header_text_color
    %}
</div>
