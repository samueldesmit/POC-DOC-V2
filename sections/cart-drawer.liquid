{%- unless template == 'cart' -%}
    {% capture cart_drawer_content %}
        <div class="flex h-full flex-col">
            <header class="flex items-center p-4">
                <p
                    class="text-xl"
                    id="cart-drawer-title"
                >
                    {{- 'cart.drawer.title' | t -}}
                </p>
                <div class="ml-auto flex gap-2">
                    <modal-toggle target="cart-drawer">
                        <button
                            aria-label="{{- 'accessibility.close_cart' | t -}}"
                            type="button"
                            class="ml-auto grid place-items-center p-2"
                        >
                            {% render 'component.icon', type: 'close', class: 'size-3 text-primary' %}
                        </button>
                    </modal-toggle>
                </div>
            </header>
            <cart-form
                class="group/cart-form flex grow flex-col"
                data-section-id="{{ section.id }}"
            >
                <div
                    data-loading
                    class="absolute w-full h-full z-20 bg-background opacity-0 left-0 top-0 pointer-events-none transition duration-500 data-[active]:pointer-events-auto data-[active]:opacity-80"
                ></div>
                <cart-items class="relative grow overflow-auto">
                    {%- for item in cart.items -%}
                        <cart-item
                            data-key="{{ item.key }}"
                            data-index="{{ forloop.index }}"
                            data-target="cart-items.item"
                            class="group/cart-item relative block transition duration-300 ease-out data-[loading]:pointer-events-none data-[loading]:opacity-50"
                        >
                            <div class="pointer-events-none absolute inset-0 z-30 hidden items-center justify-center group-data-[loading]/cart-item:flex">
                                <span class="inline-block size-6 border-2 border-current border-t-transparent rounded-full animate-spin text-primary"></span>
                            </div>
                            <article class="grid grid-cols-[max(20%,_5.5rem)_minmax(0,_1fr)] gap-4 border-t p-4">
                                <a
                                    href="{{ item.variant.url }}"
                                    class="overflow-hidden"
                                >
                                    <responsive-media
                                        class="aspect-square w-full bg-background before:bg-transparent"
                                        data-visible
                                    >
                                        {{
                                            item.image
                                            | image_url: width: 150
                                            | image_tag:
                                                class: 'object-contain'
                                        -}}
                                    </responsive-media>
                                </a>
                                <div
                                    class="flex"
                                    data-target="cart-item.details"
                                >
                                    <div class="flex flex-col gap-2 pb-1">
                                        <a href="{{ item.variant.url }}">
                                            {{- item.title -}}
                                        </a>

                                        {%- render 'cart-item-form'
                                            with item as item
                                        -%}
                                    </div>
                                    <p class="ml-auto w-fit">
                                        {{ item.final_line_price | money }}
                                    </p>
                                </div>
                            </article>
                        </cart-item>
                    {%- endfor -%}
                    {%- if cart.empty? %}
                        <div
                            class="space-y-4 p-4"
                            data-target="cart-items.empty"
                        >
                            <p>{{- 'cart.drawer.empty' | t -}}</p>
                            <a
                                href="{{ collections.all.url }}"
                                class="inline-flex items-center bg-primary-background px-3 py-2 text-primary-foreground"
                            >
                                {% render 'component.icon',
                                    type: 'fallback_icon',
                                %}
                                {{- 'cart.drawer.continue_shopping' | t -}}
                            </a>
                        </div>
                    {% else %}
                        <template data-target="cart-items.empty"></template>
                    {% endif -%}
                </cart-items>
                {% if section.settings.show_add_discount_code %}
                    {% render 'component.cart-discount', section_id: section.id %}
                {% endif %}
                <footer
                    class="flex flex-col gap-4 p-4"
                    data-target="cart-form.footer"
                >
                    {%- if cart.item_count > 0 %}
                        <p class="flex w-full">
                            <span>{{- 'cart.drawer.subtotal' | t -}}</span>
                            <span class="ml-auto">
                                {{- cart.total_price | money -}}
                            </span>
                        </p>
                        <form
                            action="{{ routes.cart_url }}"
                            method="post"
                            class="ml-auto flex w-fit gap-2 group-data-[loading]/cart-form:pointer-events-none"
                        >
                            <a
                                class="inline-flex items-center px-3 py-2"
                                href="{{ routes.cart_url }}"
                            >
                                {{- 'cart.drawer.view_cart' | t -}}
                            </a>

                            <button
                                type="submit"
                                name="checkout"
                                class="inline-flex items-center bg-primary-background px-3 py-2 text-primary-foreground"
                            >
                                {% render 'component.icon',
                                    type: 'fallback_icon',
                                    class: 'text-primary-foreground'
                                %}
                                {{- 'cart.drawer.checkout' | t -}}
                            </button>
                        </form>
                    {% endif -%}
                </footer>
            </cart-form>
        </div>
    {% endcapture %}

    {% capture cart_drawer_open_button %}
        {% render 'component.icon', type: 'cart' %}
    {% endcapture %}

    {%- liquid
        assign cart_drawer_label = 'accessibility.shopping_cart' | t
        assign cart_drawer_attributes = 'aria-label="' | append: cart_drawer_label | append: '"'
    -%}
    {%- render 'component.modal',
        data_id: 'cart-drawer',
        open_button: cart_drawer_open_button,
        content: cart_drawer_content,
        content_class: 'absolute right-0 ml-auto block size-full translate-x-full bg-white transition-transform duration-300 ease-out data-[open]:translate-x-0 data-[leave]:duration-150 data-[leave]:ease-in-out lg:w-[min(90%,_40rem)]',
        is_popup: false,
        is_drawer: true,
        attributes: cart_drawer_attributes,
        open_button_class: 'flex items-center cursor-pointer',
        drawer_from_right: true,
        desktop_popup_mobile_drawer: false,
        blur: true,
        is_top_zero: false
    -%}
{% endunless %}

{% schema %}
{
    "name": "Cart Drawer",
    "settings": [
        {
            "type": "checkbox",
            "id": "show_add_discount_code",
            "label": "Show add discount code",
            "default": true
        }
    ],
    "blocks": []
}
{% endschema %}
