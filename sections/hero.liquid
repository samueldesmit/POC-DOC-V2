{%- liquid
    assign s = section.settings
    assign section_id = 'section-' | append: section.id

    comment
        Hero height: 'full' keeps the existing aspect-ratio based height,
        '60' and '40' make the hero that percentage of the screen height.
    endcomment
    case s.hero_height
        when '60'
            assign media_height_class = 'w-full h-[60svh]'
        when '40'
            assign media_height_class = 'w-full h-[40svh]'
        else
            assign media_height_class = 'h-full w-full aspect-[375/552] lg:aspect-[1440/657]'
    endcase
-%}
{% render 'component.animation-open', section: section %}
<div
    id="{{ section_id }}"
    class="{{ s.mobile_margin }} {{ s.desktop_margin }} bg-background"
>
    {% render 'section-colors', current_section: section %}
    <div
        class="{{ s.desktop_padding }} {{ s.mobile_padding }}"
    >
        <splide-section
            data-splide-type="slide"
            data-splide-per-page-desktop="1"
            data-splide-per-page-mobile="1"
            data-splide-autoplay="true"
            data-splide-interval="5000"
            class="flex justify-between items-center"
        >
            <div class="splide w-full">
                <div class="h-full overflow-hidden splide__track w-full">
                    <ul class="flex splide__list w-full">
                        {%- for block in section.blocks -%}
                            {% liquid
                                assign b = block.settings
                            %}
                            {%- if b.image != blank -%}
                                {%- if forloop.first -%}
                                    {%- assign image_loading = 'eager' -%}
                                    {%- assign image_fetchpriority = 'high' -%}
                                {%- else -%}
                                    {%- assign image_loading = 'lazy' -%}
                                    {%- assign image_fetchpriority = 'auto' -%}
                                {%- endif -%}
                                {%- liquid
                                    case b.content_position_x
                                        when 'left'
                                            assign justify_class = 'justify-start'
                                            assign text_align_class = 'text-left items-start'
                                        when 'middle'
                                            assign justify_class = 'justify-center'
                                            assign text_align_class = 'text-center items-center'
                                        when 'right'
                                            assign justify_class = 'justify-end'
                                            assign text_align_class = 'text-right items-end'
                                    endcase
                                    case b.content_position_y
                                        when 'top'
                                            assign items_class = 'items-start'
                                        when 'middle'
                                            assign items_class = 'items-center'
                                        when 'bottom'
                                            assign items_class = 'items-end'
                                    endcase
                                -%}
                                <li
                                    class="splide__slide relative group"
                                >
                                    <responsive-media
                                        class="{{ media_height_class }}"
                                        data-visible
                                    >
                                        {{
                                            b.image
                                            | image_url: width: 1440
                                            | image_tag:
                                                class: 'object-cover w-full h-full',
                                                loading: image_loading,
                                                fetchpriority: image_fetchpriority,
                                                sizes: '100vw',
                                                widths: '375, 750, 1100, 1440, 1920'
                                        -}}
                                        {% if b.enable_overlay %}
                                            {% if b.overlay_type == 'color' %}
                                                <div class="absolute inset-0 bg-black" style="opacity: {{ b.overlay_opacity | divided_by: 100.0 }};"></div>
                                            {% elsif b.mobile_gradient != blank
                                                and b.desktop_gradient != blank
                                            %}
                                                {% render 'component.gradient',
                                                    mobile_bg: b.mobile_gradient,
                                                    desktop_bg: b.desktop_gradient,
                                                    mobile_visible: true,
                                                    desktop_visible: true
                                                %}
                                            {% endif %}
                                        {% endif %}
                                    </responsive-media>
                                    <div class="absolute left-0 top-0 w-full h-full">
                                        <div class="container h-full flex py-6 lg:py-12 {{ justify_class }} {{ items_class }}">
                                            <div class="flex flex-col gap-4 lg:max-w-[443px] {{ text_align_class }}">
                                            {% if b.subtitle != blank %}
                                                <p class="font-serif font-regular italic text-base text-primary">
                                                    {{ b.subtitle }}
                                                </p>
                                            {% endif %}
                                            {% if b.title != blank %}
                                                {%- render 'component.heading',
                                                    content: b.title,
                                                    variant: '2xl',
                                                    class: 'text-primary',
                                                    tag: 'h1'
                                                -%}
                                            {% endif %}
                                            {% if b.text != blank %}
                                                <p class="text-secondary">
                                                    {{ b.text }}
                                                </p>
                                            {% endif %}
                                            {% if b.button_url != blank
                                                and b.button_text != blank
                                            %}
                                                {% render 'component.button',
                                                    label: b.button_text,
                                                    variant: b.button_style,
                                                    href: b.button_url,
                                                    aria_label: b.button_text
                                                %}
                                            {% endif %}
                                            </div>
                                        </div>
                                    </div>
                                </li>
                            {%- endif -%}
                        {% endfor %}
                    </ul>
                </div>
            </div>
        </splide-section>
    </div>
</div>
{% render 'component.animation-close', section: section %}

{% schema %}
{
    "name": "Hero",
    "tag": "section",
    "class": "section_hero",
    "settings": [
        {
            "type": "header",
            "content": "Section Styling"
        },
        {
            "type": "checkbox",
            "id": "section_styling",
            "label": "Add styling to section",
            "info": "If enabled this shows the settings to set the color scheme, spacing, and margin for the section.",
            "default": false
        },
        {
            "type": "header",
            "content": "Section Color Scheme",
            "visible_if": "{{ section.settings.section_styling == true }}"
        },
        {
            "type": "header",
            "content": "Section Spacing",
            "visible_if": "{{ section.settings.section_styling == true }}"
        },
        {
            "type": "select",
            "id": "mobile_padding",
            "label": "Mobile padding",
            "visible_if": "{{ section.settings.section_styling == true }}",
            "options": [
                {
                    "value": "py-0",
                    "label": "None"
                },
                {
                    "value": "py-2",
                    "label": "Small - 8px"
                },
                {
                    "value": "py-4",
                    "label": "Medium - 16px"
                },
                {
                    "value": "py-6",
                    "label": "Large - 24px"
                }
            ],
            "default": "py-0"
        },
        {
            "type": "select",
            "id": "desktop_padding",
            "label": "Desktop padding",
            "visible_if": "{{ section.settings.section_styling == true }}",
            "options": [
                {
                    "value": "lg:py-0",
                    "label": "None"
                },
                {
                    "value": "lg:py-4",
                    "label": "Small - 16px"
                },
                {
                    "value": "lg:py-6",
                    "label": "Medium - 24px"
                },
                {
                    "value": "lg:py-8",
                    "label": "Large - 32px"
                }
            ],
            "default": "lg:py-4"
        },
        {
            "type": "header",
            "content": "Section Margin",
            "visible_if": "{{ section.settings.section_styling == true }}"
        },
        {
            "type": "select",
            "id": "mobile_margin",
            "label": "Mobile Section margin",
            "visible_if": "{{ section.settings.section_styling == true }}",
            "options": [
                {
                    "value": "mb-0",
                    "label": "None"
                },
                {
                    "value": "mb-4",
                    "label": "Small - 16px"
                },
                {
                    "value": "mb-8",
                    "label": "Medium - 32px"
                },
                {
                    "value": "mb-12",
                    "label": "Large - 48px"
                }
            ],
            "default": "mb-0"
        },
        {
            "type": "select",
            "id": "desktop_margin",
            "label": "Desktop Section margin",
            "visible_if": "{{ section.settings.section_styling == true }}",
            "options": [
                {
                    "value": "lg:mb-0",
                    "label": "None"
                },
                {
                    "value": "lg:mb-8",
                    "label": "Small - 32px"
                },
                {
                    "value": "lg:mb-12",
                    "label": "Medium - 48px"
                },
                {
                    "value": "lg:mb-16",
                    "label": "Large - 64px"
                }
            ],
            "default": "lg:mb-0"
        },
        {
            "type": "header",
            "content": "Colors",
            "visible_if": "{{ section.settings.section_styling == true }}"
        },
        {
            "type": "color",
            "id": "background",
            "label": "Section background color",
            "default": "#FFFFFF",
            "visible_if": "{{ section.settings.section_styling == true }}"
        },
        {
            "type": "color",
            "id": "primary_text_color",
            "label": "Primary text color",
            "default": "#000000",
            "visible_if": "{{ section.settings.section_styling == true }}"
        },
        {
            "type": "color",
            "id": "secondary_text_color",
            "label": "Secondary text color",
            "default": "#000000",
            "visible_if": "{{ section.settings.section_styling == true }}"
        },
        {
            "type": "color",
            "id": "primary_button_color",
            "label": "Primary button background color",
            "default": "#FFFFFF",
            "visible_if": "{{ section.settings.section_styling == true }}"
        },
        {
            "type": "color",
            "id": "primary_button_text_color",
            "label": "Primary button text color",
            "default": "#000000",
            "visible_if": "{{ section.settings.section_styling == true }}"
        },
        {
            "type": "color",
            "id": "secondary_button_color",
            "label": "Secondary button background color",
            "default": "#000000",
            "visible_if": "{{ section.settings.section_styling == true }}"
        },
        {
            "type": "color",
            "id": "secondary_button_text_color",
            "label": "Secondary button text color",
            "default": "#FFFFFF",
            "visible_if": "{{ section.settings.section_styling == true }}"
        },
        {
            "type": "header",
            "content": "Height"
        },
        {
            "type": "select",
            "id": "hero_height",
            "label": "Hero height",
            "info": "Full keeps the current height. 60% and 40% make the hero that percentage of the screen height.",
            "options": [
                {
                    "value": "full",
                    "label": "Full (current)"
                },
                {
                    "value": "60",
                    "label": "60% of screen height"
                },
                {
                    "value": "40",
                    "label": "40% of screen height"
                }
            ],
            "default": "full"
        },
        {
            "type": "header",
            "content": "Animation"
        },
        {
            "type": "select",
            "id": "animation_type",
            "label": "Animation",
            "options": [
                { "value": "none", "label": "None" },
                { "value": "fade-in", "label": "Fade in" },
                { "value": "fade-up", "label": "Fade up" },
                { "value": "fade-down", "label": "Fade down" },
                { "value": "fade-left", "label": "Fade in from left" },
                { "value": "fade-right", "label": "Fade in from right" },
                { "value": "zoom-in", "label": "Zoom in" },
                { "value": "zoom-out", "label": "Zoom out" },
                { "value": "stagger", "label": "Stagger" }
            ],
            "default": "fade-up"
        },
        {
            "type": "range",
            "id": "animation_duration",
            "label": "Duration",
            "min": 0.2,
            "max": 2,
            "step": 0.1,
            "unit": "s",
            "default": 0.8
        }
    ],
    "blocks": [
        {
            "type": "hero_slide",
            "name": "Hero Slide",
            "settings": [
                {
                    "id": "image",
                    "type": "image_picker",
                    "label": "image"
                },
                {
                    "type": "checkbox",
                    "id": "enable_overlay",
                    "default": false,
                    "label": "Enable overlay"
                },
                {
                    "type": "select",
                    "id": "overlay_type",
                    "label": "Overlay type",
                    "options": [
                        {
                            "value": "gradient",
                            "label": "Gradient"
                        },
                        {
                            "value": "color",
                            "label": "Color overlay"
                        }
                    ],
                    "default": "gradient",
                    "visible_if": "{{ block.settings.enable_overlay == true }}"
                },
                {
                    "type": "color_background",
                    "id": "mobile_gradient",
                    "label": "Gradient [Mobile]",
                    "info": "Click on color-picker to adjust gradient colors, direction and opacity",
                    "default": "linear-gradient(transparent, #000000)",
                    "visible_if": "{{ block.settings.enable_overlay == true and block.settings.overlay_type == 'gradient' }}"
                },
                {
                    "type": "color_background",
                    "id": "desktop_gradient",
                    "label": "Gradient [Desktop]",
                    "info": "Click on color-picker to adjust gradient colors, direction and opacity",
                    "default": "linear-gradient(transparent, #000000)",
                    "visible_if": "{{ block.settings.enable_overlay == true and block.settings.overlay_type == 'gradient' }}"
                },
                {
                    "type": "range",
                    "id": "overlay_opacity",
                    "label": "Overlay opacity",
                    "min": 0,
                    "max": 100,
                    "step": 5,
                    "unit": "%",
                    "default": 30,
                    "visible_if": "{{ block.settings.enable_overlay == true and block.settings.overlay_type == 'color' }}"
                },
                {
                    "type": "text",
                    "id": "subtitle",
                    "label": "Subtitle"
                },
                {
                    "type": "text",
                    "id": "title",
                    "label": "Title",
                    "default": "Hero Title"
                },
                {
                    "type": "text",
                    "id": "text",
                    "label": "Text",
                    "default": "Hero Text"
                },
                {
                    "type": "header",
                    "content": "Content position"
                },
                {
                    "type": "select",
                    "id": "content_position_x",
                    "label": "Horizontal position",
                    "options": [
                        { "value": "left", "label": "Left" },
                        { "value": "middle", "label": "Middle" },
                        { "value": "right", "label": "Right" }
                    ],
                    "default": "left"
                },
                {
                    "type": "select",
                    "id": "content_position_y",
                    "label": "Vertical position",
                    "options": [
                        { "value": "top", "label": "Top" },
                        { "value": "middle", "label": "Middle" },
                        { "value": "bottom", "label": "Bottom" }
                    ],
                    "default": "bottom"
                },
                {
                    "type": "text",
                    "id": "button_text",
                    "label": "Button text",
                    "default": "Button Text"
                },
                {
                    "type": "url",
                    "id": "button_url",
                    "label": "Button url"
                },
                {
                    "type": "select",
                    "id": "button_style",
                    "label": "Button style",
                    "options": [
                        {
                            "value": "primary",
                            "label": "Primary"
                        },
                        {
                            "value": "secondary",
                            "label": "Secondary"
                        },
                        {
                            "value": "ghost",
                            "label": "Ghost"
                        }
                    ],
                    "default": "primary"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "Hero",
            "blocks": [
                {
                    "type": "hero_slide",
                    "settings": {
                        "image": "shopify://shop_images/theme_cover_image.jpg",
                        "title": "Strix Group",
                        "text": "Pushing Boundaries",
                        "button_text": "Shop Now",
                        "button_url": "https://www.strix.net"
                    }
                },
                {
                    "type": "hero_slide",
                    "settings": {
                        "image": "shopify://shop_images/theme_cover_image.jpg",
                        "title": "Strix Group",
                        "text": "Pushing Boundaries",
                        "button_text": "Shop Now",
                        "button_url": "https://www.strix.net"
                    }
                },
                {
                    "type": "hero_slide",
                    "settings": {
                        "image": "shopify://shop_images/theme_cover_image.jpg",
                        "title": "Strix Group",
                        "text": "Pushing Boundaries",
                        "button_text": "Shop Now",
                        "button_url": "https://www.strix.net"
                    }
                }
            ]
        }
    ]
}
{% endschema %}
