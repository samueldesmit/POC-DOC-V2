{% liquid
    assign s = section.settings
    assign section_id = 'section-' | append: section.id
    assign prev_slide_label = 'accessibility.previous_slide' | t
    assign next_slide_label = 'accessibility.next_slide' | t
%}

{% render 'component.animation-open', section: section %}

<div
    id="{{ section_id }}"
    class="{{ s.mobile_margin }} {{ s.desktop_margin }} bg-background overflow-hidden"
>
    {% render 'section-colors', current_section: section %}
    <div class="container {{ s.mobile_padding }} {{ s.desktop_padding }}">
        <splide-section
            data-splide-type="slide"
            data-splide-per-page-mobile="1.05"
            data-splide-per-page-desktop="3"
            data-splide-gap-mobile="0.75rem"
            data-splide-gap-desktop="1rem"
            data-splide-autoplay="false"
            data-splide-pagination="false"
            data-splide-omit-end="true"
            data-splide-drag="true"
            data-splide-arrows="true"
            class="flex justify-between items-center"
        >
            <div class="splide w-full">
                <div class="flex items-center justify-between lg:justify-center mb-6 font-poppins font-normal lg:mb-8">
                    {%- if s.title != blank -%}
                        {%- render 'component.heading',
                            variant: 'lg',
                            tag: 'h2',
                            content: s.title,
                            class: 'text-primary'
                        -%}
                    {%- endif -%}

                    <div
                        class="splide__arrows pr-3 lg:pr-12 text-arrows-color {% if section.blocks.size <= 1 %}hidden{% else %}flex lg:hidden{% endif %}"
                    >
                        {%- render 'component.button',
                            title: prev_slide_label,
                            aria_label: prev_slide_label,
                            variant: 'ghost',
                            icon: 'chevron',
                            icon_position: 'left',
                            icon_class: 'rotate-180 size-3 md:size-5',
                            class: 'items-center justify-center px-2 lg:px-4 py-3 splide__arrow--prev'
                        %}
                        {%- render 'component.button',
                            title: next_slide_label,
                            aria_label: next_slide_label,
                            variant: 'ghost',
                            icon: 'chevron',
                            icon_position: 'right',
                            icon_class: 'size-3 md:size-5',
                            class: 'items-center justify-center px-2 lg:px-4 py-3 splide__arrow--next'
                        -%}
                    </div>
                </div>

                <div class="h-full !overflow-visible splide__track w-full">
                    <ul class="splide__list flex">
                        {% for block in section.blocks %}
                            {%- liquid
                                assign b = block.settings
                            -%}
                            {%- if b.article != blank -%}
                                <li class="splide__slide md:col-span-1">
                                    <div
                                        role="tabpanel"
                                        aria-roledescription="slide"
                                    >
                                        {% render 'component.article-card',
                                            article: b.article,
                                            class: 'col-span-1'
                                        %}
                                    </div>
                                </li>
                            {%- endif -%}
                        {% endfor %}
                    </ul>
                </div>
            </div>
        </splide-section>
    </div>
</div>

{% render 'component.animation-close', section: section %}

{% schema %}
{
    "name": "Blog Posts Highlight",
    "tag": "section",
    "disabled_on": {
        "groups": [
            "header",
            "footer"
        ]
    },
    "settings": [
        {
            "type": "header",
            "content": "Section Styling"
        },
        {
            "type": "checkbox",
            "id": "section_styling",
            "label": "Add styling to section",
            "info": "If enabled this shows the settings to set the color scheme, spacing, and margin for the section.",
            "default": false
        },
        {
            "type": "header",
            "content": "Section Color Scheme",
            "visible_if": "{{ section.settings.section_styling == true }}"
        },
        {
            "type": "header",
            "content": "Section Spacing",
            "visible_if": "{{ section.settings.section_styling == true }}"
        },
        {
            "type": "select",
            "id": "mobile_padding",
            "label": "Mobile padding",
            "visible_if": "{{ section.settings.section_styling == true }}",
            "options": [
                {
                    "value": "py-0",
                    "label": "None"
                },
                {
                    "value": "py-2",
                    "label": "Small - 8px"
                },
                {
                    "value": "py-4",
                    "label": "Medium - 16px"
                },
                {
                    "value": "py-6",
                    "label": "Large - 24px"
                }
            ],
            "default": "py-0"
        },
        {
            "type": "select",
            "id": "desktop_padding",
            "label": "Desktop padding",
            "visible_if": "{{ section.settings.section_styling == true }}",
            "options": [
                {
                    "value": "lg:py-0",
                    "label": "None"
                },
                {
                    "value": "lg:py-4",
                    "label": "Small - 16px"
                },
                {
                    "value": "lg:py-6",
                    "label": "Medium - 24px"
                },
                {
                    "value": "lg:py-8",
                    "label": "Large - 32px"
                }
            ],
            "default": "lg:py-4"
        },
        {
            "type": "header",
            "content": "Section Margin",
            "visible_if": "{{ section.settings.section_styling == true }}"
        },
        {
            "type": "select",
            "id": "mobile_margin",
            "label": "Mobile Section margin",
            "visible_if": "{{ section.settings.section_styling == true }}",
            "options": [
                {
                    "value": "mb-0",
                    "label": "None"
                },
                {
                    "value": "mb-4",
                    "label": "Small - 16px"
                },
                {
                    "value": "mb-8",
                    "label": "Medium - 32px"
                },
                {
                    "value": "mb-12",
                    "label": "Large - 48px"
                }
            ],
            "default": "mb-0"
        },
        {
            "type": "select",
            "id": "desktop_margin",
            "label": "Desktop Section margin",
            "visible_if": "{{ section.settings.section_styling == true }}",
            "options": [
                {
                    "value": "lg:mb-0",
                    "label": "None"
                },
                {
                    "value": "lg:mb-8",
                    "label": "Small - 32px"
                },
                {
                    "value": "lg:mb-12",
                    "label": "Medium - 48px"
                },
                {
                    "value": "lg:mb-16",
                    "label": "Large - 64px"
                }
            ],
            "default": "lg:mb-0"
        },
        {
            "type": "header",
            "content": "Colors",
            "visible_if": "{{ section.settings.section_styling == true }}"
        },
        {
            "type": "color",
            "id": "background",
            "label": "Section background color",
            "default": "#FFFFFF",
            "visible_if": "{{ section.settings.section_styling == true }}"
        },
        {
            "type": "color",
            "id": "primary_text_color",
            "label": "Primary text color",
            "default": "#000000",
            "visible_if": "{{ section.settings.section_styling == true }}"
        },
        {
            "type": "color",
            "id": "secondary_text_color",
            "label": "Secondary text color",
            "default": "#000000",
            "visible_if": "{{ section.settings.section_styling == true }}"
        },
        {
            "type": "color",
            "id": "primary_button_color",
            "label": "Primary button background color",
            "default": "#FFFFFF",
            "visible_if": "{{ section.settings.section_styling == true }}"
        },
        {
            "type": "color",
            "id": "primary_button_text_color",
            "label": "Primary button text color",
            "default": "#000000",
            "visible_if": "{{ section.settings.section_styling == true }}"
        },
        {
            "type": "color",
            "id": "secondary_button_color",
            "label": "Secondary button background color",
            "default": "#000000",
            "visible_if": "{{ section.settings.section_styling == true }}"
        },
        {
            "type": "color",
            "id": "secondary_button_text_color",
            "label": "Secondary button text color",
            "default": "#FFFFFF",
            "visible_if": "{{ section.settings.section_styling == true }}"
        },
        {
            "type": "header",
            "content": "Content"
        },
        {
            "type": "text",
            "id": "title",
            "label": "Title",
            "default": "Latest from our blog"
        },
        {
            "type": "header",
            "content": "Animation"
        },
        {
            "type": "select",
            "id": "animation_type",
            "label": "Animation",
            "options": [
                { "value": "none", "label": "None" },
                { "value": "fade-in", "label": "Fade in" },
                { "value": "fade-up", "label": "Fade up" },
                { "value": "fade-down", "label": "Fade down" },
                { "value": "fade-left", "label": "Fade in from left" },
                { "value": "fade-right", "label": "Fade in from right" },
                { "value": "zoom-in", "label": "Zoom in" },
                { "value": "zoom-out", "label": "Zoom out" },
                { "value": "stagger", "label": "Stagger" }
            ],
            "default": "fade-up"
        },
        {
            "type": "range",
            "id": "animation_duration",
            "label": "Duration",
            "min": 0.2,
            "max": 2,
            "step": 0.1,
            "unit": "s",
            "default": 0.8
        }
    ],
    "blocks": [
        {
            "type": "blog_post",
            "name": "Blog Post",
            "limit": 3,
            "settings": [
                {
                    "type": "article",
                    "id": "article",
                    "label": "Article"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "Blog Posts Highlight",
            "settings": {}
        }
    ]
}
{% endschema %}
