{%- liquid
    assign container_class = 'container flex flex-col items-center gap-y-7 py-6 lg:flex-row lg:gap-x-14 lg:py-11'
    assign s = section.settings

    if s.image != blank
        assign container_class = container_class | append: ' lg:px-[8.25rem]'
    endif
-%}

{% render 'component.animation-open', section: section %}

{% if section.blocks.size > 0 %}
    <div class="{{- container_class -}}">
        {%- liquid
            assign responsive_media_class = 'aspect-[343/277.5] w-full lg:-rotate-2 lg:aspect-[600/500]'

            if s.image != blank
                assign responsive_media_class = responsive_media_class | append: ' lg:w-[55%]'
            else
                assign responsive_media_class = responsive_media_class | append: ' lg:flex-1'
            endif

            if s.reversed
                assign responsive_media_class = responsive_media_class | append: ' order-last'
            endif
        -%}
        {%- if s.image != blank -%}
            <responsive-media class="{{- responsive_media_class -}}">
                {{-
                    s.image
                    | image_url: width: 1024
                    | image_tag:
                        sizes: '(max-width: 1024px) 100vw, 50vw'
                -}}
            </responsive-media>
        {%- endif -%}
        {%- liquid
            assign accordions_block_class = '[&>*]:border-t [&>*]:border-t-black [&>*:last-child]:border-b [&>*:last-child]:border-b-black '

            if s.image != blank
                assign accordions_block_class = accordions_block_class | append: ' w-full lg:w-[45%]'
            else
                assign accordions_block_class = accordions_block_class | append: ' w-full lg:flex-1 mx-auto max-w-[37.5rem]'
            endif
        -%}
        <ul class="{{- accordions_block_class -}}">
            {%- for block in section.blocks -%}
                {% assign b = block.settings %}
                <li {{ block.shopify_attributes }}>
                    {% render 'component.accordion',
                        header_class: 'py-4',
                        title: b.title,
                        title_class: 'text-body font-bold lg:text-title',
                        title_tag: b.title_tag,
                        content: b.content,
                        content_class: 'text-primary/70 font-medium leading-[1.4em] lg:text-body',
                        styled_content: true,
                        speed: 8000
                    %}
                </li>
            {%- endfor -%}
        </ul>
    </div>
{% endif %}

{% render 'component.animation-close', section: section %}

{% schema %}
{
    "name": "Accordion",
    "class": "section_accordion",
    "tag": "section",
    "settings": [
        {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
        },
        {
            "type": "checkbox",
            "id": "reversed",
            "label": "Show image after text block"
        },
        {
            "type": "header",
            "content": "Animation"
        },
        {
            "type": "select",
            "id": "animation_type",
            "label": "Animation",
            "options": [
                {
                    "value": "none",
                    "label": "None"
                },
                {
                    "value": "fade-in",
                    "label": "Fade in"
                },
                {
                    "value": "fade-up",
                    "label": "Fade up"
                },
                {
                    "value": "fade-down",
                    "label": "Fade down"
                },
                {
                    "value": "fade-left",
                    "label": "Fade in from left"
                },
                {
                    "value": "fade-right",
                    "label": "Fade in from right"
                },
                {
                    "value": "zoom-in",
                    "label": "Zoom in"
                },
                {
                    "value": "zoom-out",
                    "label": "Zoom out"
                },
                {
                    "value": "stagger",
                    "label": "Stagger"
                }
            ],
            "default": "fade-up"
        },
        {
            "type": "range",
            "id": "animation_duration",
            "label": "Duration",
            "min": 0.2,
            "max": 2,
            "step": 0.1,
            "unit": "s",
            "default": 0.8
        }
    
    ],
    "blocks": [
        {
            "type": "accordion_item",
            "name": "Accordion Item",
            "settings": [
                {
                    "type": "select",
                    "id": "title_tag",
                    "label": "Title tag",
                    "default": "h4",
                    "info": "Use for SEO purposes",
                    "options": [
                        {
                            "value": "h1",
                            "label": "H1"
                        },
                        {
                            "value": "h2",
                            "label": "H2"
                        },
                        {
                            "value": "h3",
                            "label": "H3"
                        },
                        {
                            "value": "h4",
                            "label": "H4"
                        },
                        {
                            "value": "h5",
                            "label": "H5"
                        },
                        {
                            "value": "h6",
                            "label": "H6"
                        }
                    ]
                },
                {
                    "type": "text",
                    "id": "title",
                    "label": "Title"
                },
                {
                    "type": "richtext",
                    "id": "content",
                    "label": "Content"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "Accordion",
            "settings": {
                "reversed": "false"
            },
            "blocks": [
                {
                    "type": "accordion_item",
                    "settings": {
                        "title_tag": "h4",
                        "title": "Accordion Title",
                        "content": "<p>Accordion content</p>"
                    }
                },
                {
                    "type": "accordion_item",
                    "settings": {
                        "title_tag": "h4",
                        "title": "Accordion Title",
                        "content": "<p>Accordion content</p>"
                    }
                },
                {
                    "type": "accordion_item",
                    "settings": {
                        "title_tag": "h4",
                        "title": "Accordion Title",
                        "content": "<p>Accordion content</p>"
                    }
                }
            ]
        }
    ]
}
{% endschema %}
