<div class="flex min-h-screen flex-col p-6 lg:p-8">
    <header class="mb-6 lg:mb-8">
        {%- # Add your logo -%}
        <h1 class="text-xl">{{ shop.name }}</h1>
    </header>

    <section class="flex flex-col">
        {%- form 'storefront_password' -%}
            {%- if form.errors -%}
                <p
                    id="password-error"
                    class="mb-3 text-primary"
                    role="alert"
                >
                    {{ 'general.password.error' | t }}
                </p>
            {%- endif -%}
            <fieldset class="flex gap-1">
                <label
                    for="password"
                    class="sr-only"
                >
                    {{- 'general.password.label' | t -}}
                </label>
                <input
                    id="password"
                    class="
                        w-full appearance-none border border-solid px-4 py-3 text-primary placeholder:text-secondary
                        disabled:cursor-not-allowed disabled:bg-background disabled:text-secondary disabled:placeholder:text-secondary lg:w-64
                        max-[1024px]:text-base
                    "
                    name="password"
                    type="password"
                    placeholder="{{ 'general.password.placeholder' | t }}"
                    autocomplete="current-password"
                    required
                    {% if form.errors %}
                        aria-invalid="true" aria-describedby="password-error"
                    {% endif %}
                >
                <button
                    class="relative flex items-center justify-center border bg-primary-background px-3 py-2 text-center text-primary-foreground "
                    type="submit"
                >
                    {{ 'general.password.submit' | t }}
                </button>
            </fieldset>
        {%- endform -%}
    </section>
</div>

{% schema %}
{
    "name": "Password",
    "settings": [],
    "blocks": []
}
{% endschema %}
