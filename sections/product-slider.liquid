{% liquid
    assign s = section.settings
    assign section_id = 'section-' | append: section.id
    assign product_list = s.collection.products | default: s.product_list
%}

{% if product_list != blank %}
    <div
        id="{{ section_id }}"
        class="{{ s.mobile_margin }} {{ s.desktop_margin }} bg-background overflow-hidden"
    >
        {% render 'section-colors', current_section: section %}
        <div class="container {{ s.mobile_padding }} {{ s.desktop_padding }}">
            {% render 'component.animation-open', section: section %}
            <splide-section
                data-splide-type="slide"
                data-splide-per-page-mobile="1.1"
                data-splide-per-page-desktop="3.2"
                data-splide-gap-desktop="1rem"
                data-splide-gap-mobile="1rem"
                data-splide-arrows="true"
            >
                <div class="splide w-full">
                    <div class="flex flex-col mb-8">
                        {% if s.text != blank %}
                            <p class="text-secondary text-sm line-clamp-1">
                                {{ s.text }}
                            </p>
                        {% endif %}
                        <div class="flex justify-between gap-3">
                            {% if s.title != blank %}
                                <div class="text-primary text-2xl">
                                    {{ s.title }}
                                </div>
                            {% endif %}
                            {% render 'component.splide-arrows',
                                variant: 'primary',
                                icon_class: 'size-5',
                                container_class: 'splide__arrows splide__arrows--ltr space-x-3 items-center pointer-events-none z-10 hidden lg:flex'
                            %}
                        </div>
                        {% if s.button_url != blank %}
                            {%- render 'component.button',
                                label: s.button_text,
                                title: s.button_text,
                                href: s.button_url,
                                class: 'border-transparent hover:border-transparent w-fit mt-4',
                                variant: s.button_style,
                                aria_label: s.button_text
                            -%}
                        {% endif %}
                    </div>
                    <div class="w-full h-full mx-auto splide__track !overflow-visible">
                        <ul class="w-full splide__list">
                            {% for product in product_list %}
                                <li class="splide__slide w-full">
                                    {% render 'component.product',
                                        product: product,
                                        product_link: true,
                                        add_to_cart: true,
                                        class: 'h-full w-full aspect-[310/420] md:aspect-[400/420]',
                                        eager: false,
                                        current_variant: product.selected_or_first_available_variant
                                    %}
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                </div>
            </splide-section>
            {% render 'component.animation-close', section: section %}
        </div>
    </div>
{% endif %}

{% schema %}
{
    "name": "Product Slider",
    "tag": "section",
    "class": "product-slider",
    "disabled_on": {
        "groups": ["header", "footer"]
    },
    "settings": [
        {
            "type": "header",
            "content": "Section Styling"
        },
        {
            "type": "checkbox",
            "id": "section_styling",
            "label": "Add styling to section",
            "info": "If enabled this shows the settings to set the color scheme, spacing, and margin for the section.",
            "default": false
        },
        {
            "type": "header",
            "content": "Section Color Scheme",
            "visible_if": "{{ section.settings.section_styling == true }}"
        },
        {
            "type": "header",
            "content": "Section Spacing",
            "visible_if": "{{ section.settings.section_styling == true }}"
        },
        {
            "type": "select",
            "id": "mobile_padding",
            "label": "Mobile padding",
            "visible_if": "{{ section.settings.section_styling == true }}",
            "options": [
                {
                    "value": "py-0",
                    "label": "None"
                },
                {
                    "value": "py-2",
                    "label": "Small - 8px"
                },
                {
                    "value": "py-4",
                    "label": "Medium - 16px"
                },
                {
                    "value": "py-6",
                    "label": "Large - 24px"
                }
            ],
            "default": "py-0"
        },
        {
            "type": "select",
            "id": "desktop_padding",
            "label": "Desktop padding",
            "visible_if": "{{ section.settings.section_styling == true }}",
            "options": [
                {
                    "value": "lg:py-0",
                    "label": "None"
                },
                {
                    "value": "lg:py-4",
                    "label": "Small - 16px"
                },
                {
                    "value": "lg:py-6",
                    "label": "Medium - 24px"
                },
                {
                    "value": "lg:py-8",
                    "label": "Large - 32px"
                }
            ],
            "default": "lg:py-4"
        },
        {
            "type": "header",
            "content": "Section Margin",
            "visible_if": "{{ section.settings.section_styling == true }}"
        },
        {
            "type": "select",
            "id": "mobile_margin",
            "label": "Mobile Section margin",
            "visible_if": "{{ section.settings.section_styling == true }}",
            "options": [
                {
                    "value": "mb-0",
                    "label": "None"
                },
                {
                    "value": "mb-4",
                    "label": "Small - 16px"
                },
                {
                    "value": "mb-8",
                    "label": "Medium - 32px"
                },
                {
                    "value": "mb-12",
                    "label": "Large - 48px"
                }
            ],
            "default": "mb-0"
        },
        {
            "type": "select",
            "id": "desktop_margin",
            "label": "Desktop Section margin",
            "visible_if": "{{ section.settings.section_styling == true }}",
            "options": [
                {
                    "value": "lg:mb-0",
                    "label": "None"
                },
                {
                    "value": "lg:mb-8",
                    "label": "Small - 32px"
                },
                {
                    "value": "lg:mb-12",
                    "label": "Medium - 48px"
                },
                {
                    "value": "lg:mb-16",
                    "label": "Large - 64px"
                }
            ],
            "default": "lg:mb-0"
        },
        {
            "type": "header",
            "content": "Colors",
            "visible_if": "{{ section.settings.section_styling == true }}"
        },
        {
            "type": "color",
            "id": "background",
            "label": "Section background color",
            "default": "#FFFFFF",
            "visible_if": "{{ section.settings.section_styling == true }}"
        },
        {
            "type": "color",
            "id": "primary_text_color",
            "label": "Primary text color",
            "default": "#000000",
            "visible_if": "{{ section.settings.section_styling == true }}"
        },
        {
            "type": "color",
            "id": "secondary_text_color",
            "label": "Secondary text color",
            "default": "#000000",
            "visible_if": "{{ section.settings.section_styling == true }}"
        },
        {
            "type": "color",
            "id": "primary_button_color",
            "label": "Primary button background color",
            "default": "#FFFFFF",
            "visible_if": "{{ section.settings.section_styling == true }}"
        },
        {
            "type": "color",
            "id": "primary_button_text_color",
            "label": "Primary button text color",
            "default": "#000000",
            "visible_if": "{{ section.settings.section_styling == true }}"
        },
        {
            "type": "color",
            "id": "secondary_button_color",
            "label": "Secondary button background color",
            "default": "#000000",
            "visible_if": "{{ section.settings.section_styling == true }}"
        },
        {
            "type": "color",
            "id": "secondary_button_text_color",
            "label": "Secondary button text color",
            "default": "#FFFFFF",
            "visible_if": "{{ section.settings.section_styling == true }}"
        },
        {
            "type": "header",
            "content": "Section Colors",
            "visible_if": "{{ section.settings.section_styling == true }}"
        },
        {
            "type": "header",
            "content": "Products"
        },
        {
            "type": "collection",
            "id": "collection",
            "label": "Collection to display",
            "info": "If a collection is selected, the products will be fetched from the collection. If no collection is selected, the products will be fetched from the product list."
        },
        {
            "type": "product_list",
            "id": "product_list",
            "label": "Products to display",
            "limit": 12
        },
        {
            "type": "header",
            "content": "Section Content"
        },
        {
            "type": "text",
            "id": "text",
            "label": "Subtitle",
            "default": "Subtitle"
        },
        {
            "type": "richtext",
            "id": "title",
            "label": "Title",
            "default": "<h2>This month's bestsellers</h2>"
        },
        {
            "type": "header",
            "content": "Button"
        },
        {
            "type": "text",
            "id": "button_text",
            "label": "Button text",
            "default": "VIEW ALL"
        },
        {
            "type": "url",
            "id": "button_url",
            "label": "Button url"
        },
        {
            "type": "select",
            "id": "button_style",
            "label": "Button style",
            "options": [
                {
                    "value": "primary",
                    "label": "Primary"
                },
                {
                    "value": "secondary",
                    "label": "Secondary"
                },
                {
                    "value": "ghost",
                    "label": "Ghost"
                }
            ],
            "default": "primary"
        },
        {
            "type": "header",
            "content": "Animation"
        },
        {
            "type": "select",
            "id": "animation_type",
            "label": "Animation",
            "options": [
                { "value": "none", "label": "None" },
                { "value": "fade-in", "label": "Fade in" },
                { "value": "fade-up", "label": "Fade up" },
                { "value": "fade-down", "label": "Fade down" },
                { "value": "fade-left", "label": "Fade in from left" },
                { "value": "fade-right", "label": "Fade in from right" },
                { "value": "zoom-in", "label": "Zoom in" },
                { "value": "zoom-out", "label": "Zoom out" },
                { "value": "stagger", "label": "Stagger" }
            ],
            "default": "fade-up"
        },
        {
            "type": "range",
            "id": "animation_duration",
            "label": "Duration",
            "min": 0.2,
            "max": 2,
            "step": 0.1,
            "unit": "s",
            "default": 0.8
        }
    ],
    "blocks": [],
    "presets": [
        {
            "name": "Product Slider"
        }
    ]
}
{% endschema %}
