{%- liquid
    assign s = section.settings
    assign section_classes = 'color-' | append: s.color_scheme | append: ' bg-background w-full'
-%}

<div
    class="{{- section_classes }} {{ s.mobile_padding }} {{ s.desktop_padding }}"
></div>

{% schema %}
{
    "name": "Spacer",
    "class": "section_spacer",
    "tag": "section",
    "settings": [
        {
            "type": "header",
            "content": "Appearance"
        },
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "Color scheme",
            "default": "color-scheme-1"
        },
        {
            "type": "header",
            "content": "Spacing"
        },
        {
            "type": "select",
            "id": "mobile_padding",
            "label": "Mobile padding",
            "options": [
                {
                    "value": "py-mobile-padding-xs",
                    "label": "Extra Small"
                },
                {
                    "value": "py-mobile-padding-s",
                    "label": "Small"
                },
                {
                    "value": "py-mobile-padding-m",
                    "label": "Medium"
                },
                {
                    "value": "py-mobile-padding-l",
                    "label": "Large"
                }
            ],
            "default": "py-mobile-padding-xs"
        },
        {
            "type": "select",
            "id": "desktop_padding",
            "label": "Desktop padding",
            "options": [
                {
                    "value": "lg:py-desktop-padding-xs",
                    "label": "Extra Small"
                },
                {
                    "value": "lg:py-desktop-padding-s",
                    "label": "Small"
                },
                {
                    "value": "lg:py-desktop-padding-m",
                    "label": "Medium"
                },
                {
                    "value": "lg:py-desktop-padding-l",
                    "label": "Large"
                }
            ],
            "default": "lg:py-desktop-padding-s"
        }
    ],
    "presets": [
        {
            "category": "Spacer",
            "name": "Spacer"
        }
    ]
}
{% endschema %}
