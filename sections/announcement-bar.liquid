{%- liquid
    assign s = section.settings
    assign section_id = 'section-' | append: section.id
-%}
{%- if section.blocks.size > 0 -%}
    <div
        id="{{ section_id }}"
        class="{{ s.desktop_padding }} {{ s.mobile_padding }} bg-background"
        data-announcement-bar
    >
        {% render 'section-colors', current_section: section %}
        <splide-section
            data-splide-type="slide"
            data-splide-per-page-desktop="1"
            data-splide-per-page-mobile="1"
            data-splide-autoplay="true"
            data-splide-interval="5000"
            class="container flex justify-between items-center"
        >
            <section class="splide w-full">
                <div class="h-full overflow-hidden splide__track w-full">
                    <ul class="flex h-full splide__list w-full">
                        {%- for block in section.blocks -%}
                            {% assign b = block.settings %}
                            <li
                                class="splide__slide flex h-full items-center justify-center text-primary"
                                {{ block.shopify_attributes }}
                            >
                                {%- if b.link != blank -%}
                                    <a href="{{ b.link }}">{{ b.text }}</a>
                                {%- else -%}
                                    <span>{{ b.text }}</span>
                                {%- endif -%}
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            </section>
        </splide-section>
    </div>
{%- endif -%}
{% schema %}
{
    "name": "Announcement Bar",
    "class": "announcement-bar w-full",
    "enabled_on": {
        "groups": [
            "header"
        ]
    },
    "limit": 1,
    "settings": [
        {
            "type": "header",
            "content": "Section Styling"
        },
        {
            "type": "checkbox",
            "id": "section_styling",
            "label": "Add styling to section",
            "info": "If enabled this shows the settings to set the color scheme, spacing, and margin for the section.",
            "default": false
        },
        {
            "type": "header",
            "content": "Section Color Scheme",
            "visible_if": "{{ section.settings.section_styling == true }}"
        },
        {
            "type": "header",
            "content": "Section Spacing",
            "visible_if": "{{ section.settings.section_styling == true }}"
        },
        {
            "type": "select",
            "id": "mobile_padding",
            "label": "Mobile padding",
            "visible_if": "{{ section.settings.section_styling == true }}",
            "options": [
                {
                    "value": "py-0",
                    "label": "None"
                },
                {
                    "value": "py-2",
                    "label": "Small - 8px"
                },
                {
                    "value": "py-4",
                    "label": "Medium - 16px"
                },
                {
                    "value": "py-6",
                    "label": "Large - 24px"
                }
            ],
            "default": "py-0"
        },
        {
            "type": "select",
            "id": "desktop_padding",
            "label": "Desktop padding",
            "visible_if": "{{ section.settings.section_styling == true }}",
            "options": [
                {
                    "value": "lg:py-0",
                    "label": "None"
                },
                {
                    "value": "lg:py-4",
                    "label": "Small - 16px"
                },
                {
                    "value": "lg:py-6",
                    "label": "Medium - 24px"
                },
                {
                    "value": "lg:py-8",
                    "label": "Large - 32px"
                }
            ],
            "default": "lg:py-4"
        },
        {
            "type": "header",
            "content": "Section Margin",
            "visible_if": "{{ section.settings.section_styling == true }}"
        },
        {
            "type": "select",
            "id": "mobile_margin",
            "label": "Mobile Section margin",
            "visible_if": "{{ section.settings.section_styling == true }}",
            "options": [
                {
                    "value": "mb-0",
                    "label": "None"
                },
                {
                    "value": "mb-4",
                    "label": "Small - 16px"
                },
                {
                    "value": "mb-8",
                    "label": "Medium - 32px"
                },
                {
                    "value": "mb-12",
                    "label": "Large - 48px"
                }
            ],
            "default": "mb-0"
        },
        {
            "type": "select",
            "id": "desktop_margin",
            "label": "Desktop Section margin",
            "visible_if": "{{ section.settings.section_styling == true }}",
            "options": [
                {
                    "value": "lg:mb-0",
                    "label": "None"
                },
                {
                    "value": "lg:mb-8",
                    "label": "Small - 32px"
                },
                {
                    "value": "lg:mb-12",
                    "label": "Medium - 48px"
                },
                {
                    "value": "lg:mb-16",
                    "label": "Large - 64px"
                }
            ],
            "default": "lg:mb-0"
        },
        {
            "type": "header",
            "content": "Colors",
            "visible_if": "{{ section.settings.section_styling == true }}"
        },
        {
            "type": "color",
            "id": "background",
            "label": "Section background color",
            "default": "#FFFFFF",
            "visible_if": "{{ section.settings.section_styling == true }}"
        },
        {
            "type": "color",
            "id": "primary_text_color",
            "label": "Primary text color",
            "default": "#000000",
            "visible_if": "{{ section.settings.section_styling == true }}"
        },
        {
            "type": "color",
            "id": "secondary_text_color",
            "label": "Secondary text color",
            "default": "#000000",
            "visible_if": "{{ section.settings.section_styling == true }}"
        },
        {
            "type": "color",
            "id": "primary_button_color",
            "label": "Primary button background color",
            "default": "#FFFFFF",
            "visible_if": "{{ section.settings.section_styling == true }}"
        },
        {
            "type": "color",
            "id": "primary_button_text_color",
            "label": "Primary button text color",
            "default": "#000000",
            "visible_if": "{{ section.settings.section_styling == true }}"
        },
        {
            "type": "color",
            "id": "secondary_button_color",
            "label": "Secondary button background color",
            "default": "#000000",
            "visible_if": "{{ section.settings.section_styling == true }}"
        },
        {
            "type": "color",
            "id": "secondary_button_text_color",
            "label": "Secondary button text color",
            "default": "#FFFFFF",
            "visible_if": "{{ section.settings.section_styling == true }}"
        }
    ],
    "blocks": [
        {
            "type": "announcement",
            "name": "Announcement",
            "settings": [
                {
                    "type": "header",
                    "content": "Content"
                },
                {
                    "type": "text",
                    "id": "text",
                    "label": "Text"
                },
                {
                    "type": "url",
                    "id": "link",
                    "label": "Link url"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "Announcement bar",
            "blocks": [
                {
                    "type": "announcement",
                    "settings": {
                        "text": "Announcement 1",
                        "link": "#"
                    }
                },
                {
                    "type": "announcement",
                    "settings": {
                        "text": "Announcement 2",
                        "link": "#"
                    }
                },
                {
                    "type": "announcement",
                    "settings": {
                        "text": "Announcement 3",
                        "link": "#"
                    }
                }
            ]
        }
    ]
}
{% endschema %}
