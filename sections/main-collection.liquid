{%- liquid
    assign s = section.settings
-%}

{% render 'component.animation-open', section: section %}

<div class="mt-12 mb-10">
    {%- render 'products-listing-grid',
        products_per_page: s.products_per_page,
        collection_description: s.collection_description
    -%}
</div>

{% render 'component.animation-close', section: section %}

{% schema %}
{
    "name": "Main Collection",
    "settings": [
        {
            "type": "number",
            "id": "products_per_page",
            "label": "Products per page limit",
            "default": 15
        },
        {
            "type": "richtext",
            "id": "collection_description",
            "label": "Collection description",
            "info": "Manually add the collection description or select the collection description using dynamic source"
        },
        {
            "type": "header",
            "content": "Animation"
        },
        {
            "type": "select",
            "id": "animation_type",
            "label": "Animation",
            "options": [
                {
                    "value": "none",
                    "label": "None"
                },
                {
                    "value": "fade-in",
                    "label": "Fade in"
                },
                {
                    "value": "fade-up",
                    "label": "Fade up"
                },
                {
                    "value": "fade-down",
                    "label": "Fade down"
                },
                {
                    "value": "fade-left",
                    "label": "Fade in from left"
                },
                {
                    "value": "fade-right",
                    "label": "Fade in from right"
                },
                {
                    "value": "zoom-in",
                    "label": "Zoom in"
                },
                {
                    "value": "zoom-out",
                    "label": "Zoom out"
                },
                {
                    "value": "stagger",
                    "label": "Stagger"
                }
            ],
            "default": "fade-up"
        },
        {
            "type": "range",
            "id": "animation_duration",
            "label": "Duration",
            "min": 0.2,
            "max": 2,
            "step": 0.1,
            "unit": "s",
            "default": 0.8
        }
    
    ],
    "blocks": []
}
{% endschema %}
