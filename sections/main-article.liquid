{% render 'component.animation-open', section: section %}

<div class="p-6 lg:p-8">
  <h1 class="mb-4 text-xl">{{ article.title }}</h1>
  <div>{{ article.content }}</div>
</div>

{% render 'component.animation-close', section: section %}

{% if template == 'article' %}
    {% render 'schema.article' %}
{% endif %}

{% schema %}
{
    "name": "Main Article",
    "settings": [
        {
            "type": "header",
            "content": "Animation"
        },
        {
            "type": "select",
            "id": "animation_type",
            "label": "Animation",
            "options": [
                {
                    "value": "none",
                    "label": "None"
                },
                {
                    "value": "fade-in",
                    "label": "Fade in"
                },
                {
                    "value": "fade-up",
                    "label": "Fade up"
                },
                {
                    "value": "fade-down",
                    "label": "Fade down"
                },
                {
                    "value": "fade-left",
                    "label": "Fade in from left"
                },
                {
                    "value": "fade-right",
                    "label": "Fade in from right"
                },
                {
                    "value": "zoom-in",
                    "label": "Zoom in"
                },
                {
                    "value": "zoom-out",
                    "label": "Zoom out"
                },
                {
                    "value": "stagger",
                    "label": "Stagger"
                }
            ],
            "default": "fade-up"
        },
        {
            "type": "range",
            "id": "animation_duration",
            "label": "Duration",
            "min": 0.2,
            "max": 2,
            "step": 0.1,
            "unit": "s",
            "default": 0.8
        }
    ],
    "blocks": []
}

{% endschema %}
