{% liquid
    assign search_term = search.terms | escape
    assign search_label = 'general.search_page.submit_search' | t
    assign search_placeholder = 'general.search_page.placeholder_text' | t
%}

{% render 'component.animation-open', section: section %}

{% capture search_attributes %}
    aria-label="{{ search_label }}"
    required
{% endcapture %}

<div class="mt-12 mb-10">
    <h1 class="mb-4 text-xl lg:text-4xl text-center">
        {{ 'general.search_page.search' | t }}
    </h1>
    <section class="p-6 container-small lg:p-8">
        <form
            class="main-search-form mb-12 relative z-[5]"
            action="{{ routes.search_url }}"
            role="search"
        >
            <fieldset class="flex flex-col lg:flex-row gap-1">
                {% render 'component.input',
                    id: 'search',
                    default_value: search_term,
                    placeholder: search_placeholder,
                    name: 'q',
                    attributes: search_attributes,
                    class: 'w-full appearance-none text-primary  placeholder:text-secondary disabled:cursor-not-allowed disabled:bg-background disabled:text-primary disabled:placeholder:text-secondary'
                %}
                <input
                    type="hidden"
                    name="sort_by"
                    value="price-ascending"
                >
                {% render 'component.button',
                    variant: 'primary',
                    type: 'submit',
                    label: search_label,
                    class: 'text-center w-full lg:w-fit'
                %}
            </fieldset>
        </form>
    </section>
    {%- render 'products-listing-grid', products_per_page: 12 -%}
</div>

{% render 'component.animation-close', section: section %}

{% schema %}
{
    "name": "Main Search",
    "settings": [
        {
            "type": "header",
            "content": "Animation"
        },
        {
            "type": "select",
            "id": "animation_type",
            "label": "Animation",
            "options": [
                {
                    "value": "none",
                    "label": "None"
                },
                {
                    "value": "fade-in",
                    "label": "Fade in"
                },
                {
                    "value": "fade-up",
                    "label": "Fade up"
                },
                {
                    "value": "fade-down",
                    "label": "Fade down"
                },
                {
                    "value": "fade-left",
                    "label": "Fade in from left"
                },
                {
                    "value": "fade-right",
                    "label": "Fade in from right"
                },
                {
                    "value": "zoom-in",
                    "label": "Zoom in"
                },
                {
                    "value": "zoom-out",
                    "label": "Zoom out"
                },
                {
                    "value": "stagger",
                    "label": "Stagger"
                }
            ],
            "default": "fade-up"
        },
        {
            "type": "range",
            "id": "animation_duration",
            "label": "Duration",
            "min": 0.2,
            "max": 2,
            "step": 0.1,
            "unit": "s",
            "default": 0.8
        }
    ],
    "blocks": []
}
{% endschema %}
