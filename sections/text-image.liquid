{% liquid
    assign s = section.settings
    assign section_id = 'section-' | append: section.id
%}

{% render 'component.animation-open', section: section %}

<div
    id="{{ section_id }}"
    class="{{ s.mobile_margin }} {{ s.desktop_margin }} bg-background"
>
    {% render 'section-colors', current_section: section %}
    <div class="container {{ s.desktop_padding }} {{ s.mobile_padding }}">
        <div class="flex flex-col {% if s.image_position == 'right' %}lg:flex-row{% else %}lg:flex-row-reverse{% endif %} gap-8 lg:gap-12 items-stretch">
            <div class="lg:w-1/2 flex flex-col justify-center {% if s.text_alignment == 'center' %}text-center items-center{% elsif s.text_alignment == 'right' %}text-right items-end{% else %}text-left items-start{% endif %}">
                {% if s.subheading != blank %}
                    <p class="uppercase text-sm tracking-wider mb-2 text-secondary">
                        {{ s.subheading }}
                    </p>
                {% endif %}

                {% if s.heading != blank %}
                    {% render 'component.heading',
                        tag: 'h2',
                        variant: s.heading_size,
                        content: s.heading,
                        class: 'mb-4 text-primary'
                    %}
                {% endif %}

                {% if s.text != blank %}
                    <div class="last:mb-6 space-y-4 [&_ol]:list-decimal [&_ol]:pl-5 [&_ul]:list-disc [&_ul]:pl-5 text-primary">
                        {{ s.text }}
                    </div>
                {% endif %}

                {% if s.button_text != blank and s.button_url != blank %}
                    {% render 'component.button',
                        label: s.button_text,
                        title: s.button_text,
                        href: s.button_url,
                        class: 'mt-4',
                        aria_label: s.button_text,
                        variant: s.button_style
                    %}
                {% endif %}
            </div>

            <div class="lg:w-1/2 flex">
                <responsive-media class="w-full h-full aspect-4/3 flex-1">
                    {% if s.image != blank %}
                        {{-
                            s.image
                            | image_url: width: 1200
                            | image_tag:
                                class: 'w-full h-full object-cover transition-transform duration-500 ease-in-out hover:scale-105',
                                loading: 'lazy'
                        -}}
                    {% endif %}
                    {% if s.enable_overlay %}
                        {% if s.overlay_type == 'color' %}
                            <div class="absolute inset-0 bg-black" style="opacity: {{ s.overlay_opacity | divided_by: 100.0 }};"></div>
                        {% elsif s.mobile_gradient != blank
                            and s.desktop_gradient != blank
                        %}
                            {% render 'component.gradient',
                                mobile_bg: s.mobile_gradient,
                                desktop_bg: s.desktop_gradient,
                                mobile_visible: true,
                                desktop_visible: true
                            %}
                        {% endif %}
                    {% endif %}
                </responsive-media>
            </div>
        </div>
    </div>
</div>

{% render 'component.animation-close', section: section %}

{% schema %}
{
    "name": "Text with Image",
    "tag": "section",
    "class": "section",
    "disabled_on": {
        "groups": [
            "header",
            "footer"
        ]
    },
    "settings": [
        {
            "type": "header",
            "content": "Section Styling"
        },
        {
            "type": "checkbox",
            "id": "section_styling",
            "label": "Add styling to section",
            "info": "If enabled this shows the settings to set the color scheme, spacing, and margin for the section.",
            "default": false
        },
        {
            "type": "header",
            "content": "Section Color Scheme",
            "visible_if": "{{ section.settings.section_styling == true }}"
        },
        {
            "type": "header",
            "content": "Section Spacing",
            "visible_if": "{{ section.settings.section_styling == true }}"
        },
        {
            "type": "select",
            "id": "mobile_padding",
            "label": "Mobile padding",
            "visible_if": "{{ section.settings.section_styling == true }}",
            "options": [
                {
                    "value": "py-0",
                    "label": "None"
                },
                {
                    "value": "py-2",
                    "label": "Small - 8px"
                },
                {
                    "value": "py-4",
                    "label": "Medium - 16px"
                },
                {
                    "value": "py-6",
                    "label": "Large - 24px"
                }
            ],
            "default": "py-0"
        },
        {
            "type": "select",
            "id": "desktop_padding",
            "label": "Desktop padding",
            "visible_if": "{{ section.settings.section_styling == true }}",
            "options": [
                {
                    "value": "lg:py-0",
                    "label": "None"
                },
                {
                    "value": "lg:py-4",
                    "label": "Small - 16px"
                },
                {
                    "value": "lg:py-6",
                    "label": "Medium - 24px"
                },
                {
                    "value": "lg:py-8",
                    "label": "Large - 32px"
                }
            ],
            "default": "lg:py-4"
        },
        {
            "type": "header",
            "content": "Section Margin",
            "visible_if": "{{ section.settings.section_styling == true }}"
        },
        {
            "type": "select",
            "id": "mobile_margin",
            "label": "Mobile Section margin",
            "visible_if": "{{ section.settings.section_styling == true }}",
            "options": [
                {
                    "value": "mb-0",
                    "label": "None"
                },
                {
                    "value": "mb-4",
                    "label": "Small - 16px"
                },
                {
                    "value": "mb-8",
                    "label": "Medium - 32px"
                },
                {
                    "value": "mb-12",
                    "label": "Large - 48px"
                }
            ],
            "default": "mb-0"
        },
        {
            "type": "select",
            "id": "desktop_margin",
            "label": "Desktop Section margin",
            "visible_if": "{{ section.settings.section_styling == true }}",
            "options": [
                {
                    "value": "lg:mb-0",
                    "label": "None"
                },
                {
                    "value": "lg:mb-8",
                    "label": "Small - 32px"
                },
                {
                    "value": "lg:mb-12",
                    "label": "Medium - 48px"
                },
                {
                    "value": "lg:mb-16",
                    "label": "Large - 64px"
                }
            ],
            "default": "lg:mb-0"
        },
        {
            "type": "header",
            "content": "Colors",
            "visible_if": "{{ section.settings.section_styling == true }}"
        },
        {
            "type": "color",
            "id": "background",
            "label": "Section background color",
            "default": "#FFFFFF",
            "visible_if": "{{ section.settings.section_styling == true }}"
        },
        {
            "type": "color",
            "id": "primary_text_color",
            "label": "Primary text color",
            "default": "#000000",
            "visible_if": "{{ section.settings.section_styling == true }}"
        },
        {
            "type": "color",
            "id": "secondary_text_color",
            "label": "Secondary text color",
            "default": "#000000",
            "visible_if": "{{ section.settings.section_styling == true }}"
        },
        {
            "type": "color",
            "id": "primary_button_color",
            "label": "Primary button background color",
            "default": "#FFFFFF",
            "visible_if": "{{ section.settings.section_styling == true }}"
        },
        {
            "type": "color",
            "id": "primary_button_text_color",
            "label": "Primary button text color",
            "default": "#000000",
            "visible_if": "{{ section.settings.section_styling == true }}"
        },
        {
            "type": "color",
            "id": "secondary_button_color",
            "label": "Secondary button background color",
            "default": "#000000",
            "visible_if": "{{ section.settings.section_styling == true }}"
        },
        {
            "type": "color",
            "id": "secondary_button_text_color",
            "label": "Secondary button text color",
            "default": "#FFFFFF",
            "visible_if": "{{ section.settings.section_styling == true }}"
        },
        {
            "type": "header",
            "content": "Image"
        },
        {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
        },
        {
            "type": "checkbox",
            "id": "enable_overlay",
            "default": false,
            "label": "Enable overlay"
        },
        {
            "type": "select",
            "id": "overlay_type",
            "label": "Overlay type",
            "options": [
                {
                    "value": "gradient",
                    "label": "Gradient"
                },
                {
                    "value": "color",
                    "label": "Color overlay"
                }
            ],
            "default": "gradient",
            "visible_if": "{{ section.settings.enable_overlay == true }}"
        },
        {
            "type": "color_background",
            "id": "mobile_gradient",
            "label": "Gradient [Mobile]",
            "info": "Click on color-picker to adjust gradient colors, direction and opacity",
            "default": "linear-gradient(transparent, #000000)",
            "visible_if": "{{ section.settings.enable_overlay == true and section.settings.overlay_type == 'gradient' }}"
        },
        {
            "type": "color_background",
            "id": "desktop_gradient",
            "label": "Gradient [Desktop]",
            "info": "Click on color-picker to adjust gradient colors, direction and opacity",
            "default": "linear-gradient(transparent, #000000)",
            "visible_if": "{{ section.settings.enable_overlay == true and section.settings.overlay_type == 'gradient' }}"
        },
        {
            "type": "range",
            "id": "overlay_opacity",
            "label": "Overlay opacity",
            "min": 0,
            "max": 100,
            "step": 5,
            "unit": "%",
            "default": 30,
            "visible_if": "{{ section.settings.enable_overlay == true and section.settings.overlay_type == 'color' }}"
        },
        {
            "type": "select",
            "id": "image_position",
            "options": [
                {
                    "value": "left",
                    "label": "Left"
                },
                {
                    "value": "right",
                    "label": "Right"
                }
            ],
            "default": "right",
            "label": "Image position"
        },
        {
            "type": "header",
            "content": "Text Content"
        },
        {
            "type": "select",
            "id": "text_alignment",
            "label": "Text alignment",
            "options": [
                {
                    "value": "left",
                    "label": "Left"
                },
                {
                    "value": "center",
                    "label": "Center"
                },
                {
                    "value": "right",
                    "label": "Right"
                }
            ],
            "default": "left"
        },
        {
            "type": "inline_richtext",
            "id": "heading",
            "label": "heading",
            "default": "Feature highlight with image"
        },
        {
            "type": "select",
            "id": "heading_size",
            "options": [
                {
                    "value": "2xl",
                    "label": "2XL"
                },
                {
                    "value": "xl",
                    "label": "XL"
                },
                {
                    "value": "lg",
                    "label": "LG"
                },
                {
                    "value": "md",
                    "label": "MD"
                },
                {
                    "value": "sm",
                    "label": "SM"
                }
            ],
            "default": "lg",
            "label": "Heading size"
        },
        {
            "type": "inline_richtext",
            "id": "subheading",
            "label": "Subheading"
        },
        {
            "type": "richtext",
            "id": "text",
            "label": "Text content",
            "default": "<p>Combine text and image to showcase your product features, tell your brand story, or explain your value proposition. This versatile section can be customized to match your brand's design.</p>"
        },
        {
            "type": "header",
            "content": "Button"
        },
        {
            "type": "text",
            "id": "button_text",
            "label": "Button text"
        },
        {
            "type": "url",
            "id": "button_url",
            "label": "Button URL"
        },
        {
            "type": "select",
            "id": "button_style",
            "label": "Button style",
            "options": [
                {
                    "value": "primary",
                    "label": "Primary"
                },
                {
                    "value": "secondary",
                    "label": "Secondary"
                },
                {
                    "value": "ghost",
                    "label": "Ghost"
                }
            ],
            "default": "primary"
        },
        {
            "type": "header",
            "content": "Animation"
        },
        {
            "type": "select",
            "id": "animation_type",
            "label": "Animation",
            "options": [
                { "value": "none", "label": "None" },
                { "value": "fade-in", "label": "Fade in" },
                { "value": "fade-up", "label": "Fade up" },
                { "value": "fade-down", "label": "Fade down" },
                { "value": "fade-left", "label": "Fade in from left" },
                { "value": "fade-right", "label": "Fade in from right" },
                { "value": "zoom-in", "label": "Zoom in" },
                { "value": "zoom-out", "label": "Zoom out" },
                { "value": "stagger", "label": "Stagger" }
            ],
            "default": "fade-up"
        },
        {
            "type": "range",
            "id": "animation_duration",
            "label": "Duration",
            "min": 0.2,
            "max": 2,
            "step": 0.1,
            "unit": "s",
            "default": 0.8
        }
    ],
    "presets": [
        {
            "name": "Text with Image",
            "settings": {
                "heading": "Feature highlight with image",
                "image": "shopify://shop_images/theme_cover_image.jpg",
                "image_position": "right",
                "text_alignment": "left",
                "heading_size": "lg",
                "button_text": "Button text",
                "button_url": "#"
            }
        }
    ]
}
{% endschema %}
