{% liquid
    assign s = section.settings
    assign menu = linklists[s.main_menu].links
    assign header_predictive_search_id = 'header-predictive-search'
    assign header_cart_drawer_id = 'cart-drawer'
    assign mobile_logo = settings.mobile_logo
    assign desktop_logo = settings.desktop_logo | default: mobile_logo
    assign transparent_mobile_logo = s.transparent_mobile_logo
    assign transparent_desktop_logo = s.transparent_desktop_logo | default: transparent_mobile_logo

    assign is_homepage = false
    if template.name == 'index'
        assign is_homepage = true
    endif

    assign is_transparent_mode = false
    if s.transparent_on_homepage and is_homepage
        assign is_transparent_mode = true
    endif

    assign effective_background_color = s.background_color
    assign effective_text_color = s.text_color
    if s.transparent_on_homepage and is_homepage == false
        assign effective_background_color = s.scrolled_background_color
        assign effective_text_color = s.scrolled_text_color
    endif

    assign initial_bg = effective_background_color
    if is_transparent_mode
        assign initial_bg = 'transparent'
    endif

    assign mobile_menu_background_color = s.background_color
    assign mobile_menu_text_color = s.text_color
    if s.transparent_on_homepage
        assign mobile_menu_background_color = s.scrolled_background_color
        assign mobile_menu_text_color = s.scrolled_text_color
    endif
%}

{%- capture header_inline_style -%}
    --header-bg: {{ initial_bg }};
    --header-text: {{ effective_text_color }};
    --header-bg-scrolled: {{ s.scrolled_background_color }};
    --header-text-scrolled: {{ s.scrolled_text_color }};
{%- endcapture -%}

<header-nav
    id="main-header-nav"
    role="navigation"
    aria-label="{{- 'accessibility.header_main_navigation' | t -}}"
    data-make-header-disappear-on-scroll="{{ s.make_header_disappear_on_scroll }}"
    {% if is_transparent_mode %}data-transparent-mode{% endif %}
    style="{{ header_inline_style | strip_newlines | replace: '    ', '' }}"
    class="block"
>
    {%- render 'header-mobile',
        header_predictive_search_id: header_predictive_search_id,
        header_cart_drawer_id: header_cart_drawer_id,
        menu: menu,
        mobile_logo: mobile_logo,
        transparent_mobile_logo: transparent_mobile_logo,
        is_transparent_mode: is_transparent_mode,
        fancy_hamburger: s.fancy_hamburger,
        header_background_color: mobile_menu_background_color,
        header_text_color: mobile_menu_text_color
    -%}
    {%- render 'header-desktop',
        header_predictive_search_id: header_predictive_search_id,
        header_cart_drawer_id: header_cart_drawer_id,
        menu: menu,
        desktop_logo: desktop_logo,
        transparent_desktop_logo: transparent_desktop_logo,
        is_transparent_mode: is_transparent_mode
    -%}
    {% render 'predictive-search',
        search_placeholder: s.search_placeholder,
        search_initial_text: s.search_initial_text,
        search_no_results_text: s.search_no_results_text,
        search_show_collections: s.search_show_collections,
        search_show_pages: s.search_show_pages,
        search_show_articles: s.search_show_articles,
        search_background_color: s.search_background_color,
        search_text_color: s.search_text_color
    %}
</header-nav>

{% schema %}
{
    "name": "Header",
    "tag": "header",
    "class": "section--header",
    "limit": 1,
    "settings": [
        {
            "type": "header",
            "content": "Logo",
            "info": "Logo can be set in the theme settings!"
        },
        {
            "type": "header",
            "content": "Documentation in Header",
            "info": "[Header](https://www.strix.net/en)"
        },
        {
            "type": "header",
            "content": "Menu"
        },
        {
            "type": "link_list",
            "id": "main_menu",
            "label": "Main Menu",
            "default": "main-menu"
        },
        {
            "type": "checkbox",
            "id": "make_header_disappear_on_scroll",
            "label": "Make header disappear on scroll",
            "default": false
        },
        {
            "type": "header",
            "content": "Colors"
        },
        {
            "type": "color",
            "id": "background_color",
            "label": "Background color",
            "default": "#ffffff"
        },
        {
            "type": "color",
            "id": "text_color",
            "label": "Text color",
            "default": "#000000"
        },
        {
            "type": "checkbox",
            "id": "transparent_on_homepage",
            "label": "Transparent header on homepage",
            "info": "Makes the header transparent on the homepage so the hero shows behind it. Only applied on the homepage.",
            "default": false
        },
        {
            "type": "color",
            "id": "scrolled_background_color",
            "label": "Background color when not transparent",
            "info": "Used after the user scrolls on the homepage and as the background on all other pages when transparent header is enabled.",
            "default": "#ffffff",
            "visible_if": "{{ section.settings.transparent_on_homepage }}"
        },
        {
            "type": "color",
            "id": "scrolled_text_color",
            "label": "Text color when not transparent",
            "info": "Used after the user scrolls on the homepage and as the text color on all other pages when transparent header is enabled.",
            "default": "#000000",
            "visible_if": "{{ section.settings.transparent_on_homepage }}"
        },
        {
            "type": "image_picker",
            "id": "transparent_mobile_logo",
            "label": "Transparent state mobile logo",
            "info": "Optional. Used while the header is transparent on the homepage. Falls back to the regular mobile logo from theme settings.",
            "visible_if": "{{ section.settings.transparent_on_homepage }}"
        },
        {
            "type": "image_picker",
            "id": "transparent_desktop_logo",
            "label": "Transparent state desktop logo",
            "info": "Optional. Used while the header is transparent on the homepage. Falls back to the transparent mobile logo, then the regular desktop logo.",
            "visible_if": "{{ section.settings.transparent_on_homepage }}"
        },
        {
            "type": "header",
            "content": "Predictive search"
        },
        {
            "type": "color",
            "id": "search_background_color",
            "label": "Predictive search background color",
            "default": "#ffffff"
        },
        {
            "type": "color",
            "id": "search_text_color",
            "label": "Predictive search text color",
            "default": "#000000"
        },
        {
            "type": "text",
            "id": "search_placeholder",
            "label": "Predictive search placeholder text",
            "default": "Search products, collections, etc."
        },
        {
            "type": "text",
            "id": "search_initial_text",
            "label": "Initial predictive search text",
            "info": "Shown before the user starts typing.",
            "default": "Start typing to search"
        },
        {
            "type": "text",
            "id": "search_no_results_text",
            "label": "Predictive search no results text",
            "info": "Use *search_term to display what the customer searched for.",
            "default": "No results found for \"*search_term\". Please try a different search."
        },
        {
            "type": "checkbox",
            "id": "search_show_collections",
            "label": "Show collections in predictive search",
            "default": true
        },
        {
            "type": "checkbox",
            "id": "search_show_pages",
            "label": "Show pages in predictive search",
            "default": false
        },
        {
            "type": "checkbox",
            "id": "search_show_articles",
            "label": "Show articles in predictive search",
            "default": false
        }
    ],
    "blocks": [
        {
            "type": "@app"
        }
    ],
    "enabled_on": {
        "groups": [
            "header"
        ]
    },
    "presets": [
        {
            "name": "Header"
        }
    ]
}
{% endschema %}
