{% liquid
    assign s = section.settings
    assign section_id = 'section-' | append: section.id
    assign articles_per_page = s.desktop_pagination_limit | default: 12
%}

{% render 'component.animation-open', section: section %}

<div
    id="{{ section_id }}"
    class="{{ s.mobile_margin }} {{ s.desktop_margin }} bg-background"
>
    {% render 'section-colors', current_section: section %}
    <div class="container {{ s.mobile_padding }} {{ s.desktop_padding }} text-primary">
        {%- comment -%}
            One grid for all viewports. Two paginate tags with different
            limits put every article into the DOM twice, with two pagination
            states that disagree on what page 2 is.
        {%- endcomment -%}
        {%- paginate blog.articles by articles_per_page -%}
            <section class="gap-y-8 mb-11 grid md:grid-cols-2 lg:grid-cols-3 md:gap-x-3 md:gap-y-6">
                {%- for article in blog.articles -%}
                    {% render 'component.article-card', article: article %}
                {%- else -%}
                    <p class="col-span-full py-10 mx-auto font-bold text-center">
                        {{ 'blogs.no_results' | t }}
                    </p>
                {%- endfor -%}
            </section>
            <footer class="mx-auto w-fit">
                {%- render 'component.pagination',
                    paginate: paginate,
                    anchor: ''
                -%}
            </footer>
        {%- endpaginate -%}
    </div>
</div>

{% render 'component.animation-close', section: section %}

{% schema %}
{
    "name": "Blog",
    "settings": [
        {
            "type": "header",
            "content": "Section Styling"
        },
        {
            "type": "checkbox",
            "id": "section_styling",
            "label": "Add styling to section",
            "info": "If enabled this shows the settings to set the color scheme, spacing, and margin for the section.",
            "default": false
        },
        {
            "type": "header",
            "content": "Section Color Scheme",
            "visible_if": "{{ section.settings.section_styling == true }}"
        },
        {
            "type": "header",
            "content": "Section Spacing",
            "visible_if": "{{ section.settings.section_styling == true }}"
        },
        {
            "type": "select",
            "id": "mobile_padding",
            "label": "Mobile padding",
            "visible_if": "{{ section.settings.section_styling == true }}",
            "options": [
                {
                    "value": "py-0",
                    "label": "None"
                },
                {
                    "value": "py-2",
                    "label": "Small - 8px"
                },
                {
                    "value": "py-4",
                    "label": "Medium - 16px"
                },
                {
                    "value": "py-6",
                    "label": "Large - 24px"
                }
            ],
            "default": "py-0"
        },
        {
            "type": "select",
            "id": "desktop_padding",
            "label": "Desktop padding",
            "visible_if": "{{ section.settings.section_styling == true }}",
            "options": [
                {
                    "value": "lg:py-0",
                    "label": "None"
                },
                {
                    "value": "lg:py-4",
                    "label": "Small - 16px"
                },
                {
                    "value": "lg:py-6",
                    "label": "Medium - 24px"
                },
                {
                    "value": "lg:py-8",
                    "label": "Large - 32px"
                }
            ],
            "default": "lg:py-4"
        },
        {
            "type": "header",
            "content": "Section Margin",
            "visible_if": "{{ section.settings.section_styling == true }}"
        },
        {
            "type": "select",
            "id": "mobile_margin",
            "label": "Mobile Section margin",
            "visible_if": "{{ section.settings.section_styling == true }}",
            "options": [
                {
                    "value": "mb-0",
                    "label": "None"
                },
                {
                    "value": "mb-4",
                    "label": "Small - 16px"
                },
                {
                    "value": "mb-8",
                    "label": "Medium - 32px"
                },
                {
                    "value": "mb-12",
                    "label": "Large - 48px"
                }
            ],
            "default": "mb-0"
        },
        {
            "type": "select",
            "id": "desktop_margin",
            "label": "Desktop Section margin",
            "visible_if": "{{ section.settings.section_styling == true }}",
            "options": [
                {
                    "value": "lg:mb-0",
                    "label": "None"
                },
                {
                    "value": "lg:mb-8",
                    "label": "Small - 32px"
                },
                {
                    "value": "lg:mb-12",
                    "label": "Medium - 48px"
                },
                {
                    "value": "lg:mb-16",
                    "label": "Large - 64px"
                }
            ],
            "default": "lg:mb-0"
        },
        {
            "type": "header",
            "content": "Colors",
            "visible_if": "{{ section.settings.section_styling == true }}"
        },
        {
            "type": "color",
            "id": "background",
            "label": "Section background color",
            "default": "#FFFFFF",
            "visible_if": "{{ section.settings.section_styling == true }}"
        },
        {
            "type": "color",
            "id": "primary_text_color",
            "label": "Primary text color",
            "default": "#000000",
            "visible_if": "{{ section.settings.section_styling == true }}"
        },
        {
            "type": "color",
            "id": "secondary_text_color",
            "label": "Secondary text color",
            "default": "#000000",
            "visible_if": "{{ section.settings.section_styling == true }}"
        },
        {
            "type": "color",
            "id": "primary_button_color",
            "label": "Primary button background color",
            "default": "#FFFFFF",
            "visible_if": "{{ section.settings.section_styling == true }}"
        },
        {
            "type": "color",
            "id": "primary_button_text_color",
            "label": "Primary button text color",
            "default": "#000000",
            "visible_if": "{{ section.settings.section_styling == true }}"
        },
        {
            "type": "color",
            "id": "secondary_button_color",
            "label": "Secondary button background color",
            "default": "#000000",
            "visible_if": "{{ section.settings.section_styling == true }}"
        },
        {
            "type": "color",
            "id": "secondary_button_text_color",
            "label": "Secondary button text color",
            "default": "#FFFFFF",
            "visible_if": "{{ section.settings.section_styling == true }}"
        },
        {
            "type": "checkbox",
            "id": "mobile_spacing",
            "label": "Add mobile spacing for the whole section",
            "default": true
        },
        {
            "type": "checkbox",
            "id": "desktop_spacing",
            "label": "Add desktop spacing for the whole section",
            "default": true
        },
        {
            "type": "header",
            "content": "Pagination Settings"
        },
        {
            "type": "range",
            "id": "desktop_pagination_limit",
            "min": 3,
            "max": 24,
            "step": 3,
            "default": 12,
            "label": "Articles per page"
        }
    ],
    "blocks": [],
    "enabled_on": {
        "templates": [
            "blog"
        ]
    },
    "presets": [
        {
            "name": "Blog"
        }
    ]
}
{% endschema %}
