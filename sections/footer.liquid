{% liquid
    assign s = section.settings
    assign section_id = 'section-' | append: section.id
    assign footer_menu = linklists[s.footer_menu].links
%}

<footer
    id="{{ section_id }}"
    class="{{ s.mobile_padding }} {{ s.desktop_padding }} bg-background"
>
    {% render 'section-colors', current_section: section %}
    <div class="container grid lg:grid-cols-2 mb-4">
        <ul class="flex flex-col lg:flex-row gap-10">
            {% for link in footer_menu %}
                <li>
                    {% assign class = 'mb-4 block font-bold text-primary' %}
                    {% if link.url != '#' %}
                        <a
                            href="{{ link.url }}"
                            class="{{ class }} hover:text-primary/50"
                        >
                            {{- link.title -}}
                        </a>
                    {% else %}
                        <span class="{{ class }}">{{ link.title }}</span>
                    {% endif %}

                    {% if link.links %}
                        <ul class="space-y-1 text-primary">
                            {% for link in link.links %}
                                <li>
                                    <a
                                        href="{{ link.url }}"
                                        class="hover:text-primary/50"
                                    >
                                        {{- link.title -}}
                                    </a>
                                </li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                </li>
            {% endfor %}
        </ul>
        {% render 'component.newsletter-form' %}
    </div>
    <div class="container flex justify-between mb-4">
        {% render 'component.payment-methods' %}
        {% render 'component.social-media' %}
    </div>
    <div class="container">
        <p class="text-center text-sm text-primary">
            {%- if s.copyright != blank -%}
                {{- s.copyright -}}
            {%- else -%}
                &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}
            {%- endif -%}
        </p>
    </div>
</footer>

{% schema %}
{
    "name": "Footer",
    "tag": "footer",
    "class": "footer",
    "settings": [
        {
            "type": "text",
            "id": "copyright",
            "label": "Copyright",
            "default": "© 2025 Owls Nest. All rights reserved."
        },
        {
            "type": "link_list",
            "id": "footer_menu",
            "label": "Footer menu"
        },
        {
            "type": "header",
            "content": "Section Styling"
        },
        {
            "type": "checkbox",
            "id": "section_styling",
            "label": "Add styling to section",
            "info": "If enabled this shows the settings to set the color scheme, spacing, and margin for the section.",
            "default": false
        },
        {
            "type": "header",
            "content": "Section Color Scheme",
            "visible_if": "{{ section.settings.section_styling == true }}"
        },
        {
            "type": "header",
            "content": "Section Spacing",
            "visible_if": "{{ section.settings.section_styling == true }}"
        },
        {
            "type": "select",
            "id": "mobile_padding",
            "label": "Mobile padding",
            "visible_if": "{{ section.settings.section_styling == true }}",
            "options": [
                {
                    "value": "py-0",
                    "label": "None"
                },
                {
                    "value": "py-2",
                    "label": "Small - 8px"
                },
                {
                    "value": "py-4",
                    "label": "Medium - 16px"
                },
                {
                    "value": "py-6",
                    "label": "Large - 24px"
                }
            ],
            "default": "py-0"
        },
        {
            "type": "select",
            "id": "desktop_padding",
            "label": "Desktop padding",
            "visible_if": "{{ section.settings.section_styling == true }}",
            "options": [
                {
                    "value": "lg:py-0",
                    "label": "None"
                },
                {
                    "value": "lg:py-4",
                    "label": "Small - 16px"
                },
                {
                    "value": "lg:py-6",
                    "label": "Medium - 24px"
                },
                {
                    "value": "lg:py-8",
                    "label": "Large - 32px"
                }
            ],
            "default": "lg:py-4"
        },
        {
            "type": "header",
            "content": "Section Margin",
            "visible_if": "{{ section.settings.section_styling == true }}"
        },
        {
            "type": "select",
            "id": "mobile_margin",
            "label": "Mobile Section margin",
            "visible_if": "{{ section.settings.section_styling == true }}",
            "options": [
                {
                    "value": "mb-0",
                    "label": "None"
                },
                {
                    "value": "mb-4",
                    "label": "Small - 16px"
                },
                {
                    "value": "mb-8",
                    "label": "Medium - 32px"
                },
                {
                    "value": "mb-12",
                    "label": "Large - 48px"
                }
            ],
            "default": "mb-0"
        },
        {
            "type": "select",
            "id": "desktop_margin",
            "label": "Desktop Section margin",
            "visible_if": "{{ section.settings.section_styling == true }}",
            "options": [
                {
                    "value": "lg:mb-0",
                    "label": "None"
                },
                {
                    "value": "lg:mb-8",
                    "label": "Small - 32px"
                },
                {
                    "value": "lg:mb-12",
                    "label": "Medium - 48px"
                },
                {
                    "value": "lg:mb-16",
                    "label": "Large - 64px"
                }
            ],
            "default": "lg:mb-0"
        },
        {
            "type": "header",
            "content": "Colors",
            "visible_if": "{{ section.settings.section_styling == true }}"
        },
        {
            "type": "color",
            "id": "background",
            "label": "Section background color",
            "default": "#FFFFFF",
            "visible_if": "{{ section.settings.section_styling == true }}"
        },
        {
            "type": "color",
            "id": "primary_text_color",
            "label": "Primary text color",
            "default": "#000000",
            "visible_if": "{{ section.settings.section_styling == true }}"
        },
        {
            "type": "color",
            "id": "secondary_text_color",
            "label": "Secondary text color",
            "default": "#000000",
            "visible_if": "{{ section.settings.section_styling == true }}"
        },
        {
            "type": "color",
            "id": "primary_button_color",
            "label": "Primary button background color",
            "default": "#FFFFFF",
            "visible_if": "{{ section.settings.section_styling == true }}"
        },
        {
            "type": "color",
            "id": "primary_button_text_color",
            "label": "Primary button text color",
            "default": "#000000",
            "visible_if": "{{ section.settings.section_styling == true }}"
        },
        {
            "type": "color",
            "id": "secondary_button_color",
            "label": "Secondary button background color",
            "default": "#000000",
            "visible_if": "{{ section.settings.section_styling == true }}"
        },
        {
            "type": "color",
            "id": "secondary_button_text_color",
            "label": "Secondary button text color",
            "default": "#FFFFFF",
            "visible_if": "{{ section.settings.section_styling == true }}"
        }
    ],
    "enabled_on": {
        "groups": [
            "footer"
        ]
    },
    "presets": [
        {
            "name": "Footer",
            "settings": {}
        }
    ]
}
{% endschema %}
