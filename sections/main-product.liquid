{% liquid
    assign current_variant = product.selected_or_first_available_variant
    assign badge_list = product.metafields.product.badges.value
%}

{%- render 'product-head', product: product -%}

<div id="section-{{ section.id }}">
    <div class="container">
        <product-form
            data-url="{{ product.url }}"
            data-section="{{ section.id }}"
        >
            <div class="md:grid md:grid-cols-2 lg:grid-cols-[57fr_43fr] md:gap-x-8 lg:gap-x-12">
                <div class="relative w-full min-w-0 lg:max-h-[80dvh] overflow-hidden">
                    {%- render 'component.product-media' -%}
                    {% if badge_list.size > 0 %}
                        <div class="absolute top-0 right-0">
                            {% for badge in badge_list %}
                                {% render 'component.badge',
                                    badge: badge.title.value
                                %}
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>

                <div class="flex flex-col gap-6 min-w-0">
                    {% for block in section.blocks %}
                        {% case block.type %}
                            {% when 'product_title' %}
                                <div>
                                    {% render 'component.heading',
                                        content: product.title,
                                        variant: 'lg',
                                        tag: 'h1'
                                    %}
                                </div>

                            {% when 'product_price' %}
                                <div>
                                    {%- render 'pdp-product-price',
                                        current_variant: current_variant
                                    -%}
                                </div>

                            {% when 'product_description' %}
                                {% if product.description != blank %}
                                    <div>
                                        {{ product.description }}
                                    </div>
                                {% endif %}

                            {% when 'product_sku' %}
                                {% if current_variant.sku != blank %}
                                    <div>
                                        <span>
                                            {{-
                                                'products.product.product_sku'
                                                | t
                                            -}}
                                            :</span
                                        >
                                        <span>{{ current_variant.sku }}</span>
                                    </div>
                                {% endif %}

                            {% when 'product_variants' %}
                                {% unless product.has_only_default_variant %}
                                    <div>
                                        {%- render 'pdp-variants' -%}
                                    </div>
                                {% endunless %}

                            {% when 'product_form' %}
                                <div>
                                    {% if current_variant.available %}
                                        {%- render 'add-to-cart-box' -%}
                                    {% else %}
                                        {%- render 'component.pdp.back-in-stock',
                                            variant: current_variant
                                        -%}
                                    {% endif %}
                                </div>

                            {% when 'product_more_collection' %}
                                {%- assign more_products_from_collection = product.metafields.custom.more_products_from_collection.value -%}
                                {% if more_products_from_collection != blank %}
                                    <div>
                                        <span>
                                            {{-
                                                'products.product.more_from_collection'
                                                | t
                                            -}}
                                        </span>
                                        {% render 'component.button',
                                            href: more_products_from_collection.url,
                                            label: more_products_from_collection.title,
                                            title: more_products_from_collection.title,
                                            variant: 'success'
                                        %}
                                    </div>
                                {% endif %}

                            {% when 'product_additional_info' %}
                                {%- assign pdp_additional_info_block_list = localization.market.metafields.custom.pdp_additional_info_block.value -%}
                                <div>
                                    {% if pdp_additional_info_block_list.size
                                            > 0
                                    %}
                                        <ul>
                                            {% for item in pdp_additional_info_block_list %}
                                                <li>
                                                    {% render 'component.icon',
                                                        type: 'checkbox_checked_circle'
                                                    %}
                                                    <span>{{ item }}</span>
                                                </li>
                                            {% endfor %}
                                        </ul>
                                    {% endif %}
                                    {% render 'component.payment-methods' %}
                                </div>
                        {% endcase %}
                    {% endfor %}
                </div>
            </div>
        </product-form>
    </div>
</div>

{% schema %}
{
    "name": "Main Product",
    "settings": [],
    "blocks": [
        {
            "type": "product_title",
            "name": "Product title",
            "limit": 1,
            "settings": []
        },
        {
            "type": "product_price",
            "name": "Product price",
            "limit": 1,
            "settings": []
        },
        {
            "type": "product_description",
            "name": "Product description",
            "limit": 1,
            "settings": []
        },
        {
            "type": "product_sku",
            "name": "Product SKU",
            "limit": 1,
            "settings": []
        },
        {
            "type": "product_variants",
            "name": "Product variants",
            "limit": 1,
            "settings": []
        },
        {
            "type": "product_form",
            "name": "Add to cart",
            "limit": 1,
            "settings": []
        },
        {
            "type": "product_more_collection",
            "name": "More from collection",
            "limit": 1,
            "settings": []
        },
        {
            "type": "product_additional_info",
            "name": "Additional info",
            "limit": 1,
            "settings": []
        }
    ],
    "enabled_on": {
        "templates": ["product"]
    },
    "presets": [
        {
            "name": "Main Product",
            "blocks": [
                { "type": "product_title" },
                { "type": "product_variants" },
                { "type": "product_form" },
                { "type": "product_more_collection" },
                { "type": "product_additional_info" }
            ]
        }
    ]
}
{% endschema %}
