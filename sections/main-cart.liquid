<cart-form
    class="group/cart-form block max-w-5xl p-6 lg:p-8"
    data-section-id="{{ section.id }}"
>
    <h1 class="mb-4 text-xl">{{- 'cart.main-cart.title' | t -}}</h1>
    <cart-items class="relative block">
        {%- for item in cart.items %}
            <cart-item
                data-key="{{ item.key }}"
                data-index="{{ forloop.index }}"
                data-target="cart-items.item"
                class="group/cart-item relative block transition-colors duration-300 ease-out data-[loading]:bg-primary-background/5 data-[loading]:pointer-events-none"
            >
                <div class="pointer-events-none absolute inset-0 z-30 hidden items-center justify-center group-data-[loading]/cart-item:flex">
                    <span
                        class="inline-block size-6 border-2 border-current border-t-transparent rounded-full animate-spin text-primary"
                    ></span>
                </div>
                <article class="grid grid-cols-[max(20%,5.5rem)_minmax(0,1fr)] gap-4 border-t px-4 py-4">
                    <a href="{{ item.variant.url }}">
                        <responsive-media class="aspect-square w-full border bg-background before:bg-transparent">
                            {{
                                item.image
                                | image_url: width: 400
                                | image_tag: class: 'object-contain'
                            -}}
                        </responsive-media>
                    </a>
                    <div
                        class="flex"
                        data-target="cart-item.details"
                    >
                        <div class="flex flex-col gap-2 pb-1">
                            <a href="{{ item.variant.url }}">
                                {{- item.title -}}
                            </a>
                            {%- render 'cart-item-form' with item as item -%}
                        </div>
                        <p class="ml-auto w-fit">
                            {{ item.final_line_price | money }}
                        </p>
                    </div>
                </article>
            </cart-item>
        {% endfor -%}
        {%- if cart.empty? %}
            <div
                class="space-y-4"
                data-target="cart-items.empty"
            >
                <p>{{- 'cart.main-cart.empty' | t -}}</p>
                <a
                    href="{{ collections.all.url }}"
                    class="inline-flex items-center bg-button-green px-3 py-2 text-white transition-colors hover:bg-button-green-hover"
                >
                    {% render 'component.icon', type: 'fallback_icon' %}
                    {{- 'cart.main-cart.continue_shopping' | t -}}
                </a>
            </div>
        {%- else -%}
            <template data-target="cart-items.empty"></template>
        {%- endif -%}
    </cart-items>
    {% if section.settings.show_add_discount_code %}
        {% render 'component.cart-discount', section_id: section.id %}
    {% endif %}
    <footer
        class="flex flex-col gap-4 border-t p-4 empty:border-none"
        data-target="cart-form.footer"
    >
        {%- if cart.item_count > 0 %}
            <p class="flex w-full">
                <span>{{- 'cart.main-cart.subtotal' | t -}}</span>
                <span class="ml-auto">{{ cart.total_price | money }}</span>
            </p>
            <form
                action="{{ routes.cart_url }}"
                method="post"
                class="ml-auto w-fit group-data-loading/cart-form:pointer-events-none"
            >
                <button
                    type="submit"
                    name="checkout"
                    class="inline-flex items-center bg-button-green px-3 py-2 text-white transition-colors hover:bg-button-green-hover"
                >
                    {% render 'component.icon', type: 'fallback_icon' %}
                    {{- 'cart.main-cart.checkout' | t -}}
                </button>
            </form>
        {% endif -%}
    </footer>
</cart-form>

{% schema %}
{
    "name": "Main Cart",
    "settings": [
        {
            "type": "checkbox",
            "id": "show_add_discount_code",
            "label": "Show add discount code",
            "default": true
        }
    ],
    "blocks": []
}
{% endschema %}
