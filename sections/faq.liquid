{% liquid
    assign s = section.settings
    assign section_id = 'section-' | append: section.id
    assign selected_metaobject = s.metaobject
    assign faq_categories = metaobjects.faq_category[selected_metaobject].items.value
    assign subtitle = metaobjects.faq_category[selected_metaobject].subtitle
%}

{% render 'component.animation-open', section: section %}

<div
    id="{{ section_id }}"
    class="{{ s.mobile_margin }} {{ s.desktop_margin }} bg-background container"
>
    <div
        class="{{ s.mobile_padding }} {{ s.desktop_padding }} md:grid md:grid-cols-4 md:gap-14"
    >
        <ul class="md:col-span-1 mb-8">
            {%- for link in linklists[s.faq_menu].links -%}
                <li class="py-4 border-b border-border-grey last:border-none text-lg lg:first:pt-0">
                    <a
                        href="{{ link.url }}"
                        class="{% if link.url == request.path %} text-fire-engine-red {% else %} text-grey {% endif %} hover:text-grey/70"
                    >
                        {{- link.title -}}
                    </a>
                </li>
            {%- endfor -%}
        </ul>
        <div class="mt-8 md:mt-0 md:col-span-3">
            {% if s.title != blank %}
                <h2 class="mb-6 text-3xl lg:text-4xl">
                    {{- s.title | strip_html -}}
                </h2>
            {% endif %}
            {% if s.subtitle != blank %}
                <div class="mb-5 text-grey-dark text-base">
                    {{- s.subtitle -}}
                </div>
            {% endif %}
            <ul class="mb-8">
                {% for category in faq_categories %}
                    {%- if category.description != blank -%}
                        <li
                            id="{{ category.title | handleize }}"
                            class="border-b border-border-grey last:border-none"
                        >
                            {% assign content = category.description
                                | metafield_text
                            %}
                            {% render 'component.accordion',
                                title: category.title,
                                title_class: 'text-xl',
                                content: content,
                                content_class: 'text-grey-dark text-base',
                                styled_content: true
                            %}
                        </li>
                    {%- endif -%}
                {% endfor %}
            </ul>
            {% render 'schema.faq', items: faq_categories %}
            {% if subtitle != blank %}
                {% assign subtitle_content = subtitle | metafield_tag %}
                <div class="text-grey-dark text-base mt-5 md:mt-8">
                    {% render 'richtext', content: subtitle_content %}
                </div>
            {% endif %}
        </div>
    </div>
</div>

{% render 'component.animation-close', section: section %}

{% schema %}
{
    "name": "FAQ",
    "tag": "section",
    "class": "section-faq",
    "disabled_on": {
        "groups": ["header", "footer"]
    },
    "settings": [
        {
            "type": "header",
            "content": "Section Styling"
        },
        {
            "type": "checkbox",
            "id": "section_styling",
            "label": "Add styling to section",
            "info": "If enabled this shows the settings to set the color scheme, spacing, and margin for the section.",
            "default": false
        },
        {
            "type": "header",
            "content": "Section Spacing",
            "visible_if": "{{ section.settings.section_styling == true }}"
        },
        {
            "type": "select",
            "id": "mobile_padding",
            "label": "Mobile padding",
            "visible_if": "{{ section.settings.section_styling == true }}",
            "options": [
                {
                    "value": "py-0",
                    "label": "None"
                },
                {
                    "value": "py-4",
                    "label": "Small - 16px"
                },
                {
                    "value": "py-8",
                    "label": "Medium - 32px"
                },
                {
                    "value": "py-12",
                    "label": "Large - 48px"
                }
            ],
            "default": "py-0"
        },
        {
            "type": "select",
            "id": "desktop_padding",
            "label": "Desktop padding",
            "visible_if": "{{ section.settings.section_styling == true }}",
            "options": [
                {
                    "value": "lg:py-0",
                    "label": "None"
                },
                {
                    "value": "lg:py-4",
                    "label": "Small - 32px"
                },
                {
                    "value": "lg:py-12",
                    "label": "Medium - 48px"
                },
                {
                    "value": "lg:py-16",
                    "label": "Large - 64px"
                }
            ],
            "default": "lg:py-4"
        },
        {
            "type": "header",
            "content": "Section Margin",
            "visible_if": "{{ section.settings.section_styling == true }}"
        },
        {
            "type": "select",
            "id": "mobile_margin",
            "label": "Mobile Section margin",
            "visible_if": "{{ section.settings.section_styling == true }}",
            "options": [
                {
                    "value": "mb-0",
                    "label": "None"
                },
                {
                    "value": "mb-4",
                    "label": "Small - 16px"
                },
                {
                    "value": "mb-8",
                    "label": "Medium - 32px"
                },
                {
                    "value": "mb-12",
                    "label": "Large - 48px"
                }
            ],
            "default": "mb-0"
        },
        {
            "type": "select",
            "id": "desktop_margin",
            "label": "Desktop Section margin",
            "visible_if": "{{ section.settings.section_styling == true }}",
            "options": [
                {
                    "value": "lg:mb-0",
                    "label": "None"
                },
                {
                    "value": "lg:mb-8",
                    "label": "Small - 32px"
                },
                {
                    "value": "lg:mb-12",
                    "label": "Medium - 48px"
                },
                {
                    "value": "lg:mb-16",
                    "label": "Large - 64px"
                }
            ],
            "default": "lg:mb-0"
        },
        {
            "type": "header",
            "content": "FAQ Header"
        },
        {
            "type": "richtext",
            "id": "title",
            "label": "FAQ Title"
        },
        {
            "type": "text",
            "id": "subtitle",
            "label": "FAQ Subtitle"
        },
        {
            "type": "link_list",
            "id": "faq_menu",
            "label": "FAQ Menu (Faq navigation menu on the left)"
        },
        {
            "type": "metaobject",
            "id": "metaobject",
            "label": "Metaobject",
            "metaobject_type": "faq_category"
        },
        {
            "type": "header",
            "content": "Animation"
        },
        {
            "type": "select",
            "id": "animation_type",
            "label": "Animation",
            "options": [
                {
                    "value": "none",
                    "label": "None"
                },
                {
                    "value": "fade-in",
                    "label": "Fade in"
                },
                {
                    "value": "fade-up",
                    "label": "Fade up"
                },
                {
                    "value": "fade-down",
                    "label": "Fade down"
                },
                {
                    "value": "fade-left",
                    "label": "Fade in from left"
                },
                {
                    "value": "fade-right",
                    "label": "Fade in from right"
                },
                {
                    "value": "zoom-in",
                    "label": "Zoom in"
                },
                {
                    "value": "zoom-out",
                    "label": "Zoom out"
                },
                {
                    "value": "stagger",
                    "label": "Stagger"
                }
            ],
            "default": "fade-up"
        },
        {
            "type": "range",
            "id": "animation_duration",
            "label": "Duration",
            "min": 0.2,
            "max": 2,
            "step": 0.1,
            "unit": "s",
            "default": 0.8
        }
    
    ],
    "blocks": [],
    "presets": [
        {
            "name": "FAQ",
            "settings": {}
        }
    ]
}
{% endschema %}
