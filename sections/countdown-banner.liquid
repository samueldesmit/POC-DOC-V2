{% render 'component.animation-open', section: section %}

{% comment %}
    Requirements:
    - Add a `countdown_visibility` metaobject with a boolean `visible` field and expose it in this section’s settings.
    - Create a Flow that schedules a `metaobjectUpsert` call (see snippet below) to flip `visible` to `true/false` at the desired time.
        {
            "handle": {
                "type": "countdown_visibility",
                "handle": "countdown-visibility"
            },
            "metaobject": {
                "fields": [
                    {
                        "key": "visible",
                        "value": "false"
                    }
                ]
            }
        }
{% endcomment %}
{% liquid
    assign s = section.settings
    assign section_id = 'section-' | append: section.id
    assign end_datetime = s.end_datetime | strip
    assign is_design_mode = request.design_mode
    assign show_placeholder = false

    if is_design_mode and end_datetime == blank
        assign show_placeholder = true
    endif

    assign has_countdown = false
    if end_datetime != blank
        assign has_countdown = true
    endif

    assign countdown_visibility = true
    if s.countdown_visibility != blank
        assign visibility_metaobject = metaobjects.countdown_visibility[s.countdown_visibility]
        assign countdown_visibility = visibility_metaobject.visible.value
    endif

    assign should_show = false
    if countdown_visibility
        if has_countdown or show_placeholder
            assign should_show = true
        endif
    endif
%}

{% if should_show %}
    <div
        id="{{ section_id }}"
        class="{{ s.mobile_margin }} {{ s.desktop_margin }} bg-background"
        data-countdown-container
    >
        {% render 'section-colors', current_section: section %}
        <div class="{{ s.mobile_padding }} {{ s.desktop_padding }}">
            <section
                class="container text-center text-primary"
                aria-live="polite"
            >
                {% if s.title != blank %}
                    {% render 'component.heading',
                        tag: 'h2',
                        variant: 'sm',
                        content: s.title,
                        class: 'mb-4 text-primary'
                    %}
                {% endif %}

                {% if show_placeholder %}
                    <div class="mx-auto max-w-lg border border-dashed border-primary/30 bg-background/60 p-6 text-secondary">
                        {{ 'sections.countdown_banner.placeholder_text' | t }}
                    </div>
                {% else %}
                    <countdown-banner
                        class="inline-grid grid-cols-4 items-stretch gap-2 sm:gap-3"
                        role="group"
                        aria-label="{{ 'sections.countdown_banner.countdown_label' | t }}"
                        data-end="{{ end_datetime | escape }}"
                    >
                        <div class="min-w-[60px] border border-primary/20 px-3 py-2">
                            <span
                                class="block tabular-nums text-lg font-semibold leading-tight sm:text-xl"
                                data-countdown-unit="days"
                            >
                                0
                            </span>
                            <span
                                class="block text-xs sm:text-2xs uppercase tracking-[.1em] text-secondary"
                                data-countdown-label="days"
                                data-label-singular="{{ 'sections.countdown_banner.day' | t }}"
                                data-label-plural="{{ 'sections.countdown_banner.days' | t }}"
                            >
                                {{- 'sections.countdown_banner.days' | t -}}
                            </span>
                        </div>
                        <div class="min-w-[60px] border border-primary/20 px-3 py-2">
                            <span
                                class="block tabular-nums text-lg font-semibold leading-tight sm:text-xl"
                                data-countdown-unit="hours"
                            >
                                00
                            </span>
                            <span
                                class="block text-xs sm:text-2xs uppercase tracking-[.1em] text-secondary"
                                data-countdown-label="hours"
                                data-label-singular="{{ 'sections.countdown_banner.hour' | t }}"
                                data-label-plural="{{ 'sections.countdown_banner.hours' | t }}"
                            >
                                {{- 'sections.countdown_banner.hours' | t -}}
                            </span>
                        </div>
                        <div class="min-w-[60px] border border-primary/20 px-3 py-2">
                            <span
                                class="block tabular-nums text-lg font-semibold leading-tight sm:text-xl"
                                data-countdown-unit="minutes"
                            >
                                00
                            </span>
                            <span
                                class="block text-xs sm:text-2xs uppercase tracking-[.1em] text-secondary"
                                data-countdown-label="minutes"
                                data-label-singular="{{ 'sections.countdown_banner.minute' | t }}"
                                data-label-plural="{{ 'sections.countdown_banner.minutes' | t }}"
                            >
                                {{- 'sections.countdown_banner.minutes' | t -}}
                            </span>
                        </div>
                        <div class="min-w-[60px] border border-primary/20 px-3 py-2">
                            <span
                                class="block tabular-nums text-lg font-semibold leading-tight sm:text-xl"
                                data-countdown-unit="seconds"
                            >
                                00
                            </span>
                            <span
                                class="block text-xs sm:text-2xs uppercase tracking-[.1em] text-secondary"
                                data-countdown-label="seconds"
                                data-label-singular="{{ 'sections.countdown_banner.second' | t }}"
                                data-label-plural="{{ 'sections.countdown_banner.seconds' | t }}"
                            >
                                {{- 'sections.countdown_banner.seconds' | t -}}
                            </span>
                        </div>
                    </countdown-banner>
                {% endif %}
            </section>
        </div>
    </div>
{% endif %}

{% render 'component.animation-close', section: section %}

{% schema %}
{
    "name": "Countdown banner",
