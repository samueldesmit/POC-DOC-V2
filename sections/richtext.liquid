{% liquid
    assign s = section.settings
    assign section_id = 'section-' | append: section.id
%}

{% render 'component.animation-open', section: section %}

<div
    id="{{ section_id }}"
    class="{{ s.mobile_margin }} {{ s.desktop_margin }} bg-background"
>
    {% render 'section-colors', current_section: section %}
    <div
        class="{{ s.mobile_padding }} {{ s.desktop_padding }} {% if s.container %}container{% else %}container-small{% endif %} [&_a]:underline {{ s.content_alignment }}"
    >
        {%- for block in section.blocks -%}
            {% assign b = block.settings %}
            {%- case block.type -%}
                {%- when 'heading' -%}
                    {% if b.heading != blank %}
                        {%- render 'component.heading',
                            tag: 'h2',
                            variant: b.heading_size,
                            attributes: block.shopify_attributes,
                            content: b.heading,
                            class: ' mb-6 last:mb-0 text-primary'
                        -%}
                    {% endif %}

                {%- when 'subheading' -%}
                    {% if b.subheading != blank %}
                        {%- render 'component.heading',
                            tag: 'h3',
                            variant: b.subheading_size,
                            attributes: block.shopify_attributes,
                            content: b.subheading,
                            class: ' mb-4 last:mb-0 text-secondary'
                        -%}
                    {% endif %}

                {%- when 'text' -%}
                    {% if b.text != blank %}
                        <div
                            {{ block.shopify_attributes }}
                            class="mb-12 space-y-5 last:mb-0 [&_ol]:list-decimal [&_ol]:pl-5 [&_ul]:list-disc [&_ul]:pl-5 [&_h1]:heading-lg [&_h2]:heading-md [&_h3]:heading-md [&_h4]:heading-sm [&_h5]:heading-sm [&_h6]:heading-sm text-secondary"
                        >
                            {{ b.text }}
                        </div>
                    {% endif %}
            {%- endcase -%}
        {%- endfor -%}
    </div>
</div>
{% if template == 'article' %}
    {% render 'schema.article' %}
{% endif %}

{% render 'component.animation-close', section: section %}

{% schema %}
{
    "name": "Richtext",
    "tag": "section",
    "class": "section-richtext",
    "disabled_on": {
        "groups": [
            "header",
            "footer"
        ]
    },
    "settings": [
        {
            "type": "header",
            "content": "Section Styling"
        },
        {
            "type": "checkbox",
            "id": "section_styling",
            "label": "Add styling to section",
            "info": "If enabled this shows the settings to set the color scheme, spacing, and margin for the section.",
            "default": false
        },
        {
            "type": "header",
            "content": "Section Color Scheme",
            "visible_if": "{{ section.settings.section_styling == true }}"
        },
        {
            "type": "header",
            "content": "Section Spacing",
            "visible_if": "{{ section.settings.section_styling == true }}"
        },
        {
            "type": "select",
            "id": "mobile_padding",
            "label": "Mobile padding",
            "visible_if": "{{ section.settings.section_styling == true }}",
            "options": [
                {
                    "value": "py-0",
                    "label": "None"
                },
                {
                    "value": "py-2",
                    "label": "Small - 8px"
                },
                {
                    "value": "py-4",
                    "label": "Medium - 16px"
                },
                {
                    "value": "py-6",
                    "label": "Large - 24px"
                }
            ],
            "default": "py-0"
        },
        {
            "type": "select",
            "id": "desktop_padding",
            "label": "Desktop padding",
            "visible_if": "{{ section.settings.section_styling == true }}",
            "options": [
                {
                    "value": "lg:py-0",
                    "label": "None"
                },
                {
                    "value": "lg:py-4",
                    "label": "Small - 16px"
                },
                {
                    "value": "lg:py-6",
                    "label": "Medium - 24px"
                },
                {
                    "value": "lg:py-8",
                    "label": "Large - 32px"
                }
            ],
            "default": "lg:py-4"
        },
        {
            "type": "header",
            "content": "Section Margin",
            "visible_if": "{{ section.settings.section_styling == true }}"
        },
        {
            "type": "select",
            "id": "mobile_margin",
            "label": "Mobile Section margin",
            "visible_if": "{{ section.settings.section_styling == true }}",
            "options": [
                {
                    "value": "mb-0",
                    "label": "None"
                },
                {
                    "value": "mb-4",
                    "label": "Small - 16px"
                },
                {
                    "value": "mb-8",
                    "label": "Medium - 32px"
                },
                {
                    "value": "mb-12",
                    "label": "Large - 48px"
                }
            ],
            "default": "mb-0"
        },
        {
            "type": "select",
            "id": "desktop_margin",
            "label": "Desktop Section margin",
            "visible_if": "{{ section.settings.section_styling == true }}",
            "options": [
                {
                    "value": "lg:mb-0",
                    "label": "None"
                },
                {
                    "value": "lg:mb-8",
                    "label": "Small - 32px"
                },
                {
                    "value": "lg:mb-12",
                    "label": "Medium - 48px"
                },
                {
                    "value": "lg:mb-16",
                    "label": "Large - 64px"
                }
            ],
            "default": "lg:mb-0"
        },
        {
            "type": "header",
            "content": "Colors",
            "visible_if": "{{ section.settings.section_styling == true }}"
        },
        {
            "type": "color",
            "id": "background",
            "label": "Section background color",
            "default": "#FFFFFF",
            "visible_if": "{{ section.settings.section_styling == true }}"
        },
        {
            "type": "color",
            "id": "primary_text_color",
            "label": "Primary text color",
            "default": "#000000",
            "visible_if": "{{ section.settings.section_styling == true }}"
        },
        {
            "type": "color",
            "id": "secondary_text_color",
            "label": "Secondary text color",
            "default": "#000000",
            "visible_if": "{{ section.settings.section_styling == true }}"
        },
        {
            "type": "color",
            "id": "primary_button_color",
            "label": "Primary button background color",
            "default": "#FFFFFF",
            "visible_if": "{{ section.settings.section_styling == true }}"
        },
        {
            "type": "color",
            "id": "primary_button_text_color",
            "label": "Primary button text color",
            "default": "#000000",
            "visible_if": "{{ section.settings.section_styling == true }}"
        },
        {
            "type": "color",
            "id": "secondary_button_color",
            "label": "Secondary button background color",
            "default": "#000000",
            "visible_if": "{{ section.settings.section_styling == true }}"
        },
        {
            "type": "color",
            "id": "secondary_button_text_color",
            "label": "Secondary button text color",
            "default": "#FFFFFF",
            "visible_if": "{{ section.settings.section_styling == true }}"
        },
        {
            "type": "checkbox",
            "id": "container",
            "label": "Full width container",
            "default": true,
            "visible_if": "{{ section.settings.section_styling == true }}"
        },
        {
            "type": "select",
            "id": "content_alignment",
            "visible_if": "{{ section.settings.section_styling == true }}",
            "options": [
                {
                    "value": "text-left",
                    "label": "Left"
                },
                {
                    "value": "text-center",
                    "label": "Center"
                },
                {
                    "value": "text-right",
                    "label": "Right"
                }
            ],
            "default": "text-left",
            "label": "Content alignment"
        },
        {
            "type": "header",
            "content": "Animation"
        },
        {
            "type": "select",
            "id": "animation_type",
            "label": "Animation",
            "options": [
                { "value": "none", "label": "None" },
                { "value": "fade-in", "label": "Fade in" },
                { "value": "fade-up", "label": "Fade up" },
                { "value": "fade-down", "label": "Fade down" },
                { "value": "fade-left", "label": "Fade in from left" },
                { "value": "fade-right", "label": "Fade in from right" },
                { "value": "zoom-in", "label": "Zoom in" },
                { "value": "zoom-out", "label": "Zoom out" },
                { "value": "stagger", "label": "Stagger" }
            ],
            "default": "fade-up"
        },
        {
            "type": "range",
            "id": "animation_duration",
            "label": "Duration",
            "min": 0.2,
            "max": 2,
            "step": 0.1,
            "unit": "s",
            "default": 0.8
        }
    ],
    "blocks": [
        {
            "type": "heading",
            "name": "Heading",
            "limit": 1,
            "settings": [
                {
                    "type": "inline_richtext",
                    "id": "heading",
                    "default": "Talk about your brand",
                    "label": "Heading"
                },
                {
                    "type": "select",
                    "id": "heading_size",
                    "options": [
                        {
                            "value": "2xl",
                            "label": "2XL"
                        },
                        {
                            "value": "xl",
                            "label": "XL"
                        },
                        {
                            "value": "lg",
                            "label": "LG"
                        },
                        {
                            "value": "md",
                            "label": "MD"
                        },
                        {
                            "value": "sm",
                            "label": "SM"
                        },
                        {
                            "value": "xs",
                            "label": "XS"
                        },
                        {
                            "value": "2xs",
                            "label": "2XS"
                        },
                        {
                            "value": "3xs",
                            "label": "3XS"
                        }
                    ],
                    "default": "lg",
                    "label": "Heading size"
                }
            ]
        },
        {
            "type": "subheading",
            "name": "Subheading",
            "limit": 1,
            "settings": [
                {
                    "type": "inline_richtext",
                    "id": "subheading",
                    "default": "Talk about your brand",
                    "label": "Subheading"
                },
                {
                    "type": "select",
                    "id": "subheading_size",
                    "options": [
                        {
                            "value": "2xl",
                            "label": "2XL"
                        },
                        {
                            "value": "xl",
                            "label": "XL"
                        },
                        {
                            "value": "lg",
                            "label": "LG"
                        },
                        {
                            "value": "md",
                            "label": "MD"
                        },
                        {
                            "value": "sm",
                            "label": "SM"
                        },
                        {
                            "value": "xs",
                            "label": "XS"
                        },
                        {
                            "value": "2xs",
                            "label": "2XS"
                        },
                        {
                            "value": "3xs",
                            "label": "3XS"
                        }
                    ],
                    "default": "md",
                    "label": "Subheading size"
                }
            ]
        },
        {
            "type": "text",
            "name": "Text",
            "settings": [
                {
                    "type": "richtext",
                    "id": "text",
                    "default": "<p>Share information about your brand with your customers. Describe a product, make announcements, or welcome customers to your store.</p>",
                    "label": "Description"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "Richtext",
            "blocks": [
                {
                    "type": "heading"
                },
                {
                    "type": "subheading"
                },
                {
                    "type": "text"
                }
            ]
        }
    ]
}
{% endschema %}
