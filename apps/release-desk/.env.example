# Copy to a local .env and supply values privately. Never commit populated secrets.
# server/index.mjs reads process.env; use node --env-file=.env server/index.mjs locally.
NODE_ENV=development
PORT=3000
APP_URL=http://127.0.0.1:3000
DATA_DIR=./.data

# The one store and repository this deployment serves.
SHOP_DOMAIN=
GITHUB_REPOSITORY=
# Changes go into STAGING_BRANCH first; releasing merges it into LIVE_BRANCH.
STAGING_BRANCH=staging
LIVE_BRANCH=main

# Shopify app credentials (Dev Dashboard). Only SHOP_DOMAIN is accepted.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Comma-separated numeric Shopify user IDs that may test, merge and release. Blank means read-only for everyone.
SHOPIFY_REVIEWER_IDS=

# GitHub App installed only on GITHUB_REPOSITORY.
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
# PEM with literal \n escapes is accepted. Keep the real key in a secret store.
GITHUB_APP_PRIVATE_KEY=
# Match the secret configured for POST /webhooks/github.
GITHUB_WEBHOOK_SECRET=

# demo: staged simulated reviewer outputs, no Anthropic calls/key required.
# GitHub PRs, CI and merges remain real. live: actual Claude reviews, key required.
CLAUDE_REVIEW_MODE=demo
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Development-only fallback; ignored unless NODE_ENV=development AND flag=true.
ALLOW_DEV_GITHUB_TOKEN=false
GITHUB_TOKEN=

# Optional store previews: a Theme Access password for SHOP_DOMAIN.
SHOPIFY_THEME_TOKEN=
# Production uses the pinned global Shopify CLI. Local JS entry override only.
SHOPIFY_CLI_PATH=
