{
    "compilerOptions": {
        "baseUrl": "./src",
        "module": "ES2022",
        "lib": ["ES2022", "DOM"],
        "moduleResolution": "bundler",
        "paths": {
            "@/*": ["*"]
        },
        "experimentalDecorators": true,
        "useDefineForClassFields": false
    },
    "include": ["src/**/*"]
}
