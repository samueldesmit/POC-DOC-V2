{
  /*
    Direct implementation of https://shopify.dev/docs/themes/architecture/settings/input-settings

    Regex expressions:
      - any → pascalCase: /(.*)/${1:/pascalcase}/g
      - kebab-case → Title Case: /([^-]*)(-?)/${1:/capitalize}${2:+ }/g
      - Sentence case → snake_case: /([^\\s])|(\\s)/${1:/downcase}${2:+_}/g
  */

  /*
    Section blocks
      → https://shopify.dev/docs/themes/architecture/blocks/section-blocks#define-blocks-within-sections
  */
  "Shopify Input Setting: block": {
    "scope": "liquid",
    "prefix": "_block",
    "body": [
      "{",
      "  \"name\": \"${1:Block}\",",
      "  \"type\": \"${1/([^\\s])|(\\s)/${1:/downcase}${2:+_}/g}\",",
      "  \"settings\": [",
      "    $0",
      "  ]",
      "},",
    ],
  },

