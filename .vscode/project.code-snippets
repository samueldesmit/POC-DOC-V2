  "Responsive media: Image": {
    "description": "Mobile and desktop image",
    "scope": "liquid",
    "prefix": "responsive-media:image",
    "body": [
      "{%- if section.settings.${1:image} -%}",
      "  <responsive-media class=\"${2:w-full}\">",
      "    {{- section.settings.$1 | image_url: width: 1024 | image_tag -}}",
      "    {{-",
      "      section.settings.$1_desktop",
      "      | default: section.settings.$1",
      "      | image_url: width: 2560",
      "      | image_tag: loading: 'lazy'",
      "    -}}",
      "  </responsive-media>$0",
      "{%- endif -%}",
    ],
  },
  "Responsive media: Image (fixed)": {
    "description": "Fixed image",
    "scope": "liquid",
    "prefix": "responsive-media:image-fixed",
    "body": [
      "<responsive-media class=\"${3:size-32}\">",
      "  {{- ${1:product.featured_image} | image_url: width: ${2:128} | image_tag: class: 'object-scale-down' -}}",
      "</responsive-media>$0",
    ],
  },
  "Responsive media: Media": {
    "description": "Mobile and desktop media",
    "scope": "liquid",
    "prefix": "responsive-media:media",
    "body": [
      "{%- if section.settings.${1:image} or section.settings.${2:video} -%}",
      "  <responsive-media class=\"${3:w-full}\">",
      "    {{- section.settings.$1 | default: section.settings.$2.preview_image | image_url: width: 1024 | image_tag -}}",
      "    {{-",
      "      section.settings.$1_desktop",
      "      | default: section.settings.$1",
      "      | default: section.settings.$2_desktop.preview_image",
      "      | default: section.settings.$2.preview_image",
      "      | image_url: width: 2560",
      "      | image_tag: loading: 'lazy'",
      "    -}}",
      "    {%- assign video_desktop = section.settings.$2_desktop | default: section.settings.$2 -%}",
      "    {%- render 'responsive-media-video', video: section.settings.$2, video_desktop: video_desktop -%}",
      "  </responsive-media>",
      "{%- endif -%}$0",
    ],
  },
  "Shopify Input settings: Image": {
    "description": "Mobile and desktop image",
    "scope": "liquid",
    "prefix": "__image",
    "body": [
      "{",
      "  \"type\": \"header\",",
      "  \"content\": \"${1:Image}\"",
      "},",
      "{",
      "  \"type\": \"image_picker\",",
      "  \"label\": \"Image mobile (default)\",",
      "  \"id\": \"${1/([^\\s])|(\\s)/${1:/downcase}${2:+_}/g}\"",
      "},",
      "{",
      "  \"type\": \"image_picker\",",
      "  \"label\": \"Image desktop\",",
      "  \"id\": \"${1/([^\\s])|(\\s)/${1:/downcase}${2:+_}/g}_desktop\"",
      "},$0",
    ],
  },
  "Shopify Input settings: Responsive media": {
    "description": "Mobile and desktop media",
    "scope": "liquid",
    "prefix": "__media",
    "body": [
      "{",
      "  \"type\": \"header\",",
      "  \"content\": \"$1media\"",
      "},",
      "{",
      "  \"type\": \"image_picker\",",
      "  \"label\": \"Image mobile (default)\",",
      "  \"id\": \"${1/([^\\s])|(\\s)/${1:/downcase}${2:+_}/g}image\"",
      "},",
      "{",
      "  \"type\": \"image_picker\",",
      "  \"label\": \"Image desktop\",",
      "  \"id\": \"${1/([^\\s])|(\\s)/${1:/downcase}${2:+_}/g}image_desktop\"",
      "},",
      "{",
      "  \"type\": \"video\",",
      "  \"label\": \"Video mobile (default)\",",
      "  \"id\": \"${1/([^\\s])|(\\s)/${1:/downcase}${2:+_}/g}video\"",
      "},",
      "{",
      "  \"type\": \"video\",",
      "  \"label\": \"Video desktop\",",
      "  \"id\": \"${1/([^\\s])|(\\s)/${1:/downcase}${2:+_}/g}video_desktop\"",
      "},$0",
    ],
  },
  "Shopify Input settings: Heading tag": {
    "description": "Heading tag select for SEO",
    "scope": "liquid",
    "prefix": "__heading_tag",
    "body": [
      "{",
      "  \"type\": \"select\",",
      "  \"label\": \"${1:Title} heading tag\",",
      "  \"id\": \"${1/([^\\s])|(\\s)/${1:/downcase}${2:+_}/g}_heading_tag\",",
      "  \"default\": \"${3:h2}\",",
      "  \"options\": [",
      "    { \"label\": \"H1\", \"value\": \"h1\" },",
      "    { \"label\": \"H2\", \"value\": \"h2\" },",
      "    { \"label\": \"H3\", \"value\": \"h3\" },",
      "    { \"label\": \"H4\", \"value\": \"h4\" },",
      "    { \"label\": \"P\", \"value\": \"p\" }",
      "  ]",
      "},$0",
    ],
  },
